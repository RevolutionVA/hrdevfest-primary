---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import CanonicalLink from "../components/CanonicalLink.astro";
import PastYearsNav from "../components/PastYearsNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { sheetFor } from "../data/titleBlock";
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Thank You | Hampton Roads DevFest</title>
    <CanonicalLink />
    <meta name="description" content="Thanks for signing up! We'll keep you updated on Hampton Roads DevFest 2027." />

    <GoogleAnalytics />
  </head>
  <body class="min-h-screen">
    <div class="bp-frame">
    <!-- Logo Bar -->
    <a href="/" class="block w-full py-3 px-4 border-b border-[var(--bp-line)]">
      <div class="flex flex-col md:flex-row items-center justify-center gap-2 md:gap-4 text-center">
        <Image src={logoWhite} alt="Hampton Roads DevFest home" class="h-14 w-auto" width={150} height={113} />
        <p class="text-sm md:text-base font-bold">Friday, April 23, 2027 · Zeiders American Dream Theater, Virginia Beach</p>
      </div>
    </a>

    <!-- Navigation Bar -->
    <nav class="w-full py-4 px-8 lg:px-20 border-b border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-12 lg:gap-20">
          <a href="/#about" class="bp-nav-link text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="bp-nav-link text-base font-bold leading-relaxed">Venue</a>
          <a href="/#testimonials" class="bp-nav-link text-base font-bold leading-relaxed">Testimonials</a>
          <PastYearsNav variant="desktop" />
          <a href="/faq" class="bp-nav-link text-base font-bold leading-relaxed">FAQ</a>
          <a href="/sponsor" class="bp-nav-link text-base font-bold leading-relaxed">Sponsor</a>
        </div>
      </div>
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Thank You Content -->
    <section class="w-full py-20 px-4 md:px-8">
      <div class="max-w-2xl mx-auto text-center">
        <div class="bp-box p-10 md:p-14">
          <h1 class="text-3xl md:text-4xl font-bold mb-4">You're on the list!</h1>
          <p class="text-lg bp-muted mb-8">Thanks for signing up. We'll keep you posted on Hampton Roads DevFest 2027.</p>
          <a href="/" class="px-8 py-3 btn-primary text-base">Back to Home</a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="w-full py-8 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center md:items-end gap-8">
        <div class="flex flex-col items-center md:items-start gap-4">
          <p class="text-base font-normal leading-relaxed text-center md:text-left">
            Hampton Roads DevFest is presented by RevolutionVA, a 501c3 organization.
          </p>
          <div class="flex flex-wrap justify-center md:justify-start gap-x-4 gap-y-2 text-sm">
            <a href="/faq" class="bp-link">FAQ</a>
            <a href="/code-of-conduct" class="bp-link">Code of Conduct</a>
          </div>
          <div class="flex gap-4">
            <a href="https://x.com/hrdevfest" target="_blank" rel="noopener noreferrer" class="bp-nav-link" aria-label="Follow us on X/Twitter">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href="https://www.linkedin.com/events/7388613109579636736/" target="_blank" rel="noopener noreferrer" class="bp-nav-link" aria-label="Follow us on LinkedIn">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://www.facebook.com/profile.php?id=61584002302188" target="_blank" rel="noopener noreferrer" class="bp-nav-link" aria-label="Follow us on Facebook">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          </div>
        </div>
        <TitleBlock sheet={sheetFor("/thank-you")} />
      </div>
    </footer>
    </div>
  </body>
</html>
