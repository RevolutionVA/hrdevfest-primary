---
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";
import headerDots from "../assets/dots/header_dots.svg";
import { speakers } from "../data/speakers";
import lionelSappImage from "../assets/speakers/lionel-sapp.jpeg";
import ryanCastilloImage from "../assets/speakers/ryan-castillo.jpeg";
import katieNovotnyImage from "../assets/speakers/katie-novotny.jpeg";
import timBanksImage from "../assets/speakers/tim-banks.jpeg";
import ianTaylorImage from "../assets/speakers/ian-taylor.jpeg";
import laurenPryorImage from "../assets/speakers/lauren-pryor.jpg";

const speakerImages: Record<string, any> = {
  "lionel-sapp.jpeg": lionelSappImage,
  "ryan-castillo.jpeg": ryanCastilloImage,
  "katie-novotny.jpeg": katieNovotnyImage,
  "tim-banks.jpeg": timBanksImage,
  "ian-taylor.jpeg": ianTaylorImage,
  "lauren-pryor.jpg": laurenPryorImage,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Featured Speakers | Hampton Roads DevFest 2026</title>
    <meta name="description" content="Meet the featured speakers at Hampton Roads DevFest 2026. All speakers are local Hampton Roads developers sharing their expertise." />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Featured Speakers | Hampton Roads DevFest 2026" />
    <meta property="og:description" content="Meet the featured speakers at Hampton Roads DevFest 2026. All speakers are local Hampton Roads developers." />
    <meta property="og:url" content="https://hrdevfest.com/speakers" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@hrdevfest" />
    <meta name="twitter:title" content="Featured Speakers | Hampton Roads DevFest 2026" />
    <meta name="twitter:description" content="Meet the featured speakers at Hampton Roads DevFest 2026. All speakers are local Hampton Roads developers." />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Inter', sans-serif;
      }
      .card-asymmetric {
        border-top-left-radius: 40px;
        border-top-right-radius: 10px;
        border-bottom-right-radius: 40px;
        border-bottom-left-radius: 10px;
      }
      .card-shadow {
        box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.10);
      }
      .btn-primary {
        background: linear-gradient(0deg, #D33B32 0%, #D33B32 100%);
        border-radius: 100px;
        transition: all 0.3s ease;
      }
      .btn-primary:hover {
        filter: brightness(0.9);
        transform: scale(1.02);
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen bg-[#F3F4F6] text-gray-900">
    <!-- Mobile hamburger button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bg-[#052831] rounded-lg" aria-label="Toggle menu">
      <svg id="hamburger-icon" class="w-6 h-6 text-white transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 text-white hidden transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-white hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          <a href="https://events.humanitix.com/hampton-roads-devfest-2026" class="mobile-menu-link px-6 py-3 btn-primary text-white text-base font-bold leading-relaxed text-center">Buy Tickets - $50</a>
          <a href="/#about" class="mobile-menu-link text-black text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Venue</a>
          <a href="/speakers" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Speakers</a>
          <a href="/schedule" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Schedule</a>
          <a href="/#testimonials" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Testimonials</a>
          <a href="/years/2024" class="mobile-menu-link text-black text-base font-bold leading-relaxed">2024</a>
          <a href="/faq" class="mobile-menu-link text-black text-base font-bold leading-relaxed">FAQ</a>
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full bg-[#052831] py-4 px-8 lg:px-20">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-12 lg:gap-20">
          <a href="https://events.humanitix.com/hampton-roads-devfest-2026" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Buy Tickets</a>
          <a href="/#about" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">About</a>
          <a href="/#venue" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Venue</a>
          <a href="/speakers" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Speakers</a>
          <a href="/schedule" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Schedule</a>
          <a href="/#testimonials" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Testimonials</a>
          <a href="/years/2024" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">2024</a>
          <a href="/faq" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">FAQ</a>
        </div>
      </div>
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Header Section -->
    <section class="w-full bg-white relative overflow-hidden">
      <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

      <div class="relative z-10 flex flex-col items-center py-10 px-8 lg:px-[280px] md:px-8">
        <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center">
          <h1 class="text-black text-[24px] md:text-[32px] font-bold leading-8 md:leading-10">
            Featured Speakers
          </h1>
          <p class="text-black text-base font-normal leading-relaxed">
            Hampton Roads DevFest is special because it uniquely highlights the amazing developer talent we have in our region. All HRDevFest speakers are current or past residents of the Hampton Roads area.
          </p>
        </div>
      </div>
    </section>

    <!-- Speakers Grid Section -->
    <section class="w-full py-10 px-8 bg-[#F3F4F6]">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:grid lg:grid-cols-3 gap-8">
          {speakers.map((speaker) => (
            <div class="bg-white p-6 md:p-8 card-asymmetric card-shadow flex flex-col md:flex-row lg:flex-col gap-4 items-center">
              <Image
                src={speakerImages[speaker.image]}
                alt={speaker.name}
                class="w-[100px] h-[100px] rounded-full object-cover shrink-0"
                width={100}
                height={100}
              />
              <div class="flex flex-col gap-4 w-full">
                <p class="text-[24px] font-semibold text-black text-center md:text-left lg:text-center">
                  {speaker.name}
                </p>
                <p class="text-base font-normal text-black leading-relaxed">
                  {speaker.bio}
                </p>
                <div class="flex items-center gap-4 justify-center md:justify-start lg:justify-center">
                  {speaker.linkedin && (
                    <a href={speaker.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0077B5] hover:opacity-80">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                      <span class="text-sm font-medium">LinkedIn</span>
                    </a>
                  )}
                  {speaker.twitter && (
                    <a href={speaker.twitter} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-black hover:opacity-80">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                      </svg>
                      <span class="text-sm font-medium">Twitter</span>
                    </a>
                  )}
                  {speaker.bluesky && (
                    <a href={speaker.bluesky} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0085FF] hover:opacity-80">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.038.415-.055-.265.2-.532.34-.796.531-2.32 1.673-2.788 2.927-1.706 4.649 1.082 1.723 4.883 1.08 5.67-.542.364-.75.28-1.68.28-2.722 0 1.042-.084 1.972.28 2.722.787 1.622 4.588 2.265 5.67.542 1.082-1.722.614-2.976-1.706-4.649-.264-.191-.531-.331-.796-.531.14.017.279.035.415.055 2.67.296 5.568-.628 6.383-3.364.246-.829.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
                      </svg>
                      <span class="text-sm font-medium">Bluesky</span>
                    </a>
                  )}
                  {speaker.website && (
                    <a href={speaker.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#27B738] hover:opacity-80">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                      </svg>
                      <span class="text-sm font-medium">Website</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Ticket CTA Section -->
    <section class="w-full bg-[#052831] py-12 px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-white text-2xl md:text-3xl font-bold mb-4">Ready to Join These Amazing Speakers?</h2>
        <p class="text-white text-base opacity-90 mb-6">Get your ticket now and learn from Hampton Roads' best developers.</p>
        <a
          href="https://events.humanitix.com/hampton-roads-devfest-2026"
          class="inline-block px-8 py-4 btn-primary text-white text-base font-bold leading-relaxed"
        >
          Buy Tickets - $50
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="w-full bg-[#052831] py-8 px-8 lg:px-20 mt-auto border-t border-[#4DB7B9]/30">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex flex-col items-center md:items-start gap-2">
          <p class="text-white text-base font-normal leading-relaxed text-center md:text-left">
            Hampton Roads DevFest is presented by RevolutionVA, a 501c3 organization.
          </p>
          <div class="flex items-center gap-4">
            <a href="https://x.com/hrdevfest" target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#4DB7B9] transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href="https://www.linkedin.com/events/7388613109579636736/" target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#4DB7B9] transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="flex flex-wrap justify-center md:justify-end gap-4 text-sm">
          <a href="/" class="text-white hover:text-[#4DB7B9] transition-colors">Home</a>
          <a href="/schedule" class="text-white hover:text-[#4DB7B9] transition-colors">Schedule</a>
          <a href="/faq" class="text-white hover:text-[#4DB7B9] transition-colors">FAQ</a>
        </div>
      </div>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');
        const menuLinks = document.querySelectorAll('.mobile-menu-link');
        let isOpen = false;

        function toggleMenu() {
          isOpen = !isOpen;
          if (isOpen) {
            mobileMenu?.classList.remove('hidden');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu?.classList.add('hidden');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        menuBtn?.addEventListener('click', toggleMenu);

        menuLinks.forEach(link => {
          link.addEventListener('click', () => {
            if (isOpen) toggleMenu();
          });
        });
      });
    </script>
  </body>
</html>
