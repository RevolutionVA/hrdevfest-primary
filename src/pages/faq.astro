---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import CanonicalLink from "../components/CanonicalLink.astro";
import PastYearsNav from "../components/PastYearsNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { sheetFor } from "../data/titleBlock";
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";
import FooterBridge from "../components/FooterBridge.astro";

interface FAQItem {
  question: string;
  answer: string;
}

interface FAQCategory {
  title: string;
  items: FAQItem[];
}

const faqData: FAQCategory[] = [
  {
    title: "General",
    items: [
      {
        question: "What is Hampton Roads DevFest?",
        answer: "Hampton Roads DevFest is a curated, community-driven software development conference produced by RevolutionVA. It brings together developers, technical leaders, and decision-makers from across the Hampton Roads region for a full day of high-quality technical and professional content."
      },
      {
        question: "Who should attend?",
        answer: "This event is designed for a broad technical audience—from junior developers through senior engineers, directors, and C-level leaders. Sessions are selected to be accessible, practical, and relevant across experience levels."
      }
    ]
  },
  {
    title: "Tickets",
    items: [
      {
        question: "What does my ticket include?",
        answer: "Your ticket includes full-day conference admission and lunch."
      },
      {
        question: "Are tickets refundable or transferable?",
        answer: "Tickets are not refundable, but they are transferable. If you can no longer attend, you may transfer your ticket to another person."
      },
      {
        question: "Can my employer pay by invoice?",
        answer: "Yes. Employer invoice payments are available for purchases of 10 or more tickets, upon request. Please contact the conference team for details."
      },
      {
        question: "Are scholarships available?",
        answer: "Yes. We give away scholarship and Send a friend seats by lottery, and anyone can enter. Seats funded for veterans are drawn from veteran entries, and seats funded for students are drawn from student entries. Entries are open until the week before the event. We draw winners the week of the event. Seats funded by our Scholarship sponsors are held for the lottery, even if we sell out. Extra seats, like Send a friend, depend on space, so buy a ticket if you can. Entry form in early 2027."
      },
      {
        question: "Will I receive a receipt for reimbursement?",
        answer: "Yes. Receipts are automatically provided via Humanitix, our ticketing and payment processor."
      }
    ]
  },
  {
    title: "Day of Event",
    items: [
      {
        question: "When does registration open?",
        answer: "We'll share registration times closer to the event."
      },
      {
        question: "Is re-entry allowed?",
        answer: "Yes. Re-entry is allowed with your conference badge."
      },
      {
        question: "Can I bring a laptop or backpack?",
        answer: "Yes. You are welcome to bring a laptop or backpack. Please note that power outlets are limited, so plan accordingly."
      },
      {
        question: "Is Wi-Fi available?",
        answer: "We'll share Wi-Fi details closer to the event."
      },
      {
        question: "Is the venue accessible?",
        answer: "Yes. The venue is fully accessible. If you have accessibility needs, please indicate them during registration so we can accommodate you."
      },
      {
        question: "Is lunch provided, and can dietary restrictions be accommodated?",
        answer: "Lunch is included with your ticket. We do accommodate dietary restrictions—please note your needs during registration."
      }
    ]
  },
  {
    title: "Sessions & Speakers",
    items: [
      {
        question: "When will the schedule be published?",
        answer: "The full schedule will be published in early 2027."
      },
      {
        question: "How long are sessions?",
        answer: "Session lengths will be shared with the schedule in early 2027."
      },
      {
        question: "What types of topics will be covered?",
        answer: "Sessions are selected to appeal across roles and seniority levels, with content relevant to individual contributors, technical leads, engineering managers, directors, and executives."
      },
      {
        question: "Will sessions be recorded?",
        answer: "No. Sessions will not be recorded."
      },
      {
        question: "How are speakers selected?",
        answer: "Speakers are curated by RevolutionVA. All speakers are either local to Hampton Roads or alumni of the regional tech community. There is no Call for Proposals (CFP)."
      },
      {
        question: "Are there opportunities for local user groups?",
        answer: "Yes. We offer an exhibition program for local user groups. If your group is interested in participating, please contact the team for more information."
      }
    ]
  },
  {
    title: "Travel",
    items: [
      {
        question: "What airport should I fly into?",
        answer: "The closest airport is Norfolk International Airport (ORF)."
      },
      {
        question: "How far is the venue from the airport?",
        answer: "Norfolk International Airport is approximately 10–12 miles from the venue, which is typically a 15–20 minute drive, depending on traffic."
      },
      {
        question: "Where do I park?",
        answer: "There are several parking garages and surface lots in the Town Center area near the venue. View our <a href='/parking' class='bp-link'>Town Center Parking Guide</a> for details."
      }
    ]
  },
  {
    title: "Contact",
    items: [
      {
        question: "Who should I contact with questions?",
        answer: "Please contact team@revolutionva.org with any questions."
      }
    ]
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>FAQ | Hampton Roads DevFest 2027</title>
    <meta name="description" content="Frequently asked questions about Hampton Roads DevFest 2027. Find answers about tickets, venue, sessions, and more." />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="FAQ | Hampton Roads DevFest 2027" />
    <meta property="og:description" content="Frequently asked questions about Hampton Roads DevFest 2027. Find answers about tickets, venue, sessions, and more." />
    <meta property="og:url" content="https://hrdevfest.org/faq" />
    <CanonicalLink href="https://hrdevfest.org/faq" />
    <meta property="og:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hrdevfest" />
    <meta name="twitter:title" content="FAQ | Hampton Roads DevFest 2027" />
    <meta name="twitter:description" content="Frequently asked questions about Hampton Roads DevFest 2027. Find answers about tickets, venue, sessions, and more." />
    <meta name="twitter:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <style>
      .faq-item[data-expanded="true"] .chevron-right {
        display: none;
      }
      .faq-item[data-expanded="true"] .chevron-down {
        display: block;
      }
      .faq-item[data-expanded="true"] .chevron-right {
        display: block;
      }
      .faq-item[data-expanded="true"] .chevron-down {
        display: none;
      }
      .faq-item[data-expanded="true"] .faq-answer {
        display: none;
      }
      .faq-item[data-expanded="true"] .faq-answer {
        display: block;
      }
    </style>

    <GoogleAnalytics />
  </head>
  <body class="min-h-screen">
    <!-- Mobile hamburger button - outside the frame so it stays fixed -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bp-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bp-frame">
    <!-- Logo Bar -->
    <a href="/" class="block w-full py-3 pl-4 pr-16 md:px-4 border-b border-[var(--bp-line)]">
      <div class="flex flex-col md:flex-row items-center justify-center gap-2 md:gap-4 text-center">
        <Image src={logoWhite} alt="Hampton Roads DevFest home" class="h-24 md:h-28 w-auto" width={300} height={225} />
        <p class="text-sm md:text-base font-bold">Friday, April 23, 2027 · Zeiders American Dream Theater, Virginia Beach</p>
      </div>
    </a>

    <!-- Mailing List Signup -->
    <section class="w-full py-12 px-4 md:px-8">
      <div class="max-w-xl mx-auto p-8 bp-box text-center">
        <h2 class="text-2xl font-bold mb-2">Be first to know</h2>
        <p class="bp-muted mb-6">Sign up for updates on Hampton Roads DevFest 2027</p>
        <form action="https://track.bentonow.com/forms/57d9b8196b2b704a30da5ac245bf2cfe/$subscribeHRDevFest?hardened=true" method="POST" enctype="multipart/form-data" class="max-w-md mx-auto">
          <input type="hidden" name="redirect" value="https://hrdevfest.org/thank-you">
          <input type="text" name="fields_first_name" aria-label="First name" placeholder="First Name (optional)" class="bp-input mb-3 px-4 py-3 text-base" />
          <input type="email" name="email" placeholder="Email" required class="bp-input mb-4 px-4 py-3 text-base" />
          <button type="submit" class="px-8 py-3 btn-primary text-base">Join the list</button>
          <p class="text-xs bp-muted mt-4">By signing up, you agree to our <a href="https://revolutionva.org/privacy" target="_blank" rel="noopener" class="bp-link">Privacy Policy</a>.</p>
        </form>
      </div>
    </section>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-[var(--bp-paper)] hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          <a href="/#about" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Venue</a>
          <a href="/#testimonials" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Testimonials</a>
          <PastYearsNav variant="mobile" />
          <a href="/faq" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">FAQ</a>
          <a href="/sponsor" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Sponsor</a>
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full py-4 px-8 lg:px-20 border-y border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-12 lg:gap-20">
          <a href="/#about" class="bp-nav-link text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="bp-nav-link text-base font-bold leading-relaxed">Venue</a>
          <a href="/#testimonials" class="bp-nav-link text-base font-bold leading-relaxed">Testimonials</a>
          <PastYearsNav variant="desktop" />
          <a href="/faq" class="bp-nav-link text-base font-bold leading-relaxed">FAQ</a>
          <a href="/sponsor" class="bp-nav-link text-base font-bold leading-relaxed">Sponsor</a>
        </div>
      </div>
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Header Section -->
    <section class="w-full">
      <div class="flex flex-col items-center py-8 px-8 lg:py-10">
        <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center">
          <h1 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">
            FAQ
          </h1>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="w-full pb-8 px-4 md:px-8 md:pb-10 lg:pb-20">
      <div class="max-w-4xl mx-auto flex flex-col gap-10">
        {faqData.map((category) => (
          <div class="flex flex-col gap-4">
            <h2 class="text-xl font-bold pb-2 border-b border-[var(--bp-line)]">{category.title}</h2>
            <div class="flex flex-col gap-4">
              {category.items.map((item) => (
                <div
                  class="faq-item bp-box p-6 md:p-8 cursor-pointer"
                  data-expanded="true"
                >
                  <div class="flex items-start gap-4">
                    <div class="flex-1">
                      <div class="flex items-center gap-4">
                        <!-- Chevron Right (collapsed) -->
                        <svg class="chevron-right w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="square" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
                        </svg>
                        <!-- Chevron Down (expanded) -->
                        <svg class="chevron-down w-5 h-5 shrink-0 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="square" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
                        </svg>
                        <p class="text-base font-bold">{item.question}</p>
                      </div>
                      <div class="faq-answer mt-4 pl-9 bp-prose">
                        <p class="text-base font-normal leading-relaxed" set:html={item.answer} />
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="relative isolate overflow-hidden w-full py-8 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <FooterBridge />
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center md:items-end gap-8">
        <div class="flex flex-col items-center md:items-start gap-4">
          <!-- Branding -->
          <p class="text-base font-normal leading-relaxed text-center md:text-left">
            Hampton Roads DevFest is presented by RevolutionVA, a 501c3 organization.
          </p>

          <!-- Quick Links -->
          <div class="flex flex-wrap justify-center md:justify-start gap-x-4 gap-y-2 text-sm">
            <a href="/faq" class="bp-link">FAQ</a>
            <a href="/code-of-conduct" class="bp-link">Code of Conduct</a>
          </div>

          <!-- Social Links -->
          <div class="flex gap-4">
            <a href="https://x.com/hrdevfest" target="_blank" rel="noopener noreferrer" class="bp-nav-link" aria-label="Follow us on X/Twitter">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href="https://www.linkedin.com/company/revolutionva/" target="_blank" rel="noopener noreferrer" class="bp-nav-link" aria-label="Follow us on LinkedIn">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://www.facebook.com/profile.php?id=61584002302188" target="_blank" rel="noopener noreferrer" class="bp-nav-link" aria-label="Follow us on Facebook">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          </div>
        </div>
        <TitleBlock sheet={sheetFor("/faq")} />
      </div>
    </footer>

    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Mobile menu toggle
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');
        const menuLinks = document.querySelectorAll('.mobile-menu-link');
        let isOpen = false;

        function toggleMenu() {
          isOpen = !isOpen;
          if (isOpen) {
            mobileMenu?.classList.remove('hidden');
            menuBtn?.setAttribute('aria-expanded', 'true');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu?.classList.add('hidden');
            menuBtn?.setAttribute('aria-expanded', 'false');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        menuBtn?.addEventListener('click', toggleMenu);

        menuLinks.forEach(link => {
          link.addEventListener('click', () => {
            if (isOpen) toggleMenu();
          });
        });

        // Close menu on Escape and return focus to the button
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && isOpen) {
            toggleMenu();
            menuBtn?.focus();
          }
        });

        // FAQ accordion toggle
        const faqItems = document.querySelectorAll('.faq-item');
        faqItems.forEach(item => {
          item.addEventListener('click', () => {
            const isExpanded = item.getAttribute('data-expanded') === 'true';
            item.setAttribute('data-expanded', isExpanded ? 'false' : 'true');
          });
        });
      });
    </script>
  </body>
</html>
