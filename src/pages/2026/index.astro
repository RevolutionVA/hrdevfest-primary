---
import { getEntry } from 'astro:content';
import { Image } from "astro:assets";
import YearLayout from "../../themes/2026/layouts/YearLayout.astro";
import headerDots from "../../assets/dots/header_dots.svg";
import sponsorBkgd from "../../assets/sponsor_bkgd.png";

import lionelSappImage from "../../assets/speakers/lionel-sapp.jpeg";
import ryanCastilloImage from "../../assets/speakers/ryan-castillo.jpeg";
import katieNovotnyImage from "../../assets/speakers/katie-novotny.jpeg";
import timBanksImage from "../../assets/speakers/tim-banks.jpeg";
import ianTaylorImage from "../../assets/speakers/ian-taylor.jpeg";
import laurenPryorImage from "../../assets/speakers/lauren-pryor.jpg";

import issuetrakLogo from "../../assets/sponsors/issuetrak.png";
import marathonLogo from "../../assets/sponsors/marathon.png";
import opensearchLogo from "../../assets/sponsors/opensearch.png";
import swiftkickLogo from "../../assets/sponsors/swiftkick.png";
import landrecordsLogo from "../../assets/sponsors/landrecords.png";
import progressLogo from "../../assets/sponsors/progress.png";
import stigianLogo from "../../assets/sponsors/stigian.png";
import noteableLogo from "../../assets/sponsors/noteable.png";
import cvbLogo from "../../assets/sponsors/cvb.png";
import techeadLogo from "../../assets/sponsors/TECHEAD.png";
import decisionsProcessmakerLogo from "../../assets/sponsors/decisions+processmaker.png";
import yellowdogLogo from "../../assets/sponsors/yellowdog.png";

const event = await getEntry('events', '2026/event');
if (!event) {
  throw new Error('Event data not found for 2026');
}
const eventData = event.data;

const speakerImages: Record<string, ImageMetadata> = {
  "lionel-sapp.jpeg": lionelSappImage,
  "ryan-castillo.jpeg": ryanCastilloImage,
  "katie-novotny.jpeg": katieNovotnyImage,
  "tim-banks.jpeg": timBanksImage,
  "ian-taylor.jpeg": ianTaylorImage,
  "lauren-pryor.jpg": laurenPryorImage,
};

const sponsorLogos: Record<string, ImageMetadata> = {
  "issuetrak.png": issuetrakLogo,
  "marathon.png": marathonLogo,
  "opensearch.png": opensearchLogo,
  "swiftkick.png": swiftkickLogo,
  "landrecords.png": landrecordsLogo,
  "progress.png": progressLogo,
  "stigian.png": stigianLogo,
  "noteable.png": noteableLogo,
  "cvb.png": cvbLogo,
  "TECHEAD.png": techeadLogo,
  "decisions+processmaker.png": decisionsProcessmakerLogo,
  "yellowdog.png": yellowdogLogo,
};

const sponsorsByTier = {
  platinum: eventData.sponsors.filter(s => s.tier === 'platinum'),
  gold: eventData.sponsors.filter(s => s.tier === 'gold'),
  silver: eventData.sponsors.filter(s => s.tier === 'silver'),
  logo: eventData.sponsors.filter(s => s.tier === 'logo'),
};

const standardSponsors = [...sponsorsByTier.silver, ...sponsorsByTier.logo];
---

<YearLayout 
  title={eventData.title + " | Event Highlights"} 
  description={eventData.description}
  ogImage={eventData.ogImage}
>
  <!-- Header Section with Event Highlights -->
  <section class="w-full bg-white relative overflow-hidden">
    <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

    <div class="relative z-10 flex flex-col items-center py-10 px-8 lg:px-[280px] md:px-8">
      <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center mb-10">
        <h1 class="text-black text-[24px] md:text-[32px] font-bold leading-8 md:leading-10">
          {eventData.tagline}
        </h1>
        <p class="text-black text-base font-normal leading-relaxed">
          {eventData.description}
        </p>
      </div>
    </div>
  </section>

  <!-- 2026 Schedule Section -->
  <section class="w-full py-10 px-8 bg-white relative overflow-hidden">
    <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

    <div class="max-w-4xl mx-auto flex flex-col gap-6 relative z-10">
      <h2 class="text-[24px] md:text-[32px] font-bold text-black text-center">
        2026 Schedule
      </h2>
      <p class="text-black text-base font-normal leading-relaxed text-center">
        All sessions took place at {eventData.venue?.name} on {eventData.dateFormatted}.
      </p>
      <div class="flex flex-col gap-4">
        {eventData.schedule.map((item) => (
          <div class="bg-[#F3F4F6] p-6 card-asymmetric flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              {item.time}
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">{item.title}</p>
              {item.description && (
                <p class="text-sm text-gray-600">{item.description}</p>
              )}
              {item.abstract && (
                <p class="text-sm text-gray-700 mt-2 whitespace-pre-line">{item.abstract}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2026 Speakers Section -->
  <section class="w-full py-10 px-8 bg-[#F3F4F6]">
    <div class="max-w-7xl mx-auto flex flex-col gap-10">
      <div class="flex flex-col gap-2 text-center lg:px-[280px]">
        <h2 class="text-black text-[24px] md:text-[32px] font-semibold md:font-bold leading-8 md:leading-10">
          2026 Speakers
        </h2>
        <p class="text-black text-base font-normal leading-relaxed">
          Meet the amazing speakers who shared their knowledge at Hampton Roads DevFest 2026.
        </p>
      </div>

      <div class="flex flex-col lg:grid lg:grid-cols-3 gap-8">
        {eventData.speakers.map((speaker) => (
          <div class="bg-white p-6 md:p-8 card-asymmetric card-shadow flex flex-col md:flex-row lg:flex-col gap-4 items-center">
            {speakerImages[speaker.image] && (
              <Image
                src={speakerImages[speaker.image]}
                alt={speaker.name}
                class="w-[100px] h-[100px] rounded-full object-cover shrink-0"
                width={100}
                height={100}
              />
            )}
            <div class="flex flex-col gap-4 w-full">
              <p class="text-[24px] font-semibold text-black text-center md:text-left lg:text-center">{speaker.name}</p>
              {speaker.sessionTitle && (
                <p class="text-sm text-gray-600 text-center md:text-left lg:text-center italic">{speaker.sessionTitle}</p>
              )}
              <p class="text-base font-normal text-black leading-relaxed">
                {speaker.bio}
              </p>
              <div class="flex items-center gap-4 justify-center md:justify-start lg:justify-center flex-wrap">
                {speaker.linkedin && (
                  <a href={speaker.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0077B5] hover:opacity-80">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    <span class="text-sm font-medium">LinkedIn</span>
                  </a>
                )}
                {speaker.twitter && (
                  <a href={speaker.twitter} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-black hover:opacity-80">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                    <span class="text-sm font-medium">X</span>
                  </a>
                )}
                {speaker.bluesky && (
                  <a href={speaker.bluesky} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0085FF] hover:opacity-80">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.038.415-.055-.265.2-.532.34-.796.531-2.32 1.673-2.788 2.927-1.706 4.649 1.082 1.723 4.883 1.08 5.67-.542.364-.75.28-1.68.28-2.722 0 1.042-.084 1.972.28 2.722.787 1.622 4.588 2.265 5.67.542 1.082-1.722.614-2.976-1.706-4.649-.264-.191-.531-.331-.796-.531.14.017.279.035.415.055 2.67.296 5.568-.628 6.383-3.364.246-.829.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
                    </svg>
                    <span class="text-sm font-medium">Bluesky</span>
                  </a>
                )}
                {speaker.website && (
                  <a href={speaker.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#4DB7B9] hover:opacity-80">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/>
                    </svg>
                    <span class="text-sm font-medium">Website</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2026 Sponsors Section -->
  <section id="sponsors" class="w-full py-10 md:py-20 px-8 lg:px-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-br from-[#123F4E] to-[#052831]"></div>
      <Image src={sponsorBkgd} alt="" class="absolute inset-0 w-full h-full object-cover" width={1920} height={800} />
    </div>

    <div class="max-w-7xl mx-auto flex flex-col gap-6 relative z-10">
      <div class="py-6 rounded-[10px] flex flex-col items-center gap-2">
        <div class="flex items-center gap-4">
          <svg class="w-10 h-10" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 35.5L17.55 33.27C9.4 25.86 4 21.03 4 15.05C4 10.22 7.82 6.4 12.65 6.4C15.34 6.4 17.92 7.66 20 9.74C22.08 7.66 24.66 6.4 27.35 6.4C32.18 6.4 36 10.22 36 15.05C36 21.03 30.6 25.86 22.45 33.27L20 35.5Z" fill="#D33B32"/>
          </svg>
          <h2 class="text-center text-white text-[32px] font-bold leading-10">2026 Sponsors</h2>
        </div>
        <p class="text-center text-white text-base font-normal leading-relaxed">
          Thank you to the sponsors who supported the Hampton Roads tech community and made the 2026 event possible.
        </p>
      </div>

      <div class="pt-10 flex flex-col items-center gap-6 md:gap-10">
        {sponsorsByTier.platinum.length > 0 && (
          <div class="w-full flex flex-wrap justify-center gap-6 md:gap-10 max-w-3xl mx-auto">
            {sponsorsByTier.platinum.map((sponsor) => (
              <a
                href={sponsor.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full md:w-[calc(50%-1.25rem)] p-12 md:p-14 bg-white card-asymmetric flex justify-center items-center hover:shadow-lg transition-shadow"
                title={sponsor.name}
              >
                {sponsorLogos[sponsor.logo] && (
                  <Image
                    src={sponsorLogos[sponsor.logo]}
                    alt={sponsor.name}
                    class="h-24 w-auto object-contain"
                  />
                )}
              </a>
            ))}
          </div>
        )}

        {sponsorsByTier.gold.length > 0 && (
          <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-3xl mx-auto">
            {sponsorsByTier.gold.map((sponsor) => (
              <a
                href={sponsor.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-10 md:p-12 bg-white card-asymmetric flex justify-center items-center hover:shadow-lg transition-shadow"
                title={sponsor.name}
              >
                {sponsorLogos[sponsor.logo] && (
                  <Image
                    src={sponsorLogos[sponsor.logo]}
                    alt={sponsor.name}
                    class="h-20 w-auto object-contain"
                  />
                )}
              </a>
            ))}
          </div>
        )}

        <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
          {standardSponsors.map((sponsor) => (
            <a
              href={sponsor.url}
              target="_blank"
              rel="noopener noreferrer"
              class="p-6 md:p-8 bg-white card-asymmetric flex justify-center items-center hover:shadow-lg transition-shadow"
              title={sponsor.name}
            >
              {sponsorLogos[sponsor.logo] && (
                <Image
                  src={sponsorLogos[sponsor.logo]}
                  alt={sponsor.name}
                  class="h-12 w-auto object-contain"
                />
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</YearLayout>
