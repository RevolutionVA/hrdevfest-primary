          </div>

          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-12">
            {[...sponsorsByTier.platinum, ...sponsorsByTier.gold, ...sponsorsByTier.silver, ...sponsorsByTier.logo].map((sponsor) => (
              <a
                href={sponsor.url}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white rounded-lg p-6 flex items-center justify-center h-24 transition-transform hover:scale-105"
                title={sponsor.name}
              >
                <Image
                  src={sponsorLogos[sponsor.logo]}
                  alt={sponsor.name}
                  class="max-h-16 max-w-full w-auto h-auto object-contain"
                />
              </a>
            ))}

            <!-- Your Company Here -->
            <a
              href="/prospectus"
              target="_blank"
              class="bg-white/10 border-2 border-dashed border-white/50 rounded-lg p-6 flex flex-col items-center justify-center h-24 text-white hover:bg-white/20 transition-colors"
            >
              <span class="font-semibold">Your Company Here</span>
            </a>
          </div>

          <div class="text-center">
            <a
              href="/prospectus"
              target="_blank"
              class="inline-block px-6 py-3 bg-brand-red hover:bg-brand-red-dark text-white font-semibold rounded-lg transition-colors"
            >
              Become a Sponsor
            </a>
          </div>

          <!-- Sponsorship CTA -->
          <div class="mt-12 bg-white/10 rounded-lg p-8 text-center">
            <h3 class="text-2xl font-bold text-white mb-4">
              Interested in Sponsoring Hampton Roads DevFest 2026?
            </h3>
            <p class="text-white/80 mb-6">
              Help us make tech education accessible to our community while showcasing your organization to 250+ local developers.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="/prospectus"
                target="_blank"
                class="px-6 py-3 bg-brand-red hover:bg-brand-red-dark text-white font-semibold rounded-lg transition-colors"
              >
                View Sponsorship Prospectus
              </a>
              <a
                href="https://buy.stripe.com/3cIaEX12u0e1bjLf1U4AU01"
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-3 bg-white/20 hover:bg-white/30 text-white font-semibold rounded-lg transition-colors"
              >
                Quick Logo Sponsorship ($500)
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section id="faq" class="py-16 bg-gray-50">
        <div class="max-w-3xl mx-auto px-4">
          <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center">FAQ</h2>

