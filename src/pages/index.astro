---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import headerImage from "../assets/header-image.png";
import cfsponsors from "../assets/sponsorship.png";
import { speakers } from "../data/speakers";
import lionelSappImage from "../assets/speakers/lionel-sapp.jpeg";

const speakerImages: Record<string, any> = {
  "lionel-sapp.jpeg": lionelSappImage,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hampton Roads DevFest | Feb 27th, 2026 | Virginia Beach, VA</title>
    <link href="/dist/index.css" rel="stylesheet" />
    <style>
      .gradient-text {
        background: linear-gradient(135deg, #3B82F6 0%, #1E40AF 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .section-divider {
        height: 2px;
        background: linear-gradient(to right, transparent, #E5E7EB 20%, #E5E7EB 80%, transparent);
        margin: 3rem 0;
      }
      .card-shadow {
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        transition: all 0.3s ease;
      }
      .card-shadow:hover {
        box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        transform: translateY(-2px);
      }
      .btn-primary {
        background: linear-gradient(135deg, #3B82F6 0%, #1E40AF 100%);
        transition: all 0.3s ease;
      }
      .btn-primary:hover {
        background: linear-gradient(135deg, #2563EB 0%, #1E3A8A 100%);
        transform: scale(1.05);
      }
      .nav-link {
        position: relative;
        padding-bottom: 2px;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background-color: #60A5FA;
        transition: width 0.3s ease;
      }
      .nav-link.active::after {
        width: 100%;
      }
      /* Scroll offset for fixed header */
      section[id]:before {
        content: "";
        display: block;
        height: 80px;
        margin-top: -80px;
        visibility: hidden;
      }
    </style>
  </head>
  <body
    class="flex flex-col items-center justify-center min-h-screen bg-gray-100 text-gray-900 pt-16"
  >
    <script>
      // Handle active section highlighting
      function updateActiveSection() {
        const sections = document.querySelectorAll('section[id], div[id="about"], div[id="tickets"], div[id="venue"], div[id="speakers"], div[id="sponsors"]');
        const navLinks = document.querySelectorAll('.nav-link');
        const scrollPosition = window.scrollY + 100;

        sections.forEach((section) => {
          const sectionTop = section.offsetTop;
          const sectionHeight = section.offsetHeight;
          const sectionId = section.getAttribute('id');

          if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
            navLinks.forEach((link) => {
              link.classList.remove('active');
              if (link.getAttribute('href') === `#${sectionId}`) {
                link.classList.add('active');
              }
            });
          }
        });
      }

      window.addEventListener('scroll', updateActiveSection);
      window.addEventListener('load', updateActiveSection);
    </script>

    <div
      id="topLinkBar"
      class="fixed top-0 w-full bg-gradient-to-r from-gray-800 to-gray-900 text-white z-50 shadow-lg"
    >
      <nav class="flex justify-around p-4">
        <a class="nav-link hover:text-blue-400 transition-colors duration-200 font-medium" href="#about">About</a>
        <a class="nav-link hover:text-blue-400 transition-colors duration-200 font-medium" href="#tickets">Tickets</a>
        <a class="nav-link hover:text-blue-400 transition-colors duration-200 font-medium" href="#venue">Venue</a>
        <a class="nav-link hover:text-blue-400 transition-colors duration-200 font-medium" href="#speakers">Speakers</a>
        <a class="nav-link hover:text-blue-400 transition-colors duration-200 font-medium" href="#sponsors">Sponsors</a>
      </nav>
    </div>
    <div class="w-full max-w-2xl p-4">
      <div class="relative">
        <Image src={headerImage} alt="Hampton Roads DevFest" class="mx-auto rounded-lg shadow-xl" />
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900/20 to-transparent rounded-lg"></div>
      </div>
      <h1 class="mt-8 text-4xl md:text-5xl font-bold text-center gradient-text">
        Hampton Roads DevFest 2026
      </h1>
      <p class="mt-4 text-xl md:text-2xl text-center text-blue-600 font-bold">
        SAVE THE DATE: Feb 27th, 2026 - Virginia Beach, VA
      </p>

      <section class="mt-8 bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg p-6 card-shadow border-2 border-green-200">
        <h3 class="text-2xl md:text-3xl font-bold text-center mb-3 text-gray-800">
          Apply for a 2026 Scholarship!
        </h3>
        <p class="text-center text-gray-700 mb-4 text-base md:text-lg">
          Hampton Roads DevFest is committed to making our conference accessible to everyone.
          We're offering scholarships to students, career changers, and underrepresented groups
          in tech to help remove financial barriers to attending.
        </p>
        <div class="text-center">
          <a
            href="https://forms.gle/2SyzmmEMrsEirZAFA"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-3 btn-primary text-white font-semibold rounded-lg shadow-md"
          >
            Apply for Scholarship
          </a>
        </div>
      </section>

      <section class="mt-12" id="about">
        <div class="flex flex-col md:flex-row justify-between">
          <div class="flex-1">
            <h2 class="text-3xl font-bold text-gray-800 mb-2">About</h2>
          </div>
        </div>
        <div class="mt-6 rounded-lg bg-white p-6 card-shadow text-sm leading-relaxed">
          <p class="mb-3">
            Mark your calendar for Hampton Roads DevFest 2026! This unique gathering
            will once again spotlight local speakers, showcasing our community's deep and
            diverse talent.
          </p>
          <p class="mb-3">
            Hampton Roads DevFest is more than a conference; it's a tribute to
            our dynamic local developer community. It's an ideal platform to
            highlight the exceptional places to work in the Hampton Roads area,
            emphasizing innovative technological strides. This event caters to
            everyone in the tech sphere, from seasoned developers and industry
            veterans to emerging talents and students.
          </p>
          <p class="mb-3">
            Organized by RevolutionVA, a dedicated 501(c)(3) non-profit, our
            mission is to advance software development education throughout
            Virginia. Our passion for promoting learning and growth in
            technology is at the heart of DevFest.
          </p>
          <p class="mb-3">
            Take advantage of this unparalleled opportunity to network, learn
            from top industry professionals, and celebrate the remarkable
            achievements of our tech community. Whether you're looking to
            sharpen your skills, explore new career pathways, or simply immerse
            yourself in a community of like-minded tech enthusiasts, Hampton
            Roads DevFest is your destination.
          </p>
          <p class="mb-3">
            Join us as we recognize and nurture the extraordinary tech talent
            that thrives in Hampton Roads. Let's connect, discover, and grow
            together at Hampton Roads DevFest 2026!
          </p>
        </div>
      </section>

      <div class="section-divider"></div>

      <section class="mt-12" id="tickets">
        <div class="flex flex-col md:flex-row justify-between">
          <div class="flex-1">
            <h2 class="text-3xl font-bold text-gray-800 mb-2">Get Your Tickets</h2>
          </div>
        </div>
        <div class="mt-6 bg-white rounded-lg p-6 card-shadow">
          <script src="https://events.humanitix.com/scripts/widgets/inline.js" type="module"></script>
          <iframe data-checkout="hampton-roads-devfest-2026" data-params="c=website" style="width: 100%; min-height: 450px; border: none;"></iframe>
        </div>
      </section>

      <div class="section-divider"></div>

      <section class="mt-12 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-6 card-shadow">
        <h3 class="text-2xl font-bold text-center mb-4 text-gray-800">Stay Updated!</h3>
        <div class="_form_23"></div><script
          src="https://revolutionconf.activehosted.com/f/embed.php?id=23"
          charset="utf-8"></script>
      </section>

      <section class="mt-12" id="venue">
        <div class="flex flex-col md:flex-row justify-between">
          <div class="flex-1">
            <h2 class="text-3xl font-bold text-gray-800 mb-2">Venue</h2>
          </div>
          <div class="flex-1">
            <p class="mt-2 text-xl">Zeiders American Dream Theater</p>
            <p class="mt-2 text-lg">4509 Commerce Street,</p>
            <p class="mt-2 text-lg">Virginia Beach, VA 23462</p>
          </div>
        </div>
        <div class="mt-6 rounded-lg overflow-hidden card-shadow">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d798.259579003214!2d-76.13574812406885!3d36.84155839379043!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89ba959f7490b19d%3A0x2946d6df48a4c3ba!2sZeiders%20American%20Dream%20Theater!5e0!3m2!1sen!2sus!4v1708011885150!5m2!1sen!2sus"
            width="100%"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </section>

      <div class="section-divider"></div>

      <section class="mt-12" id="speakers">
        <h2 class="text-3xl font-bold text-gray-800 mb-4 text-center">Featured Speakers</h2>
        <div class="bg-white rounded-lg p-6 card-shadow mb-6">
          <p class="text-center text-gray-700 mb-2">
            Hampton Roads DevFest is special because it uniquely highlights the
            amazing developer talent we have in our region.
          </p>
          <p class="text-center text-gray-700">
            All HRDevFest speakers are current or past residents of the Hampton Roads area.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6">
          {speakers.map((speaker) => (
            <div class="bg-white rounded-lg p-6 card-shadow">
              <div class="flex flex-col md:flex-row gap-6">
                <div class="flex-shrink-0 flex justify-center md:justify-start">
                  <Image
                    src={speakerImages[speaker.image]}
                    alt={speaker.name}
                    class="w-48 h-48 rounded-full object-cover"
                    width={192}
                    height={192}
                  />
                </div>
                <div class="flex-1">
                  <h3 class="text-2xl font-bold text-gray-800 mb-3">{speaker.name}</h3>
                  <p class="text-gray-700 leading-relaxed mb-4">{speaker.bio}</p>
                  <div class="flex gap-4">
                    {speaker.linkedin && (
                      <a
                        href={speaker.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition-colors duration-200"
                      >
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                        LinkedIn
                      </a>
                    )}
                    {speaker.twitter && (
                      <a
                        href={speaker.twitter}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-blue-400 hover:text-blue-600 font-medium transition-colors duration-200"
                      >
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                        </svg>
                        Twitter
                      </a>
                    )}
                    {speaker.website && (
                      <a
                        href={speaker.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-800 font-medium transition-colors duration-200"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                        </svg>
                        Website
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-6 text-center text-gray-600 italic">
          More speakers to be announced in the coming weeks!
        </p>
      </section>

      <section class="mt-12" id="sponsors">
        <h2 class="text-3xl font-bold text-gray-800 mb-4 text-center">Sponsors</h2>
        <div class="bg-white rounded-lg p-6 card-shadow text-center">
          <p class="text-xl text-gray-700 mb-4">
            Interested in sponsoring Hampton Roads DevFest 2026?
          </p>
          <p class="text-gray-600 mb-6">
            Help us make tech education accessible to our community while showcasing your organization to local developers.
          </p>
          <a
            href="/prospectus"
            target="_blank"
            class="inline-block px-8 py-3 btn-primary text-white font-semibold rounded-lg shadow-md"
          >
            View Sponsorship Prospectus
          </a>
        </div>
      </section>
      <div class="mb-24">&nbsp;</div>
    </div>
    <footer
      class="fixed inset-x-0 bottom-0 bg-gradient-to-r from-gray-800 to-gray-900 text-white text-center py-4 shadow-lg"
    >
      <p>
        Hampton Roads DevFest is presented by RevolutionVA, a 501c3
        organization.
      </p>
    </footer>
  </body>
</html>
