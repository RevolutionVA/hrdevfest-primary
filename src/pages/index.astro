---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import logoWhite from "../assets/logo-white.png";
import heroBkgd from "../assets/hero_bkgd.png";
import heroTablet from "../assets/hero_tablet.png";
import heroPhone from "../assets/hero_phone.png";
import venuePic from "../assets/venue_pic.png";
import scholarshipPic from "../assets/scholarship_pic.png";
import { speakers } from "../data/speakers";
import { sponsors } from "../data/sponsors";
import { testimonials } from "../data/testimonials";
import { faqItems } from "../data/faq";
import lionelSappImage from "../assets/speakers/lionel-sapp.jpeg";
import ryanCastilloImage from "../assets/speakers/ryan-castillo.jpeg";
import katieNovotnyImage from "../assets/speakers/katie-novotny.jpeg";
import timBanksImage from "../assets/speakers/tim-banks.jpeg";
import ianTaylorImage from "../assets/speakers/ian-taylor.jpeg";
import laurenPryorImage from "../assets/speakers/lauren-pryor.jpg";
import paulChinJrImage from "../assets/testimonials/paul-chin-jr.jpeg";
import issuetrakLogo from "../assets/sponsors/issuetrak.png";
import marathonLogo from "../assets/sponsors/marathon.png";
import opensearchLogo from "../assets/sponsors/opensearch.png";
import swiftkickLogo from "../assets/sponsors/swiftkick.png";
import landrecordsLogo from "../assets/sponsors/landrecords.png";
import progressLogo from "../assets/sponsors/progress.png";
import stigianLogo from "../assets/sponsors/stigian.png";
import noteableLogo from "../assets/sponsors/noteable.png";
import heroDots from "../assets/dots/hero_dots.svg";
import headerDots from "../assets/dots/header_dots.svg";
import aboutBkgd from "../assets/about_bkgd.png";
import sponsorBkgd from "../assets/sponsor_bkgd.png";

const speakerImages: Record<string, any> = {
  "lionel-sapp.jpeg": lionelSappImage,
  "ryan-castillo.jpeg": ryanCastilloImage,
  "katie-novotny.jpeg": katieNovotnyImage,
  "tim-banks.jpeg": timBanksImage,
  "ian-taylor.jpeg": ianTaylorImage,
  "lauren-pryor.jpg": laurenPryorImage,
};

const testimonialImages: Record<string, any> = {
  "paul-chin-jr.jpeg": paulChinJrImage,
};

const sponsorLogos: Record<string, any> = {
  "issuetrak.png": issuetrakLogo,
  "marathon.png": marathonLogo,
  "opensearch.png": opensearchLogo,
  "swiftkick.png": swiftkickLogo,
  "landrecords.png": landrecordsLogo,
  "progress.png": progressLogo,
  "stigian.png": stigianLogo,
  "noteable.png": noteableLogo,
};

// Group sponsors by tier for display
const sponsorsByTier = {
  platinum: sponsors.filter(s => s.tier === 'platinum'),
  gold: sponsors.filter(s => s.tier === 'gold'),
  silver: sponsors.filter(s => s.tier === 'silver'),
  logo: sponsors.filter(s => s.tier === 'logo'),
};

// Get all sponsors in display order
const allSponsors = [...sponsorsByTier.platinum, ...sponsorsByTier.gold, ...sponsorsByTier.silver, ...sponsorsByTier.logo];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hampton Roads DevFest | Feb 27th, 2026 | Virginia Beach, VA</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="/dist/index.css" rel="stylesheet" />
    <style>
      :root {
        --teal-dark: #052831;
        --teal-mid: #123F4E;
        --teal-accent: #4DB7B9;
        --teal-line: #2B5F6D;
        --red-primary: #D33B32;
        --green-check: #35B724;
        --blue-link: #3361C9;
        --cream: #FFFCF3;
        --gray-bg: #F3F4F6;
      }

      body {
        font-family: 'Inter', sans-serif;
      }

      /* Asymmetric card corners */
      .card-asymmetric {
        border-top-left-radius: 40px;
        border-top-right-radius: 10px;
        border-bottom-right-radius: 40px;
        border-bottom-left-radius: 10px;
      }

      .card-shadow {
        box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.10);
      }

      .btn-primary {
        background: linear-gradient(0deg, var(--red-primary) 0%, var(--red-primary) 100%);
        border-radius: 100px;
        transition: all 0.3s ease;
      }
      .btn-primary:hover {
        filter: brightness(0.9);
        transform: scale(1.02);
      }

      .btn-secondary {
        background: white;
        border: 2px solid var(--red-primary);
        border-radius: 100px;
        color: var(--red-primary);
        transition: all 0.3s ease;
      }
      .btn-secondary:hover {
        background: var(--red-primary);
        color: white;
      }

      /* Hero section */
      .hero-section {
        background: linear-gradient(125deg, var(--teal-mid) 0.73%, var(--teal-dark) 99.53%);
      }

      /* Sponsor section */
      .sponsor-section {
        background: linear-gradient(135deg, var(--teal-mid) 0%, var(--teal-dark) 100%);
      }

      /* FAQ Accordion */
      .faq-item .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out;
      }
      .faq-item.active .faq-answer {
        max-height: 500px;
      }
      .faq-icon {
        transition: transform 0.3s ease;
      }
      .faq-item.active .faq-icon {
        transform: rotate(180deg);
      }

      /* Venue section */
      .venue-section {
        background: linear-gradient(134deg, var(--teal-mid) 0%, var(--teal-dark) 100%);
      }

      /* Scholarship section */
      .scholarship-section {
        background: var(--cream);
      }
    </style>
  </head>
  <body class="flex flex-col items-center min-h-screen bg-[#F3F4F6] text-gray-900">

    <!-- Mobile hamburger button - outside hero to avoid overflow:hidden clipping -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60]" aria-label="Toggle menu">
      <!-- Hamburger icon -->
      <svg id="hamburger-icon" class="w-6 h-6 text-white transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- X icon (hidden by default) -->
      <svg id="close-icon" class="w-6 h-6 text-black hidden transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Hero Section with Nav -->
    <section class="hero-section w-full relative overflow-hidden">
      <!-- Hero background image - responsive for phone/tablet/desktop -->
      <div class="absolute inset-0 pointer-events-none">
        <!-- Phone hero (up to 767px) -->
        <Image src={heroPhone} alt="" class="w-full h-full object-cover object-center md:hidden" width={390} height={680} />
        <!-- Tablet hero (768px to 1023px) -->
        <Image src={heroTablet} alt="" class="w-full h-full object-cover object-center hidden md:block lg:hidden" width={768} height={400} />
        <!-- Desktop hero (1024px+) -->
        <Image src={heroBkgd} alt="" class="w-full h-full object-cover object-left-top hidden lg:block" width={1920} height={800} />
      </div>
      <!-- Navigation -->
      <nav class="w-full px-4 md:px-8 lg:pr-[40px] pt-[17px] pb-[17px] relative z-10">
        <div class="max-w-7xl mx-auto flex justify-end">
          <!-- Desktop/Tablet nav links -->
          <div class="hidden md:flex items-center gap-6 lg:gap-10">
            <a href="#tickets" class="text-white text-base font-bold leading-relaxed hover:text-[#4DB7B9] transition-colors">Buy Tickets</a>
            <a href="#about" class="text-white text-base font-bold leading-relaxed hover:text-[#4DB7B9] transition-colors">About</a>
            <a href="#venue" class="text-white text-base font-bold leading-relaxed hover:text-[#4DB7B9] transition-colors">Venue</a>
            <a href="#speakers" class="text-white text-base font-bold leading-relaxed hover:text-[#4DB7B9] transition-colors">Speakers</a>
            <a href="#testimonials" class="text-white text-base font-bold leading-relaxed hover:text-[#4DB7B9] transition-colors">Testimonials</a>
            <a href="/years/2024" class="text-white text-base font-bold leading-relaxed hover:text-[#4DB7B9] transition-colors">2024</a>
            <a href="#faq" class="text-white text-base font-bold leading-relaxed hover:text-[#4DB7B9] transition-colors">FAQ</a>
          </div>
        </div>
      </nav>

      <!-- Mobile Menu Overlay -->
      <div id="mobile-menu" class="fixed inset-0 z-50 bg-white hidden md:hidden">
        <div class="flex flex-col h-full">
          <!-- Spacer for hamburger button area -->
          <div class="h-[60px]"></div>
          <!-- Menu links -->
          <div class="flex flex-col gap-8 px-8 pt-4">
            <a href="#tickets" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Buy Tickets</a>
            <a href="#about" class="mobile-menu-link text-black text-base font-bold leading-relaxed">About</a>
            <a href="#venue" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Venue</a>
            <a href="#speakers" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Speakers</a>
            <a href="#testimonials" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Testimonials</a>
            <a href="/years/2024" class="mobile-menu-link text-black text-base font-bold leading-relaxed">2024</a>
            <a href="#faq" class="mobile-menu-link text-black text-base font-bold leading-relaxed">FAQ</a>
          </div>
        </div>
      </div>

      <!-- Hero Content -->
      <div class="w-full px-4 md:px-8 lg:pr-[40px] pb-8 pt-8 relative z-10">
        <div class="max-w-7xl mx-auto">
          <!-- Mobile: Stacked vertical layout, Tablet/Desktop: Horizontal layout -->
          <div class="flex flex-col md:flex-row justify-center lg:justify-end items-center gap-4 md:gap-2.5">
            <div class="flex-shrink-0">
              <Image src={logoWhite} alt="Hampton Roads DevFest" class="w-[160px] md:w-[230px] h-auto" width={230} height={173} />
            </div>
            <div class="py-4 md:py-6 md:pl-6 md:border-l border-[#4DB7B9] flex flex-col items-center lg:items-end gap-2 md:gap-4">
              <!-- Mobile: 32px stacked, Tablet: 48px centered, Desktop: 56px right-aligned on one line -->
              <h1 class="text-center lg:text-right text-white text-[32px] md:text-[48px] lg:text-[56px] font-bold leading-[1.1] lg:leading-normal">
                <span class="block lg:inline">Hampton Roads </span>
                <span class="block lg:inline">DevFest 2026</span>
              </h1>
              <!-- Mobile: 18px stacked, Tablet: 24px centered, Desktop: 32px right-aligned on one line -->
              <p class="text-center lg:text-right text-white text-[18px] md:text-[24px] lg:text-[32px] font-semibold leading-[1.3] lg:leading-10">
                <span class="block lg:inline">SAVE THE DATE: Feb 27th, 2026 - </span>
                <span class="block lg:inline">Virginia Beach, VA</span>
              </p>
            </div>
          </div>
          <!-- Buttons: Stacked on mobile, side-by-side on tablet/desktop -->
          <div class="flex flex-col md:flex-row justify-center lg:justify-end gap-4 mt-4">
            <a
              href="#tickets"
              class="px-6 md:px-8 py-3 md:py-4 btn-primary text-white text-base font-bold leading-relaxed text-center"
            >
              Buy Tickets
            </a>
            <a
              href="/prospectus"
              target="_blank"
              class="px-6 md:px-8 py-3 md:py-4 btn-secondary text-base font-bold leading-relaxed text-center"
            >
              Become a Sponsor
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Become a Sponsor CTA Section -->
    <section class="w-full bg-[#F3F4F6] py-12 md:py-20 px-4 md:px-8 xl:px-20">
      <div class="max-w-7xl mx-auto flex flex-col xl:flex-row items-start xl:items-center justify-between gap-7">
        <div class="flex-1 flex flex-col gap-2">
          <h2 class="text-black text-[32px] font-semibold leading-10">Become a Sponsor</h2>
          <p class="text-black text-base font-normal leading-relaxed">
            Showcase your organization to local developers and support tech education.
          </p>
        </div>
        <div class="flex-1 flex flex-col justify-center gap-2.5">
          <div class="text-base leading-8">
            <span class="text-[#35B724] text-2xl font-medium">✓</span>
            <span class="text-black font-normal"> Brand visibility to 250+ developers</span>
          </div>
          <div class="text-base leading-8">
            <span class="text-[#35B724] text-2xl font-medium">✓</span>
            <span class="text-black font-normal"> Support local tech community</span>
          </div>
          <div class="text-base leading-8">
            <span class="text-[#35B724] text-2xl font-medium">✓</span>
            <span class="text-black font-normal"> Recruiting opportunities</span>
          </div>
        </div>
        <div class="flex gap-4">
          <a
            href="/prospectus"
            target="_blank"
            class="px-8 py-4 btn-primary text-white text-base font-bold leading-relaxed text-center"
          >
            View Prospectus
          </a>
          <a
            href="https://buy.stripe.com/3cIaEX12u0e1bjLf1U4AU01"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 btn-secondary text-base font-bold leading-relaxed text-center"
          >
            Quick Logo Sponsorship ($500)
          </a>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="w-full py-10 lg:py-20 px-8 lg:px-[200px] bg-[#F3F4F6] relative overflow-hidden">
      <!-- Background image - grayscale, anchored to top with object-cover -->
      <div class="absolute inset-0 pointer-events-none grayscale">
        <Image src={aboutBkgd} alt="" class="w-full h-full object-cover object-top" width={1920} height={600} />
      </div>
      <!-- Decorative dots - hidden on mobile, shown on desktop -->
      <div class="hidden lg:block absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none">
        <Image src={heroDots} alt="" class="w-auto h-auto max-w-[350px]" width={460} height={403} />
      </div>
      <div class="max-w-[1040px] mx-auto p-8 bg-white card-shadow card-asymmetric flex flex-col gap-2 relative z-10">
        <h2 class="text-black text-[24px] lg:text-[32px] font-semibold leading-8 lg:leading-10 text-center lg:text-left">About</h2>
        <p class="text-black text-base font-normal leading-relaxed">
          Mark your calendar for Hampton Roads DevFest 2026! This unique gathering will once again spotlight local speakers, showcasing our community's deep and diverse talent.
          <br/><br/>
          Hampton Roads DevFest is more than a conference; it's a tribute to our dynamic local developer community. It's an ideal platform to highlight the exceptional places to work in the Hampton Roads area, emphasizing innovative technological strides. This event caters to everyone in the tech sphere, from seasoned developers and industry veterans to emerging talents and students.
        </p>
        <div class="p-4 bg-white rounded-[10px] flex flex-col items-center lg:items-start">
          <details class="w-full">
            <summary class="text-center text-[#D33B32] text-base font-bold leading-relaxed cursor-pointer hover:underline list-none">Read more</summary>
            <p class="mt-4 text-black text-base font-normal leading-relaxed">
              Organized by RevolutionVA, a dedicated 501(c)(3) non-profit, our mission is to advance software development education throughout Virginia. Our passion for promoting learning and growth in technology is at the heart of DevFest.
              <br/><br/>
              Take advantage of this unparalleled opportunity to network, learn from top industry professionals, and celebrate the remarkable achievements of our tech community. Whether you're looking to sharpen your skills, explore new career pathways, or simply immerse yourself in a community of like-minded tech enthusiasts, Hampton Roads DevFest is your destination.
              <br/><br/>
              Join us as we recognize and nurture the extraordinary tech talent that thrives in Hampton Roads. Let's connect, discover, and grow together at Hampton Roads DevFest 2026!
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- Sponsors Section -->
    <section id="sponsors" class="w-full py-10 md:py-20 px-8 lg:px-20 relative overflow-hidden">
      <!-- Background - NO opacity on image per user requirement -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute inset-0 bg-gradient-to-br from-[#123F4E] to-[#052831]"></div>
        <Image src={sponsorBkgd} alt="" class="absolute inset-0 w-full h-full object-cover" width={1920} height={800} />
      </div>

      <div class="max-w-7xl mx-auto flex flex-col gap-6 relative z-10">
        <!-- Header with heart icon -->
        <div class="py-6 rounded-[10px] flex flex-col items-center gap-2">
          <div class="flex items-center gap-4">
            <svg class="w-10 h-10" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 35.5L17.55 33.27C9.4 25.86 4 21.03 4 15.05C4 10.22 7.82 6.4 12.65 6.4C15.34 6.4 17.92 7.66 20 9.74C22.08 7.66 24.66 6.4 27.35 6.4C32.18 6.4 36 10.22 36 15.05C36 21.03 30.6 25.86 22.45 33.27L20 35.5Z" fill="#D33B32"/>
            </svg>
            <h2 class="text-center text-white text-[32px] font-bold leading-10">Our Sponsors</h2>
          </div>
          <p class="text-center text-white text-base font-normal leading-relaxed">
            Thank you to our sponsors for supporting the Hampton Roads tech community and making this event possible.
          </p>
        </div>

        <!-- Responsive Sponsor Grid: 1 col mobile, 2 col tablet, 4 col desktop -->
        <div class="pt-10 flex flex-col items-center gap-6 md:gap-10">
          <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-10">
            {allSponsors.map((sponsor) => (
              <a
                href={sponsor.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-8 md:p-10 bg-white card-asymmetric flex justify-center items-center hover:shadow-lg transition-shadow"
                title={sponsor.name}
              >
                <Image
                  src={sponsorLogos[sponsor.logo]}
                  alt={sponsor.name}
                  class="h-16 w-auto object-contain"
                />
              </a>
            ))}
            <!-- Your Company Here placeholder -->
            <div class="p-8 md:p-10 bg-white card-asymmetric flex flex-col justify-center items-center gap-4">
              <div class="w-full p-4 rounded-[10px] border-2 border-dashed border-[#D33B32] flex justify-center items-center">
                <span class="text-center text-black text-base font-bold">Your Company Here</span>
              </div>
              <a
                href="/prospectus"
                target="_blank"
                class="w-full px-8 py-4 btn-primary text-white text-base font-bold text-center"
              >
                Become a Sponsor
              </a>
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div class="w-full h-px bg-[#4DB7B9]"></div>

        <!-- Sponsorship CTA -->
        <div class="p-6 rounded-[10px] flex flex-col items-center gap-2">
          <div class="pb-10 flex flex-col gap-2 text-center">
            <h3 class="text-white text-[24px] md:text-[32px] font-bold leading-8 md:leading-10">
              Interested in Sponsoring Hampton Roads DevFest 2026?
            </h3>
            <p class="text-white text-base font-normal leading-relaxed">
              Help us make tech education accessible to our community while showcasing your organization to 250+ local developers.
            </p>
          </div>
          <!-- Buttons: stacked on mobile, side-by-side on tablet+ -->
          <div class="w-full md:w-auto flex flex-col md:flex-row justify-center gap-4">
            <a
              href="/prospectus"
              target="_blank"
              class="w-full md:w-auto px-8 py-4 btn-primary text-white text-base font-bold text-center"
            >
              View Sponsorship Prospectus
            </a>
            <a
              href="https://buy.stripe.com/3cIaEX12u0e1bjLf1U4AU01"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full md:w-auto px-8 py-4 btn-secondary text-base font-bold text-center"
            >
              Quick Logo Sponsorship ($500)
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="w-full p-8 md:py-10 lg:py-20 lg:px-[200px] bg-[#F3F4F6] relative">
      <!-- Decorative dots - top left (hidden on mobile) -->
      <div class="hidden lg:block absolute left-0 top-0 pointer-events-none w-[460px] h-[403px]">
        <Image src={headerDots} alt="" class="w-full h-full" width={460} height={403} />
      </div>
      <!-- Decorative dots - bottom right (hidden on mobile) -->
      <div class="hidden lg:block absolute right-0 bottom-0 pointer-events-none w-[460px] h-[403px] rotate-180">
        <Image src={headerDots} alt="" class="w-full h-full" width={460} height={403} />
      </div>

      <div class="max-w-[1040px] mx-auto flex flex-col items-center gap-6 relative z-10">
        <h2 class="text-black text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">FAQ</h2>

        {faqItems.map((item, index) => (
          <div class="faq-item w-full p-8 bg-white card-shadow card-asymmetric flex flex-col gap-4" data-index={index}>
            <button class="faq-question w-full flex justify-between items-center cursor-pointer">
              <span class="flex-1 text-black text-base font-bold leading-relaxed text-left">{item.question}</span>
              <svg class="faq-icon w-[25px] h-[25px] text-[#AAAAAA]" viewBox="0 0 25 25" fill="none">
                <path d="M6 9L12.5 16L19 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="faq-answer text-black text-base font-normal leading-relaxed">
              {item.answer}
            </div>
          </div>
        ))}

        <div class="h-10 px-4 rounded-[10px] flex flex-col justify-center items-center">
          <a href="#" class="text-center text-[#D33B32] text-base font-bold leading-relaxed hover:underline">More FAQ</a>
        </div>
      </div>
    </section>

    <!-- Venue Section -->
    <section id="venue" class="w-full card-shadow flex flex-col lg:flex-row relative">
      <!-- Top/Left section with gradient and venue info -->
      <div class="w-full lg:flex-1 h-[200px] lg:h-[530px] flex flex-col justify-center items-center gap-2.5 relative overflow-hidden">
        <!-- Background -->
        <div class="absolute inset-0 pointer-events-none">
          <Image src={venuePic} alt="" class="absolute left-0 top-0 h-full w-auto min-w-full object-left-top object-cover" />
        </div>

        <!-- Venue info - right aligned -->
        <div class="w-full px-8 md:pr-10 md:pl-8 text-right relative z-10">
          <h2 class="text-white text-[32px] md:text-[40px] font-bold mb-4">Venue</h2>
          <p class="text-white text-base md:text-2xl font-normal leading-relaxed md:leading-[30px]">
            Zeiders American Dream Theater<br/>
            4509 Commerce Street,<br/>
            Virginia Beach, VA 23462
          </p>
        </div>
      </div>

      <!-- Bottom/Right section with map -->
      <div class="w-full lg:flex-1">
        <iframe
