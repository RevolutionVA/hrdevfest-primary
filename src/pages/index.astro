                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
                <div class="faq-answer px-6 text-gray-600">
                  {item.answer}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Venue Section -->
      <section id="venue" class="relative py-16">
        <Image src={venueBg} alt="" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-brand-teal/80"></div>

        <!-- Tagline (absolute left edge on desktop) -->
        <div class="hidden lg:flex flex-col space-y-3 absolute left-6 top-1/2 -translate-y-1/2 z-20">
          <div class="flex items-center">
            <span class="tagline-dot bg-brand-blue"></span>
            <span class="text-white font-bold text-sm tracking-wider">C<span class="text-brand-blue">O</span>NNECT</span>
          </div>
          <div class="flex items-center ml-4">
            <span class="tagline-dot bg-brand-yellow"></span>
            <span class="text-white font-bold text-sm tracking-wider">DISC<span class="text-brand-yellow">O</span>VER</span>
          </div>
          <div class="flex items-center">
            <span class="tagline-dot bg-brand-green"></span>
            <span class="text-white font-bold text-sm tracking-wider">GR<span class="text-brand-green">O</span>W</span>
          </div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4">
          <!-- Venue Info -->
          <div class="text-center lg:text-left text-white mb-8">
            <h2 class="text-3xl font-bold mb-4">Venue</h2>
            <p class="text-xl font-semibold">Zeiders American Dream Theater</p>
            <p class="text-lg text-white/80">4509 Commerce Street,</p>
            <p class="text-lg text-white/80">Virginia Beach, VA 23462</p>
          </div>

          <div class="rounded-lg overflow-hidden card-shadow">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d798.259579003214!2d-76.13574812406885!3d36.84155839379043!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89ba959f7490b19d%3A0x2946d6df48a4c3ba!2sZeiders%20American%20Dream%20Theater!5e0!3m2!1sen!2sus!4v1708011885150!5m2!1sen!2sus"
              width="100%"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </section>

      <!-- Speakers Section -->
      <section id="speakers" class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4">
          <h2 class="text-3xl font-bold text-gray-800 mb-4 text-center">Featured Speakers</h2>
          <div class="bg-white rounded-lg p-6 card-shadow mb-8 max-w-2xl mx-auto">
            <p class="text-center text-gray-700 mb-2">
              Hampton Roads DevFest is special because it uniquely highlights the amazing developer talent we have in our region.
            </p>
            <p class="text-center text-gray-700">
              All HRDevFest speakers are current or past residents of the Hampton Roads area.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {speakers.map((speaker) => (
              <div class="bg-white rounded-lg p-6 card-shadow">
                <div class="flex gap-4">
                  <div class="flex-shrink-0">
                    <Image
                      src={speakerImages[speaker.image]}
                      alt={speaker.name}
                      class="w-24 h-24 rounded-full object-cover"
                      width={96}
                      height={96}
                    />
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-bold text-gray-800 mb-2">{speaker.name}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed line-clamp-3 mb-3">{speaker.bio}</p>
                    <div class="flex gap-3">
                      {speaker.linkedin && (
                        <a
                          href={speaker.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-brand-teal hover:text-brand-teal-dark transition-colors"
                          title="LinkedIn"
                        >
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                          </svg>
                        </a>
                      )}
                      {speaker.twitter && (
                        <a
                          href={speaker.twitter}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-gray-600 hover:text-gray-800 transition-colors"
                          title="Twitter"
                        >
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                          </svg>
                        </a>
                      )}
                      {speaker.website && (
                        <a
                          href={speaker.website}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-gray-600 hover:text-gray-800 transition-colors"
                          title="Website"
                        >
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                          </svg>
                        </a>
                      )}
                      {speaker.bluesky && (
                        <a
                          href={speaker.bluesky}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-blue-500 hover:text-blue-700 transition-colors"
                          title="Bluesky"
                        >
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.038.415-.055-.265.2-.532.34-.796.531-2.32 1.673-2.788 2.927-1.706 4.649 1.082 1.723 4.883 1.08 5.67-.542.364-.75.28-1.68.28-2.722 0 1.042-.084 1.972.28 2.722.787 1.622 4.588 2.265 5.67.542 1.082-1.722.614-2.976-1.706-4.649-.264-.191-.531-.331-.796-.531.14.017.279.035.415.055 2.67.296 5.568-.628 6.383-3.364.246-.829.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
                          </svg>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Testimonials Section -->
      <section id="testimonials" class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-3xl font-bold text-gray-800">Testimonials</h2>
            <a href="#" class="text-brand-red hover:text-brand-red-dark font-semibold">More testimonials</a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {[testimonials[0], testimonials[0], testimonials[0]].map((testimonial, index) => (
              <div class="bg-gray-50 rounded-lg p-6 card-shadow">
                <div class="flex justify-center mb-4">
                  <Image
                    src={testimonialImages[testimonial.image]}
                    alt={testimonial.name}
                    class="w-20 h-20 rounded-full object-cover"
                    width={80}
                    height={80}
                  />
                </div>
                <p class="text-gray-700 italic mb-4 text-center">"{testimonial.quote}"</p>
                <p class="font-semibold text-gray-800 text-center">{testimonial.name}</p>
                <div class="flex justify-center gap-4 mt-3">
                  {testimonial.linkedin && (
                    <a href={testimonial.linkedin} target="_blank" rel="noopener noreferrer" class="text-brand-teal hover:text-brand-teal-dark text-sm flex items-center gap-1">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                      LinkedIn
                    </a>
                  )}
                  {testimonial.twitter && (
                    <a href={testimonial.twitter} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-800 text-sm flex items-center gap-1">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                      </svg>
                      Twitter
                    </a>
                  )}
                  {testimonial.website && (
                    <a href={testimonial.website} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-800 text-sm flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                      </svg>
                      Website
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Years Section -->
      <section id="years" class="py-16 bg-gray-100">
        <div class="max-w-7xl mx-auto px-4">
          <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center">Our History</h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <a href="/years/2022" class="block group">
              <div class="rounded-lg overflow-hidden card-shadow bg-white">
                <Image src={year2022} alt="2022" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
              </div>
            </a>
            <a href="/years/2023" class="block group">
              <div class="rounded-lg overflow-hidden card-shadow bg-white">
                <Image src={year2023} alt="2023" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
              </div>
            </a>
            <a href="/years/2024" class="block group">
              <div class="rounded-lg overflow-hidden card-shadow bg-white">
                <Image src={year2024} alt="2024" class="w-full h-auto group-hover:scale-105 transition-transform duration-300" />
              </div>
            </a>
          </div>

          <!-- 2024 Highlights -->
          <div class="mt-12">
            <h3 class="text-2xl font-bold text-gray-800 mb-6 text-center">2024 Event Highlights</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="rounded-lg overflow-hidden card-shadow">
                <Image src={photo1} alt="2024 Event" class="w-full h-40 object-cover" />
              </div>
              <div class="rounded-lg overflow-hidden card-shadow">
                <Image src={photo3} alt="2024 Event" class="w-full h-40 object-cover" />
              </div>
              <div class="rounded-lg overflow-hidden card-shadow">
                <Image src={photo4} alt="2024 Event" class="w-full h-40 object-cover" />
              </div>
              <div class="rounded-lg overflow-hidden card-shadow">
                <Image src={photo6} alt="2024 Event" class="w-full h-40 object-cover" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Scholarship Section -->
      <section class="relative py-16">
        <Image src={scholarshipBg} alt="" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-brand-teal/85"></div>
        <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
          <div class="flex justify-center mb-6">
            <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M12 14l9-5-9-5-9 5 9 5z" />
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Apply for a 2026 Scholarship!
          </h2>
          <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
            Hampton Roads DevFest is committed to making our conference accessible to everyone.
            We're offering scholarships to students, career changers, and underrepresented groups
            in tech to help remove financial barriers to attending.
          </p>
          <a
            href="https://forms.gle/2SyzmmEMrsEirZAFA"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-4 bg-brand-red hover:bg-brand-red-dark text-white font-bold rounded-lg shadow-lg text-lg transition-colors"
          >
            Apply for Scholarship
          </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-6">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <p>Hampton Roads DevFest is presented by RevolutionVA, a 501c3 organization.</p>
      </div>
    </footer>
  </body>
</html>
