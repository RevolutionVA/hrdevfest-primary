---
import { Image } from "astro:assets";
import logoNew from "../assets/logo-new.png";
import logoWhite from "../assets/logo-white.png";
import heroBgDesktop from "../assets/hero-bg-desktop.png";
import heroBgTablet from "../assets/hero-bg-tablet.png";
import heroBgPhone from "../assets/hero-bg-phone.png";
import aboutBg from "../assets/about-bg.png";
import sponsorBg from "../assets/sponsor-bg.png";
import venueBg from "../assets/venue-bg.png";
import scholarshipBg from "../assets/scholarship-bg.png";
import year2022 from "../assets/years/2022.png";
import year2023 from "../assets/years/2023.png";
import year2024 from "../assets/years/2024.png";
import { speakers } from "../data/speakers";
import { sponsors } from "../data/sponsors";
import { testimonials } from "../data/testimonials";
import { faqItems } from "../data/faq";
import lionelSappImage from "../assets/speakers/lionel-sapp.jpeg";
import ryanCastilloImage from "../assets/speakers/ryan-castillo.jpeg";
import katieNovotnyImage from "../assets/speakers/katie-novotny.jpeg";
import timBanksImage from "../assets/speakers/tim-banks.jpeg";
import ianTaylorImage from "../assets/speakers/ian-taylor.jpeg";
import laurenPryorImage from "../assets/speakers/lauren-pryor.jpg";
import paulChinJrImage from "../assets/testimonials/paul-chin-jr.jpeg";
import issuetrakLogo from "../assets/sponsors/issuetrak.png";
import marathonLogo from "../assets/sponsors/marathon.png";
import opensearchLogo from "../assets/sponsors/opensearch.png";
import swiftkickLogo from "../assets/sponsors/swiftkick.png";
import landrecordsLogo from "../assets/sponsors/landrecords.png";
import progressLogo from "../assets/sponsors/progress.png";
import stigianLogo from "../assets/sponsors/stigian.png";
import noteableLogo from "../assets/sponsors/noteable.png";

// 2024 Event Photos
import photo1 from "../assets/2024-photos/2024-05-31 08.30.41.jpg";
import photo3 from "../assets/2024-photos/2024-05-31 14.13.46.jpg";
import photo4 from "../assets/2024-photos/IMG_9620.jpeg";
import photo6 from "../assets/2024-photos/2024-05-31 09.48.48.jpg";

const speakerImages: Record<string, any> = {
  "lionel-sapp.jpeg": lionelSappImage,
  "ryan-castillo.jpeg": ryanCastilloImage,
  "katie-novotny.jpeg": katieNovotnyImage,
  "tim-banks.jpeg": timBanksImage,
  "ian-taylor.jpeg": ianTaylorImage,
  "lauren-pryor.jpg": laurenPryorImage,
};

const testimonialImages: Record<string, any> = {
  "paul-chin-jr.jpeg": paulChinJrImage,
};

const sponsorLogos: Record<string, any> = {
  "issuetrak.png": issuetrakLogo,
  "marathon.png": marathonLogo,
  "opensearch.png": opensearchLogo,
  "swiftkick.png": swiftkickLogo,
  "landrecords.png": landrecordsLogo,
  "progress.png": progressLogo,
  "stigian.png": stigianLogo,
  "noteable.png": noteableLogo,
};

// Group sponsors by tier for display
const sponsorsByTier = {
  platinum: sponsors.filter(s => s.tier === 'platinum'),
  gold: sponsors.filter(s => s.tier === 'gold'),
  silver: sponsors.filter(s => s.tier === 'silver'),
  logo: sponsors.filter(s => s.tier === 'logo'),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hampton Roads DevFest | Feb 27th, 2026 | Virginia Beach, VA</title>
    <link href="/dist/index.css" rel="stylesheet" />
    <style>
      /* Hero responsive backgrounds */
      .hero-section {
        background-image: url('/src/assets/hero-bg-phone.png');
        background-size: cover;
        background-position: center;
      }
      @media (min-width: 768px) {
        .hero-section {
          background-image: url('/src/assets/hero-bg-tablet.png');
        }
      }
      @media (min-width: 1024px) {
        .hero-section {
          background-image: url('/src/assets/hero-bg-desktop.png');
        }
      }

      /* Card styles */
      .card-shadow {
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        transition: all 0.3s ease;
      }
      .card-shadow:hover {
        box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        transform: translateY(-2px);
      }

      /* Navigation link styles */
      .nav-link {
        position: relative;
        padding-bottom: 2px;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background-color: #E53935;
        transition: width 0.3s ease;
      }
      .nav-link.active::after {
        width: 100%;
      }

      /* Scroll offset for fixed header */
      section[id]:before {
        content: "";
        display: block;
        height: 80px;
        margin-top: -80px;
        visibility: hidden;
      }

      /* FAQ accordion */
      .faq-item {
        border-bottom: 1px solid #e5e7eb;
      }
      .faq-answer {
        display: none;
        padding: 0 1.5rem 1rem;
      }
      .faq-item.open .faq-answer {
        display: block;
      }
      .faq-toggle {
        transition: transform 0.3s ease;
      }
      .faq-item.open .faq-toggle {
        transform: rotate(90deg);
      }

      /* About section read more */
      .about-content {
        max-height: 150px;
        overflow: hidden;
        transition: max-height 0.5s ease;
      }
      .about-content.expanded {
        max-height: 1000px;
      }

      /* Mobile menu */
      .mobile-menu {
        display: none;
      }
      .mobile-menu.open {
        display: block;
      }

      /* Tagline dots */
      .tagline-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 4px;
      }
    </style>
  </head>
  <body class="flex flex-col min-h-screen bg-gray-100 text-gray-900">
    <script>
      // Handle active section highlighting
      function updateActiveSection() {
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.nav-link');
        const scrollPosition = window.scrollY + 100;

        sections.forEach((section) => {
          const sectionTop = (section as HTMLElement).offsetTop;
          const sectionHeight = (section as HTMLElement).offsetHeight;
          const sectionId = section.getAttribute('id');

          if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
            navLinks.forEach((link) => {
              link.classList.remove('active');
              if (link.getAttribute('href') === `#${sectionId}`) {
                link.classList.add('active');
              }
            });
          }
        });
      }

      window.addEventListener('scroll', updateActiveSection);
      window.addEventListener('load', updateActiveSection);

      // Mobile menu toggle
      document.addEventListener('DOMContentLoaded', function() {
        const menuButton = document.getElementById('menuButton');
        const mobileMenu = document.getElementById('mobileMenu');

        if (menuButton && mobileMenu) {
          menuButton.addEventListener('click', function() {
            mobileMenu.classList.toggle('open');
          });
        }

        // FAQ accordion
        const faqItems = document.querySelectorAll('.faq-item');
        faqItems.forEach(item => {
          const header = item.querySelector('.faq-header');
          if (header) {
            header.addEventListener('click', () => {
              item.classList.toggle('open');
            });
          }
        });

        // About read more
        const readMoreBtn = document.getElementById('readMoreBtn');
        const aboutContent = document.getElementById('aboutContent');
        if (readMoreBtn && aboutContent) {
          readMoreBtn.addEventListener('click', () => {
            aboutContent.classList.toggle('expanded');
            readMoreBtn.textContent = aboutContent.classList.contains('expanded') ? 'Read less' : 'Read more';
          });
        }
      });
    </script>

    <!-- Navigation -->
    <nav class="fixed top-0 w-full bg-white z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between items-center py-3">
          <!-- Desktop Nav - Buy Tickets on left -->
          <div class="hidden md:block">
            <a href="https://events.humanitix.com/hampton-roads-devfest-2026" target="_blank" class="px-4 py-2 bg-brand-red text-white font-semibold rounded-lg hover:bg-brand-red-dark transition-colors">
              Buy Tickets
            </a>
          </div>

          <!-- Desktop Nav - Links on right -->
          <div class="hidden md:flex items-center space-x-6">
            <a class="nav-link text-gray-700 hover:text-brand-teal font-medium" href="#about">About</a>
            <a class="nav-link text-gray-700 hover:text-brand-teal font-medium" href="#venue">Venue</a>
            <a class="nav-link text-gray-700 hover:text-brand-teal font-medium" href="#speakers">Speakers</a>
            <a class="nav-link text-gray-700 hover:text-brand-teal font-medium" href="#testimonials">Testimonials</a>
            <a class="nav-link text-gray-700 hover:text-brand-teal font-medium" href="#years">2024</a>
            <a class="nav-link text-gray-700 hover:text-brand-teal font-medium" href="#faq">FAQ</a>
          </div>

          <!-- Mobile Menu Button -->
          <div class="md:hidden flex items-center justify-between w-full">
            <a href="https://events.humanitix.com/hampton-roads-devfest-2026" target="_blank" class="px-4 py-2 bg-brand-red text-white font-semibold rounded-lg text-sm">
              Buy Tickets
            </a>
            <button id="menuButton" class="p-2 text-gray-700">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobileMenu" class="mobile-menu md:hidden pb-4">
          <div class="flex flex-col space-y-3">
            <a class="text-gray-700 hover:text-brand-teal font-medium py-2" href="#about">About</a>
            <a class="text-gray-700 hover:text-brand-teal font-medium py-2" href="#venue">Venue</a>
            <a class="text-gray-700 hover:text-brand-teal font-medium py-2" href="#speakers">Speakers</a>
            <a class="text-gray-700 hover:text-brand-teal font-medium py-2" href="#testimonials">Testimonials</a>
            <a class="text-gray-700 hover:text-brand-teal font-medium py-2" href="#years">2024</a>
            <a class="text-gray-700 hover:text-brand-teal font-medium py-2" href="#faq">FAQ</a>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-1 pt-16">
      <!-- Hero Section -->
      <section class="relative bg-brand-teal min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden">
        <Image src={heroBgDesktop} alt="" class="absolute inset-0 w-full h-full object-cover opacity-60 hidden lg:block" />
        <Image src={heroBgTablet} alt="" class="absolute inset-0 w-full h-full object-cover opacity-60 hidden md:block lg:hidden" />
        <Image src={heroBgPhone} alt="" class="absolute inset-0 w-full h-full object-cover opacity-60 md:hidden" />
        <div class="absolute inset-0 bg-brand-teal/40"></div>

        <!-- Tagline (absolute left edge on desktop) -->
        <div class="hidden lg:flex flex-col space-y-3 absolute left-6 top-1/2 -translate-y-1/2 z-20">
          <div class="flex items-center">
            <span class="tagline-dot bg-brand-blue"></span>
            <span class="text-white font-bold text-sm tracking-wider">C<span class="text-brand-blue">O</span>NNECT</span>
          </div>
          <div class="flex items-center ml-4">
            <span class="tagline-dot bg-brand-yellow"></span>
            <span class="text-white font-bold text-sm tracking-wider">DISC<span class="text-brand-yellow">O</span>VER</span>
          </div>
          <div class="flex items-center">
            <span class="tagline-dot bg-brand-green"></span>
            <span class="text-white font-bold text-sm tracking-wider">GR<span class="text-brand-green">O</span>W</span>
          </div>
        </div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 py-12">
          <!-- Main Hero Content -->
          <div class="flex flex-col items-center text-center">
            <Image src={logoNew} alt="Hampton Roads DevFest" class="w-48 md:w-64 mb-6" />
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
              Hampton Roads<br />DevFest 2026
            </h1>
            <p class="text-xl md:text-2xl text-white/90 mb-8">
              SAVE THE DATE: Feb 27th, 2026 - Virginia Beach, VA
            </p>

            <!-- Mobile Tagline -->
            <div class="flex lg:hidden items-center justify-center gap-4 mb-8">
              <span class="text-white text-sm font-semibold"><span class="tagline-dot bg-brand-blue"></span>CONNECT</span>
              <span class="text-white text-sm font-semibold"><span class="tagline-dot bg-brand-yellow"></span>DISCOVER</span>
              <span class="text-white text-sm font-semibold"><span class="tagline-dot bg-brand-green"></span>GROW</span>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="https://events.humanitix.com/hampton-roads-devfest-2026"
                target="_blank"
                class="px-8 py-4 bg-brand-red hover:bg-brand-red-dark text-white font-bold rounded-lg shadow-lg text-lg transition-all duration-300 hover:scale-105"
              >
                Buy Tickets
              </a>
              <a
                href="/prospectus"
                target="_blank"
                class="px-8 py-4 bg-transparent border-2 border-white text-white hover:bg-white hover:text-brand-teal font-bold rounded-lg shadow-lg text-lg transition-all duration-300"
              >
                Become a Sponsor
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Become a Sponsor Card -->
      <section class="bg-gray-100 py-8">
        <div class="max-w-7xl mx-auto px-4">
          <div class="bg-white rounded-lg p-6 md:p-8 card-shadow flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
              <h2 class="text-2xl font-bold text-gray-800 mb-2">Become a Sponsor</h2>
              <p class="text-gray-600 mb-4">Showcase your organization to local developers and support tech education.</p>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-brand-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Brand visibility to 250+ developers
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-brand-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Support local tech community
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-brand-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Recruiting opportunities
                </li>
              </ul>
            </div>
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="/prospectus"
                target="_blank"
                class="px-6 py-3 bg-brand-teal hover:bg-brand-teal-dark text-white font-semibold rounded-lg transition-colors text-center"
