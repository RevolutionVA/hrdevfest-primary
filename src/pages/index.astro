                View Prospectus
              </a>
              <a
                href="https://buy.stripe.com/3cIaEX12u0e1bjLf1U4AU01"
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-3 bg-white border-2 border-brand-teal text-brand-teal hover:bg-brand-teal hover:text-white font-semibold rounded-lg transition-colors text-center"
              >
                Quick Logo Sponsorship ($500)
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="relative py-16">
        <Image src={aboutBg} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30" />
        <div class="relative z-10 max-w-4xl mx-auto px-4">
