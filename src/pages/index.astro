---
import { Image } from "astro:assets";
import hrdevfestLogo from "../assets/hrdevfest-logo.png";
import heroDots from "../assets/hero-dots.svg";
import { sponsors } from "../data/sponsors";
import { testimonials } from "../data/testimonials";
import { faqItems } from "../data/faq";
import paulChinJrImage from "../assets/testimonials/paul-chin-jr.jpeg";
import issuetrakLogo from "../assets/sponsors/issuetrak.png";
import marathonLogo from "../assets/sponsors/marathon.png";
import opensearchLogo from "../assets/sponsors/opensearch.png";
import swiftkickLogo from "../assets/sponsors/swiftkick.png";
import landrecordsLogo from "../assets/sponsors/landrecords.png";
import progressLogo from "../assets/sponsors/progress.png";
import stigianLogo from "../assets/sponsors/stigian.png";
import noteableLogo from "../assets/sponsors/noteable.png";

const testimonialImages: Record<string, any> = {
  "paul-chin-jr.jpeg": paulChinJrImage,
};

const sponsorLogos: Record<string, any> = {
  "issuetrak.png": issuetrakLogo,
  "marathon.png": marathonLogo,
  "opensearch.png": opensearchLogo,
  "swiftkick.png": swiftkickLogo,
  "landrecords.png": landrecordsLogo,
  "progress.png": progressLogo,
  "stigian.png": stigianLogo,
  "noteable.png": noteableLogo,
};

// Group sponsors by tier for display
const sponsorsByTier = {
  platinum: sponsors.filter(s => s.tier === 'platinum'),
  gold: sponsors.filter(s => s.tier === 'gold'),
  silver: sponsors.filter(s => s.tier === 'silver'),
  logo: sponsors.filter(s => s.tier === 'logo'),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hampton Roads DevFest | Feb 27th, 2026 | Virginia Beach, VA</title>
    <link href="/dist/index.css" rel="stylesheet" />
    <style is:global>
      /* Card styles */
      .card-shadow {
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        transition: all 0.3s ease;
      }
      .card-shadow:hover {
        box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        transform: translateY(-2px);
      }

      /* Navigation link styles */
      .nav-link {
        position: relative;
        padding-bottom: 2px;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background-color: #E53935;
        transition: width 0.3s ease;
      }
      .nav-link.active::after {
        width: 100%;
      }

      /* Scroll offset for fixed header */
      section[id]:before {
        content: "";
        display: block;
        height: 80px;
        margin-top: -80px;
        visibility: hidden;
      }

      /* FAQ accordion */
      .faq-item {
        border-bottom: 1px solid #e5e7eb;
      }
      .faq-answer {
        display: none;
        padding: 0 1.5rem 1rem;
      }
      .faq-item.open .faq-answer {
        display: block;
      }
      .faq-toggle {
        transition: transform 0.3s ease;
      }
      .faq-item.open .faq-toggle {
        transform: rotate(180deg);
      }

      /* About section read more */
      .about-content {
        max-height: 150px;
        overflow: hidden;
        transition: max-height 0.5s ease;
      }
      .about-content.expanded {
        max-height: 1000px;
      }

      /* Mobile menu */
      .mobile-menu {
        display: none;
      }
      .mobile-menu.open {
        display: block;
      }

    </style>
  </head>
  <body class="flex flex-col min-h-screen bg-gray-100 text-gray-900">
    <script>
      // Handle active section highlighting
      function updateActiveSection() {
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.nav-link');
        const scrollPosition = window.scrollY + 100;

        sections.forEach((section) => {
          const sectionTop = (section as HTMLElement).offsetTop;
          const sectionHeight = (section as HTMLElement).offsetHeight;
          const sectionId = section.getAttribute('id');

          if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
            navLinks.forEach((link) => {
              link.classList.remove('active');
              if (link.getAttribute('href') === `#${sectionId}`) {
                link.classList.add('active');
              }
            });
          }
        });
      }

      window.addEventListener('scroll', updateActiveSection);
      window.addEventListener('load', updateActiveSection);

      // Mobile menu toggle
      document.addEventListener('DOMContentLoaded', function() {
        const menuButton = document.getElementById('menuButton');
        const mobileMenu = document.getElementById('mobileMenu');

        if (menuButton && mobileMenu) {
          menuButton.addEventListener('click', function() {
            mobileMenu.classList.toggle('open');
          });
        }

        // FAQ accordion
        const faqItems = document.querySelectorAll('.faq-item');
        faqItems.forEach(item => {
          const header = item.querySelector('.faq-header');
          if (header) {
            header.addEventListener('click', () => {
              item.classList.toggle('open');
            });
          }
        });

        // About read more
        const readMoreBtn = document.getElementById('readMoreBtn');
        const aboutContent = document.getElementById('aboutContent');
        if (readMoreBtn && aboutContent) {
          readMoreBtn.addEventListener('click', () => {
            aboutContent.classList.toggle('expanded');
            readMoreBtn.textContent = aboutContent.classList.contains('expanded') ? 'Read less' : 'Read more';
          });
        }
      });
    </script>

    <!-- Navigation Bar -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-900 h-14 px-6 flex items-center justify-between">
      <!-- Left: CONNECT branding -->
      <span class="text-white text-sm font-bold tracking-wider uppercase">CONNECT</span>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="https://events.humanitix.com/hampton-roads-devfest-2026" target="_blank" class="text-red-500 text-sm font-medium hover:text-red-400 transition-colors">
          Buy Tickets
        </a>
        <a class="text-white text-sm font-medium hover:text-gray-300 transition-colors" href="#about">About</a>
        <a class="text-white text-sm font-medium hover:text-gray-300 transition-colors" href="#venue">Venue</a>
        <a class="text-white text-sm font-medium hover:text-gray-300 transition-colors" href="#sponsors">Sponsors</a>
        <a class="text-white text-sm font-medium hover:text-gray-300 transition-colors" href="#testimonials">Testimonials</a>
        <a class="text-white text-sm font-medium hover:text-gray-300 transition-colors" href="#faq">FAQ</a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="menuButton" class="md:hidden p-2 text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="mobile-menu fixed top-14 left-0 right-0 z-40 bg-slate-900 md:hidden">
      <div class="flex flex-col px-6 py-4 space-y-3">
        <a href="https://events.humanitix.com/hampton-roads-devfest-2026" target="_blank" class="text-red-500 text-sm font-medium">Buy Tickets</a>
        <a class="text-white text-sm font-medium hover:text-gray-300" href="#about">About</a>
        <a class="text-white text-sm font-medium hover:text-gray-300" href="#venue">Venue</a>
        <a class="text-white text-sm font-medium hover:text-gray-300" href="#sponsors">Sponsors</a>
        <a class="text-white text-sm font-medium hover:text-gray-300" href="#testimonials">Testimonials</a>
        <a class="text-white text-sm font-medium hover:text-gray-300" href="#faq">FAQ</a>
      </div>
    </div>

    <main class="flex-1">
      <!-- Hero Section -->
      <section class="relative bg-slate-900 pt-14">
        <!-- Background pattern -->
        <img src={heroDots.src} alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />

        <!-- Content wrapper -->
        <div class="relative z-10 max-w-7xl mx-auto px-6 py-16 flex flex-col lg:flex-row items-center lg:items-center min-h-[320px]">

          <!-- Left Column: Logo only (DISCOVER/GROW labels come from hero-dots.svg background) -->
          <div class="hidden lg:flex flex-col items-start w-48">
            <div class="w-24 h-24 rounded-full bg-white flex items-center justify-center p-2">
              <Image src={hrdevfestLogo} alt="Hampton Roads DevFest" class="w-full h-full object-contain" />
            </div>
          </div>

          <!-- Mobile: Logo centered -->
          <div class="lg:hidden flex justify-center mb-6">
            <div class="w-20 h-20 rounded-full bg-white flex items-center justify-center p-2">
              <Image src={hrdevfestLogo} alt="Hampton Roads DevFest" class="w-full h-full object-contain" />
            </div>
          </div>

          <!-- Right Column: Heading + CTAs -->
          <div class="lg:ml-12 flex flex-col items-center lg:items-start text-center lg:text-left">
            <h1 class="text-white text-4xl lg:text-5xl font-bold leading-tight">
              Hampton Roads<br />DevFest 2026
            </h1>
            <p class="mt-4 text-white text-lg font-normal">
              SAVE THE DATE: Feb 27th, 2026 - Virginia Beach, VA
            </p>
            <!-- Buttons -->
            <div class="mt-6 flex flex-col sm:flex-row items-center gap-4">
              <a
                href="https://events.humanitix.com/hampton-roads-devfest-2026"
                target="_blank"
                class="bg-red-500 hover:bg-red-600 text-white text-sm font-semibold px-6 py-3 rounded-md transition-colors"
              >
                Buy Tickets
              </a>
              <a
                href="/prospectus"
                target="_blank"
                class="bg-transparent border-2 border-white text-white text-sm font-semibold px-6 py-3 rounded-md hover:bg-white hover:text-slate-900 transition-colors"
              >
                Become a Sponsor
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Become a Sponsor Card -->
      <section class="bg-white py-6 px-6">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-2">Become a Sponsor</h2>
            <p class="text-gray-600 mb-4">Showcase your organization to local developers and support tech education.</p>
            <ul class="space-y-2 text-gray-700">
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                Brand visibility to 250+ developers
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                Support local tech community
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                Recruiting opportunities
              </li>
            </ul>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/prospectus"
              target="_blank"
              class="px-6 py-3 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-md transition-colors text-center"
            >
              View Prospectus
            </a>
            <a
              href="https://buy.stripe.com/3cIaEX12u0e1bjLf1U4AU01"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 bg-white border-2 border-slate-300 text-slate-700 hover:bg-slate-50 font-semibold rounded-md transition-colors text-center"
            >
              Quick Logo Sponsorship ($500)
            </a>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="relative bg-slate-900 py-16 px-6">
        <!-- Background pattern -->
        <img src={heroDots.src} alt="" class="absolute inset-0 w-full h-full object-cover opacity-10" />
        <div class="relative z-10 max-w-3xl mx-auto">
          <div class="bg-white rounded-xl shadow-lg p-8 md:p-10">
            <h2 class="text-3xl font-bold text-slate-900 mb-6">About</h2>
            <div id="aboutContent" class="about-content text-gray-700 leading-relaxed">
              <p class="mb-4">
                Mark your calendar for Hampton Roads DevFest 2026! This unique gathering will once again spotlight local speakers,
                showcasing our community's deep and diverse talent.
              </p>
              <p class="mb-4">
                Hampton Roads DevFest is more than a conference; it's a tribute to our dynamic local developer community. It's an ideal platform
                to highlight the exceptional places to work in the Hampton Roads area, emphasizing innovative technological strides. This event
                caters to everyone in the tech sphere, from seasoned developers and industry veterans to emerging talents and students.
              </p>
              <p class="mb-4">
                Organized by RevolutionVA, a dedicated 501(c)(3) non-profit, our mission is to advance software development education throughout
                Virginia. Our passion for promoting learning and growth in technology is at the heart of DevFest.
              </p>
              <p class="mb-4">
                Take advantage of this unparalleled opportunity to network, learn from top industry professionals, and celebrate the remarkable
                achievements of our tech community. Whether you're looking to sharpen your skills, explore new career pathways, or simply immerse
                yourself in a community of like-minded tech enthusiasts, Hampton Roads DevFest is your destination.
              </p>
              <p>
                Join us as we recognize and nurture the extraordinary tech talent that thrives in Hampton Roads. Let's connect, discover, and grow
                together at Hampton Roads DevFest 2026!
              </p>
            </div>
            <button id="readMoreBtn" class="mt-4 text-red-500 hover:text-red-600 text-sm font-medium transition-colors">
              Read more
            </button>
          </div>
        </div>
      </section>

      <!-- Sponsors Section -->
      <section id="sponsors" class="bg-gray-100 py-16 px-6">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-12">
            <div class="flex items-center justify-center gap-3 mb-4">
              <svg class="w-8 h-8 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
              </svg>
              <h2 class="text-3xl font-bold text-slate-900">Our Sponsors</h2>
            </div>
            <p class="text-gray-600">Thank you to our sponsors for supporting the Hampton Roads tech community and making this event possible.</p>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 max-w-4xl mx-auto mb-12">
            {[...sponsorsByTier.platinum, ...sponsorsByTier.gold, ...sponsorsByTier.silver, ...sponsorsByTier.logo].map((sponsor) => (
              <a
                href={sponsor.url}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white rounded-lg shadow-sm p-6 flex items-center justify-center h-24 transition-transform hover:scale-105"
                title={sponsor.name}
              >
                <Image
                  src={sponsorLogos[sponsor.logo]}
                  alt={sponsor.name}
                  class="max-h-16 max-w-full w-auto h-auto object-contain"
                />
              </a>
            ))}

            <!-- Your Company Here -->
            <a
              href="/prospectus"
              target="_blank"
              class="bg-white border-2 border-dashed border-gray-300 rounded-lg p-6 flex flex-col items-center justify-center h-24 text-gray-500 hover:border-red-500 hover:text-red-500 transition-colors"
            >
              <span class="font-semibold text-sm">Your Company Here</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Secondary Sponsor CTA -->
      <section class="relative bg-slate-900 py-14 px-6">
        <img src={heroDots.src} alt="" class="absolute inset-0 w-full h-full object-cover opacity-10" />
        <div class="relative z-10 max-w-2xl mx-auto text-center">
          <h2 class="text-2xl font-bold text-white mb-4">
            Interested in Sponsoring Hampton Roads DevFest 2026?
          </h2>
          <p class="text-gray-300 mb-6">
            Help us make tech education accessible to our community while showcasing your organization to 250+ local developers.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/prospectus"
              target="_blank"
              class="px-6 py-3 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-md transition-colors"
            >
              View Sponsorship Prospectus
            </a>
            <a
              href="https://buy.stripe.com/3cIaEX12u0e1bjLf1U4AU01"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-md transition-colors"
            >
              Quick Logo Sponsorship ($500)
            </a>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section id="faq" class="bg-white py-16 px-6">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl font-bold text-slate-900 mb-8 text-center">FAQ</h2>

          <div class="divide-y divide-gray-200 border-t border-b border-gray-200">
            {faqItems.map((item, index) => (
              <div class={`faq-item ${index === 0 ? 'open' : ''}`}>
                <button class="faq-header w-full py-4 flex items-center justify-between text-left hover:text-red-500 transition-colors">
                  <span class="font-semibold text-slate-900">{item.question}</span>
                  <svg class="faq-toggle w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div class="faq-answer pb-4 text-gray-600">
                  {item.answer}
                </div>
              </div>
            ))}
          </div>

          <div class="mt-6 text-center">
            <a href="#" class="text-red-500 hover:text-red-600 text-sm font-medium">More FAQ</a>
          </div>
        </div>
      </section>

      <!-- Venue Section -->
      <section id="venue" class="bg-white">
        <div class="flex flex-col lg:flex-row">
          <!-- Left Column: Tagline + Info -->
          <div class="lg:w-1/2 py-12 px-6 lg:px-12 flex flex-col justify-center">
            <!-- Tagline stack -->
            <div class="flex flex-col space-y-2 mb-8">
              <div class="flex items-center">
                <span class="text-slate-900 font-bold text-sm tracking-wider">C<span class="text-blue-500">O</span>NNECT</span>
                <div class="ml-3 h-px w-16 bg-red-500"></div>
              </div>
              <div class="flex items-center">
                <span class="text-slate-900 font-bold text-sm tracking-wider">DISC<span class="text-yellow-500">O</span>VER</span>
                <div class="ml-3 h-px w-16 bg-red-500"></div>
              </div>
              <div class="flex items-center">
                <span class="text-slate-900 font-bold text-sm tracking-wider">GR<span class="text-green-500">O</span>W</span>
                <div class="ml-3 h-px w-16 bg-red-500"></div>
              </div>
            </div>

            <!-- Venue Info -->
            <div>
              <h2 class="text-3xl font-bold text-slate-900 mb-4">Venue</h2>
              <p class="text-xl font-semibold text-slate-900">Zeiders American Dream Theater</p>
              <p class="text-gray-600">4509 Commerce Street,</p>
              <p class="text-gray-600">Virginia Beach, VA 23462</p>
            </div>
          </div>

          <!-- Right Column: Map -->
          <div class="lg:w-1/2 relative">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d798.259579003214!2d-76.13574812406885!3d36.84155839379043!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89ba959f7490b19d%3A0x2946d6df48a4c3ba!2sZeiders%20American%20Dream%20Theater!5e0!3m2!1sen!2sus!4v1708011885150!5m2!1sen!2sus"
              width="100%"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="lg:h-full lg:min-h-[400px]"></iframe>
          </div>
        </div>
      </section>

      <!-- Testimonials Section -->
      <section id="testimonials" class="bg-gray-50 py-14 px-6">
        <div class="max-w-7xl mx-auto">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-3xl font-bold text-slate-900">Testimonials</h2>
            <a href="#" class="text-red-500 hover:text-red-600 text-sm font-medium">More testimonials</a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {[testimonials[0], testimonials[0], testimonials[0]].map((testimonial, index) => (
              <div class="bg-white rounded-xl shadow-sm p-6">
                <div class="flex justify-center mb-4">
                  <Image
                    src={testimonialImages[testimonial.image]}
                    alt={testimonial.name}
                    class="w-12 h-12 rounded-full object-cover"
                    width={48}
                    height={48}
                  />
                </div>
                <p class="text-gray-700 italic mb-4 text-center text-sm">"{testimonial.quote}"</p>
                <p class="font-semibold text-slate-900 text-center text-sm">{testimonial.name}</p>
                <div class="flex justify-center gap-4 mt-3">
                  {testimonial.linkedin && (
                    <a href={testimonial.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-red-500 text-xs flex items-center gap-1 transition-colors">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
