---
import "../styles/global.css";
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import CanonicalLink from "../components/CanonicalLink.astro";
import PastYearsNav from "../components/PastYearsNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import LandmarkLineArt from "../components/LandmarkLineArt.astro";
import { sheetFor } from "../data/titleBlock";
import logoWhite from "../assets/logo-white.png";
import { testimonials } from "../data/testimonials";
import { faqItems } from "../data/faq";
import paulChinJrImage from "../assets/testimonials/paul-chin-jr.jpeg";
import michaelBuckbeeImage from "../assets/testimonials/michael-buckbee.jpg";
import travisWebbImage from "../assets/testimonials/travis-webb.png";

const testimonialImages: Record<string, any> = {
  "paul-chin-jr.jpeg": paulChinJrImage,
  "michael-buckbee.jpg": michaelBuckbeeImage,
  "travis-webb.png": travisWebbImage,
};

const events = await getCollection('events');
const pastYears = events.map(e => e.data.year).sort((a, b) => b - a);

// 2026 platinum and gold sponsors for the logo row above the signup form
const sponsorLogoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/sponsors/*", { eager: true });
const sponsorLogos: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(sponsorLogoFiles).map(([path, mod]) => [path.split("/").pop()!, mod.default])
);
const sponsors2026 = ((await getEntry('events', '2026/event'))?.data.sponsors ?? [])
  .filter((sponsor) => sponsor.tier === 'platinum' || sponsor.tier === 'gold');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hampton Roads DevFest 2027 | Virginia Beach, VA</title>
    <meta name="description" content="Hampton Roads DevFest 2027 is Friday, April 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA. Sign up for updates about our community-driven developer conference." />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Hampton Roads DevFest 2027 | Virginia Beach, VA" />
    <meta property="og:description" content="Hampton Roads DevFest 2027 is Friday, April 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA." />
    <meta property="og:url" content="https://hrdevfest.org" />
    <CanonicalLink href="https://hrdevfest.org" />
    <meta property="og:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />
    <meta property="og:site_name" content="Hampton Roads DevFest" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hrdevfest" />
    <meta name="twitter:title" content="Hampton Roads DevFest 2027 | Virginia Beach, VA" />
    <meta name="twitter:description" content="Hampton Roads DevFest 2027 is Friday, April 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA." />
    <meta name="twitter:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <style>
      /* FAQ Accordion */
      .faq-item .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out;
      }
      .faq-item.active .faq-answer {
        max-height: 500px;
      }
      .faq-item.active .faq-icon {
        transform: rotate(180deg);
      }
    </style>

    <GoogleAnalytics />
  </head>
  <body class="min-h-screen">
    <!-- Mobile hamburger button - outside the frame so it stays fixed -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bp-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <!-- Hamburger icon -->
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- X icon (hidden by default) -->
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bp-frame">

    <!-- Hero Section with Nav -->
    <section class="hero-section w-full relative">
      <!-- Navigation -->
      <nav class="w-full px-4 md:px-8 py-4 border-b border-[var(--bp-line)] relative z-20">
        <div class="max-w-7xl mx-auto flex justify-end">
          <!-- Desktop/Tablet nav links -->
          <div class="hidden md:flex items-center gap-6 lg:gap-10">
            <a href="#about" class="bp-nav-link text-base font-bold leading-relaxed">About</a>
            <a href="#venue" class="bp-nav-link text-base font-bold leading-relaxed">Venue</a>
            <a href="#testimonials" class="bp-nav-link text-base font-bold leading-relaxed">Testimonials</a>
            <PastYearsNav variant="desktop" />
            <a href="#faq" class="bp-nav-link text-base font-bold leading-relaxed">FAQ</a>
            <a href="/sponsor" class="bp-nav-link text-base font-bold leading-relaxed">Sponsor</a>
            <a href="#signup" class="bp-nav-link text-base font-bold leading-relaxed">Sign Up</a>
          </div>
        </div>
      </nav>

      <!-- Mobile Menu Overlay -->
      <div id="mobile-menu" class="fixed inset-0 z-50 bg-[var(--bp-paper)] hidden md:hidden">
        <div class="flex flex-col h-full">
          <!-- Spacer for hamburger button area -->
          <div class="h-[60px]"></div>
          <!-- Menu links -->
          <div class="flex flex-col gap-8 px-8 pt-4">
            <a href="#about" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">About</a>
            <a href="#venue" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Venue</a>
            <a href="#testimonials" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Testimonials</a>
            <PastYearsNav variant="mobile" />
            <a href="#faq" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">FAQ</a>
            <a href="/sponsor" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Sponsor</a>
            <a href="#signup" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Sign Up</a>
          </div>
        </div>
      </div>

      <!-- Hero Content (bottom padding leaves room for the line art row) -->
      <div class="relative z-10 w-full px-4 md:px-8 pt-16 pb-8 md:pb-[400px] min-[90rem]:pt-8 min-[90rem]:pb-[350px]">
        <div class="max-w-7xl mx-auto">
          <!-- Logo, headline, and the event date and place -->
          <div class="w-fit mx-auto px-6 py-8 md:px-12 bp-surface flex flex-col items-center gap-6 md:gap-5 text-center">
            <h1>
              <Image src={logoWhite} alt="Hampton Roads DevFest 2027" class="w-[200px] md:w-[300px] h-auto" width={300} height={225} loading="eager" fetchpriority="high" />
            </h1>
            <div class="flex flex-col items-center gap-2">
              <p class="text-[32px] md:text-[48px] font-bold leading-tight">Built in the 757</p>
              <p class="bp-muted text-base md:text-lg">A one-day, single-track developer conference in Virginia Beach.</p>
            </div>
            <p class="text-[18px] md:text-[22px] font-semibold leading-[1.3]">
              <span class="block sm:inline">Friday, April 23, 2027<span class="hidden sm:inline"> · </span></span>
              <span class="block sm:inline">Zeiders American Dream Theater, Virginia Beach</span>
            </p>
            <a href="#signup" class="mt-2 px-8 py-3 btn-primary text-base">Join the list</a>
          </div>
        </div>
      </div>

      <!-- Landmark line art: under the button on mobile, a skyline row in the hero's bottom padding from md -->
      <LandmarkLineArt />
    </section>

    <!-- Mailing List Signup - primary CTA -->
    <section id="signup" class="w-full py-12 md:py-16 px-4 md:px-8 border-t border-[var(--bp-line)] scroll-mt-4">
      {sponsors2026.length > 0 && (
        <div class="max-w-4xl mx-auto mb-10 flex flex-col items-center gap-4">
          <p class="bp-label">DevFest 2026 sponsors</p>
          <div class="flex flex-wrap md:flex-nowrap justify-center items-center gap-3">
            {sponsors2026.filter((sponsor) => sponsorLogos[sponsor.logo]).map((sponsor) => (
              <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="bp-plate px-3 py-2" title={sponsor.name}>
                <Image src={sponsorLogos[sponsor.logo]} alt={sponsor.name} class={sponsor.tier === 'platinum' ? 'h-14 w-auto object-contain' : 'h-8 w-auto object-contain'} />
              </a>
            ))}
          </div>
        </div>
      )}
      <div class="max-w-xl mx-auto p-8 md:p-10 bp-box text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-2">Be first to know</h2>
        <p class="bp-muted mb-6">Be first to hear when tickets go on sale and speakers are announced.</p>
        <form action="https://track.bentonow.com/forms/57d9b8196b2b704a30da5ac245bf2cfe/$subscribeHRDevFest?hardened=true" method="POST" enctype="multipart/form-data" class="max-w-md mx-auto">
          <input type="hidden" name="redirect" value="https://hrdevfest.org/thank-you">
          <input type="text" name="fields_first_name" aria-label="First name" placeholder="First Name (optional)" class="bp-input mb-3 px-4 py-3 text-base" />
          <input type="email" name="email" aria-label="Email address" placeholder="Email" required class="bp-input mb-4 px-4 py-3 text-base" />
          <button type="submit" class="px-8 py-3 btn-primary text-base">Join the list</button>
          <p class="text-xs bp-muted mt-4">By signing up, you agree to our <a href="https://revolutionva.org/privacy" target="_blank" rel="noopener" class="bp-link">Privacy Policy</a>.</p>
        </form>
        <p class="text-sm bp-muted mt-6">Add to calendar: <a href="/2027/hrdevfest-2027.ics" download class="bp-link font-bold">Apple / Outlook (.ics)</a> · <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text=Hampton+Roads+DevFest+2027&amp;dates=20270423/20270424&amp;location=Zeiders+American+Dream+Theater,+4509+Commerce+Street,+Virginia+Beach,+VA+23462&amp;details=Hampton+Roads+DevFest+2027.+Details+at+https://hrdevfest.org" target="_blank" rel="noopener" class="bp-link font-bold">Google Calendar</a></p>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="w-full py-10 lg:py-20 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-[1040px] mx-auto p-6 lg:p-8 bp-surface flex flex-col gap-2">
        <h2 class="text-[24px] lg:text-[32px] font-semibold leading-8 lg:leading-10 text-center lg:text-left">About</h2>
        <p class="text-base font-normal leading-relaxed">
          Hampton Roads DevFest is returning in 2027 to once again spotlight local speakers and celebrate the deep, diverse talent of our developer community.
          <br/><br/>
          Organized by RevolutionVA, a dedicated 501(c)(3) non-profit, our mission is to advance software development education throughout Virginia. Our passion for promoting learning and growth in technology is at the heart of DevFest.
          <br/><br/>
          We can't wait to bring the community back together to network, learn from top industry professionals, and recognize the extraordinary tech talent that thrives in Hampton Roads. Sign up above for 2027 event updates.
        </p>
      </div>
    </section>

    <!-- Sponsor 2027 CTA -->
    <section id="sponsors" class="w-full py-10 md:py-20 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-3xl mx-auto flex flex-col items-center gap-6 text-center">
        <h2 class="text-center text-[32px] font-bold leading-10">Sponsor DevFest 2027</h2>
        <p class="text-base font-normal leading-relaxed">
          Hampton Roads DevFest is powered by sponsors who believe in our local tech community. Put your company in front of the developers building tech in Hampton Roads.
        </p>
        <a href="/sponsor" class="px-8 py-3 btn-primary text-base">View the 2027 Sponsorship Prospectus</a>
        <a href="/2026#sponsors" class="bp-link text-base font-bold">See our 2026 sponsors →</a>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="w-full py-10 lg:py-20 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-[1040px] mx-auto flex flex-col items-center gap-4">
        <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10 mb-2">FAQ</h2>

        {faqItems.map((item, index) => (
          <div class="faq-item w-full p-6 md:p-8 bp-box flex flex-col gap-4" data-index={index}>
            <button class="faq-question w-full flex justify-between items-center gap-4 cursor-pointer">
              <span class="flex-1 text-base font-bold leading-relaxed text-left">{item.question}</span>
              <svg class="faq-icon w-[25px] h-[25px] transition-transform" viewBox="0 0 25 25" fill="none" aria-hidden="true">
                <path d="M6 9L12.5 16L19 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
              </svg>
            </button>
            <div class="faq-answer text-base font-normal leading-relaxed bp-prose">
              {item.answer}
            </div>
          </div>
        ))}

        <a href="/faq" class="mt-2 px-6 py-2 btn-secondary text-sm">More FAQ</a>
      </div>
    </section>

    <!-- Venue Section -->
    <section id="venue" class="w-full flex flex-col lg:flex-row border-t border-[var(--bp-line)]">
      <!-- Venue info -->
      <div class="w-full lg:flex-1 py-10 lg:py-0 flex flex-col justify-center">
        <div class="w-full px-8 md:px-10">
          <p class="bp-label mb-2">Location</p>
          <h2 class="text-[32px] md:text-[40px] font-bold mb-4">Venue</h2>
          <p class="text-base md:text-2xl font-normal leading-relaxed md:leading-[30px]">
            Zeiders American Dream Theater<br/>
            4509 Commerce Street,<br/>
            Virginia Beach, VA 23462
          </p>
          <p class="bp-muted text-sm md:text-base font-normal italic mt-3">
            Our confirmed venue for Hampton Roads DevFest 2027.
          </p>
        </div>
      </div>

      <!-- Map -->
      <div class="w-full lg:flex-1 border-t lg:border-t-0 lg:border-l border-[var(--bp-line)]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d798.259579003214!2d-76.13574812406885!3d36.84155839379043!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89ba959f7490b19d%3A0x2946d6df48a4c3ba!2sZeiders%20American%20Dream%20Theater!5e0!3m2!1sen!2sus!4v1708011885150!5m2!1sen!2sus"
          width="100%"
          height="530"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-[283px] md:h-[530px]"></iframe>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="w-full py-10 lg:py-20 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto flex flex-col gap-6">
        <!-- Header -->
        <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10 text-center md:text-left">Testimonials</h2>

        <!-- Cards: Mobile/Tablet stacked, Desktop row -->
        <div class="flex flex-col lg:flex-row gap-8">
          {testimonials.map((testimonial) => (
            <div class="w-full lg:flex-1 p-6 bp-box flex flex-col md:flex-row lg:flex-col items-center gap-4">
              {testimonial.image.startsWith('http') ? (
                <img
                  src={testimonial.image}
                  alt={testimonial.name}
                  class="bp-photo w-[100px] h-[100px] rounded-full object-cover shrink-0"
                  width="100"
                  height="100"
                />
              ) : (
                <Image
                  src={testimonialImages[testimonial.image]}
                  alt={testimonial.name}
                  class="bp-photo w-[100px] h-[100px] rounded-full object-cover shrink-0"
                  width={100}
                  height={100}
                />
              )}
              <div class="w-full flex flex-col gap-4">
                <div class="pb-4 flex flex-col justify-center items-center md:items-start lg:items-center gap-2.5">
                  <p class="text-base font-normal leading-relaxed">
                    "{testimonial.quote}"
                  </p>
                  <div class="w-full flex flex-col gap-1">
                    <p class="bp-label">{testimonial.name}</p>
                    {testimonial.role && <p class="text-sm bp-muted">{testimonial.role}</p>}
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  {testimonial.linkedin && (
                    <a href={testimonial.linkedin} target="_blank" rel="noopener noreferrer" class="bp-link flex items-center gap-1">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                      <span class="text-sm font-medium">LinkedIn</span>
                    </a>
                  )}
                  {testimonial.twitter && (
                    <a href={testimonial.twitter} target="_blank" rel="noopener noreferrer" class="bp-link flex items-center gap-1">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                      </svg>
                      <span class="text-sm font-medium">Twitter</span>
                    </a>
                  )}
                  {testimonial.bluesky && (
                    <a href={testimonial.bluesky} target="_blank" rel="noopener noreferrer" class="bp-link flex items-center gap-1">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.038.415-.055-.265.2-.532.34-.796.531-2.32 1.673-2.788 2.927-1.706 4.649 1.082 1.723 4.883 1.08 5.67-.542.364-.75.28-1.68.28-2.722 0 1.042-.084 1.972.28 2.722.787 1.622 4.588 2.265 5.67.542 1.082-1.722.614-2.976-1.706-4.649-.264-.191-.531-.331-.796-.531.14.017.279.035.415.055 2.67.296 5.568-.628 6.383-3.364.246-.829.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
                      </svg>
                      <span class="text-sm font-medium">Bluesky</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Final Signup Prompt -->
    <section id="event-date" class="w-full py-12 md:py-16 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-3xl mx-auto flex flex-col items-center gap-4 text-center">
        <Image src={logoWhite} alt="Hampton Roads DevFest" class="w-[140px] md:w-[180px] h-auto" width={180} height={135} />
        <p class="text-base md:text-lg font-semibold leading-relaxed">Friday, April 23, 2027 · Zeiders American Dream Theater, Virginia Beach</p>
        <a href="#signup" class="mt-2 px-8 py-3 btn-primary text-base">Join the list</a>
        <p class="text-sm bp-muted">Add to calendar: <a href="/2027/hrdevfest-2027.ics" download class="bp-link font-bold">Apple / Outlook (.ics)</a> · <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text=Hampton+Roads+DevFest+2027&amp;dates=20270423/20270424&amp;location=Zeiders+American+Dream+Theater,+4509+Commerce+Street,+Virginia+Beach,+VA+23462&amp;details=Hampton+Roads+DevFest+2027.+Details+at+https://hrdevfest.org" target="_blank" rel="noopener" class="bp-link font-bold">Google Calendar</a></p>
      </div>
    </section>

    <!-- Shop Merch Section -->
    <section id="merch" class="py-16 md:py-24 border-t border-[var(--bp-line)]">
      <div class="container mx-auto px-4 md:px-8">
        <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
          <!-- Content -->
          <div class="flex-1 text-center lg:text-left">
            <h2 class="text-2xl md:text-3xl font-bold mb-6">Shop Merch</h2>
            <p class="text-xl md:text-2xl mb-4">
              Support RevolutionVA with official merchandise
            </p>
            <p class="bp-muted mb-8 max-w-md mx-auto lg:mx-0">
              All purchases support the 501(c)(3) <a href="https://revolutionva.org" target="_blank" rel="noopener noreferrer" class="bp-link font-medium">RevolutionVA</a> and future community events like Hampton Roads DevFest.
            </p>
            <a
              href="https://www.bonfire.com/store/revolutionva/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 md:px-8 py-3 md:py-4 btn-secondary text-base"
            >
              Shop Now
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
          <!-- Image (desktop only) -->
          <div class="flex-1 hidden lg:block">
            <img
              src="https://c.bonfireassets.com/thumb/store/7c612bf7-1ff6-47c9-95d3-efd29907bed1/a91b760e/"
              alt="RevolutionVA community event"
              class="bp-photo w-full max-w-lg mx-auto object-cover"
