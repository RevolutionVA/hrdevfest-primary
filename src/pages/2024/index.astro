---
import { getEntry } from 'astro:content';
import { Image } from "astro:assets";
import YearLayout from "../../themes/archive/layouts/YearLayout.astro";

import photo1 from "../../assets/2024-photos/2024-05-31 08.30.41.jpg";
import photo2 from "../../assets/2024-photos/2024-05-31 09.48.48.jpg";
import photo3 from "../../assets/2024-photos/2024-05-31 12.04.00.jpg";
import photo4 from "../../assets/2024-photos/2024-05-31 12.11.53.jpg";
import photo5 from "../../assets/2024-photos/2024-05-31 14.13.46.jpg";

const event = await getEntry('events', '2024/event');
if (!event) {
  throw new Error('Event data not found for 2024');
}
const eventData = event.data;

const photoAssets: Record<string, ImageMetadata> = {
  "2024-05-31 08.30.41.jpg": photo1,
  "2024-05-31 09.48.48.jpg": photo2,
  "2024-05-31 12.04.00.jpg": photo3,
  "2024-05-31 12.11.53.jpg": photo4,
  "2024-05-31 14.13.46.jpg": photo5,
};

function getSocialIcon(type: string): string {
  const icons: Record<string, string> = {
    twitter: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
    linkedin: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
    github: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>',
    website: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>',
    bluesky: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg>',
    mastodon: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.668 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/></svg>',
  };
  return icons[type] || icons.website;
}
---

<YearLayout title={eventData.title} description={eventData.description} year={2024}>
  <!-- Header Section -->
  <section class="w-full py-12 md:py-16 px-4 md:px-8">
    <div class="max-w-4xl mx-auto flex flex-col items-center gap-2 text-center">
      <h1 class="text-[32px] md:text-[40px] font-bold leading-tight">{eventData.title}</h1>
      <p class="bp-mono text-base md:text-lg">{eventData.dateFormatted}</p>
      {eventData.venue && (
        <p class="bp-muted">
          {eventData.venue.name} &bull; {eventData.venue.city}, {eventData.venue.state}
        </p>
      )}
      <p class="text-base leading-relaxed mt-4 max-w-2xl">{eventData.description}</p>
    </div>
  </section>

  <!-- Photo Gallery -->
  {eventData.photos && eventData.photos.length > 0 && (
    <section class="w-full py-10 lg:py-16 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-[24px] md:text-[32px] font-bold text-center mb-8">Event Photos</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {eventData.photos.map((photo, index) => (
            photoAssets[photo.src] && (
              <div class="photo-card bp-box cursor-pointer" data-index={index} role="button" tabindex="0">
                <Image
                  src={photoAssets[photo.src]}
                  alt={photo.caption}
                  class="w-full h-48 object-cover border-b border-[var(--bp-line)]"
                />
                <div class="p-3">
                  <p class="text-sm">{photo.caption}</p>
                </div>
              </div>
            )
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Schedule Section (single-track) -->
  <section class="w-full py-10 lg:py-16 px-4 md:px-8 border-t border-[var(--bp-line)]">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-[24px] md:text-[32px] font-bold text-center mb-8">Schedule</h2>
      <p class="text-center mb-6">
        All sessions took place in the Main Auditorium on {eventData.dateFormatted}.
      </p>
      <table class="bp-table">
        <thead>
          <tr>
            <th scope="col" class="w-[6.5rem] md:w-[11rem]">Time</th>
            <th scope="col">Session</th>
          </tr>
        </thead>
        <tbody>
          {eventData.schedule.map((item) => (
            <tr>
              <td class="bp-mono text-sm">{item.time}</td>
              <td>
                <p class="font-semibold">{item.title}</p>
                {item.description && (
                  <p class="text-sm bp-muted mt-1">{item.description}</p>
                )}
                {item.abstract && (
                  <p class="text-sm mt-2 whitespace-pre-line">{item.abstract}</p>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Speakers Section -->
  <section class="w-full py-10 lg:py-16 px-4 md:px-8 border-t border-[var(--bp-line)]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-[24px] md:text-[32px] font-bold text-center mb-8">Speakers</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {eventData.speakers.map((speaker) => {
          const speakerId = speaker.name.toLowerCase().replace(/\s+/g, '-');
          return (
            <div class="bp-box p-6">
              <div class="flex items-start gap-4">
                {speaker.image ? (
                  <img
                    src={speaker.image}
                    alt={speaker.name}
                    class="bp-photo w-20 h-20 rounded-full object-cover shrink-0"
                    width="80"
                    height="80"
                  />
                ) : (
                  <div class="w-20 h-20 rounded-full border border-[var(--bp-line)] shrink-0 flex items-center justify-center bp-mono text-xl" aria-hidden="true">
                    {speaker.name.split(' ').map(n => n[0]).join('').slice(0, 2)}
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-semibold">{speaker.name}</h3>
                  {speaker.role && (
                    <p class="text-sm bp-muted">{speaker.role}</p>
                  )}
                  {speaker.sessionTitle && (
                    <p class="text-sm bp-muted italic mt-1">{speaker.sessionTitle}</p>
                  )}

                  {/* Social Links */}
                  {(speaker.twitter || speaker.linkedin || speaker.github || speaker.website || speaker.bluesky || speaker.mastodon) && (
                    <div class="flex gap-3 mt-2">
                      {speaker.twitter && (
                        <a href={speaker.twitter} target="_blank" rel="noopener noreferrer" class="bp-nav-link" title="Twitter/X" aria-label="Twitter/X" set:html={getSocialIcon('twitter')} />
                      )}
                      {speaker.linkedin && (
                        <a href={speaker.linkedin} target="_blank" rel="noopener noreferrer" class="bp-nav-link" title="LinkedIn" aria-label="LinkedIn" set:html={getSocialIcon('linkedin')} />
                      )}
                      {speaker.github && (
                        <a href={speaker.github} target="_blank" rel="noopener noreferrer" class="bp-nav-link" title="GitHub" aria-label="GitHub" set:html={getSocialIcon('github')} />
                      )}
                      {speaker.bluesky && (
                        <a href={speaker.bluesky} target="_blank" rel="noopener noreferrer" class="bp-nav-link" title="Bluesky" aria-label="Bluesky" set:html={getSocialIcon('bluesky')} />
                      )}
                      {speaker.mastodon && (
                        <a href={speaker.mastodon} target="_blank" rel="noopener noreferrer" class="bp-nav-link" title="Mastodon" aria-label="Mastodon" set:html={getSocialIcon('mastodon')} />
                      )}
                      {speaker.website && (
                        <a href={speaker.website} target="_blank" rel="noopener noreferrer" class="bp-nav-link" title="Website" aria-label="Website" set:html={getSocialIcon('website')} />
                      )}
                    </div>
                  )}
                </div>
              </div>

              {/* Bio with expand/collapse */}
              {speaker.bio && (
                <div class="relative mt-4">
                  <input type="checkbox" id={`bio-${speakerId}`} class="peer sr-only" />
                  <p class="text-sm leading-relaxed peer-checked:line-clamp-none line-clamp-3">{speaker.bio}</p>
                  <label
                    for={`bio-${speakerId}`}
                    class="bp-link text-sm cursor-pointer mt-1 inline-block peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-[var(--bp-ink)] peer-checked:before:content-['Show_less'] before:content-['Read_more...']"
                  ></label>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Photo Modal -->
  <div id="photo-modal" class="fixed inset-0 z-[100] bg-[var(--bp-paper-deep)] hidden items-center justify-center p-4">
    <button id="modal-close" class="absolute top-4 right-4 bp-nav-link text-4xl font-light" aria-label="Close">&times;</button>
    <button id="modal-prev" class="absolute left-4 top-1/2 -translate-y-1/2 bp-nav-link text-4xl font-light p-2" aria-label="Previous">&larr;</button>
    <button id="modal-next" class="absolute right-4 top-1/2 -translate-y-1/2 bp-nav-link text-4xl font-light p-2" aria-label="Next">&rarr;</button>
    <div class="max-w-5xl max-h-[90vh] flex flex-col items-center">
      <img id="modal-image" src="" alt="" class="bp-photo max-w-full max-h-[80vh] object-contain" />
      <p id="modal-caption" class="text-center mt-4 text-lg"></p>
    </div>
  </div>

  <!-- Back to Events -->
  <section class="w-full py-8 px-4 md:px-8 border-t border-[var(--bp-line)]">
    <div class="max-w-4xl mx-auto text-center">
      <a href="/events" class="bp-link font-bold">
        &larr; View All Past Events
      </a>
    </div>
  </section>
</YearLayout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('photo-modal');
    const modalImage = document.getElementById('modal-image') as HTMLImageElement;
    const modalCaption = document.getElementById('modal-caption');
    const modalClose = document.getElementById('modal-close');
    const modalPrev = document.getElementById('modal-prev');
    const modalNext = document.getElementById('modal-next');
    const photoCards = document.querySelectorAll('.photo-card');

    const photos: { src: string; caption: string }[] = [];
    photoCards.forEach((card) => {
      const img = card.querySelector('img') as HTMLImageElement;
      const caption = card.querySelector('p')?.textContent || '';
      if (img) {
        photos.push({ src: img.src, caption });
      }
    });

    let currentIndex = 0;

    function showPhoto(index: number) {
      if (photos[index]) {
        currentIndex = index;
        if (modalImage) modalImage.src = photos[index].src;
        if (modalCaption) modalCaption.textContent = photos[index].caption;
      }
    }

    function openModal(index: number) {
      showPhoto(index);
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }

    photoCards.forEach((card) => {
      const index = parseInt((card as HTMLElement).dataset.index || '0');
      card.addEventListener('click', () => openModal(index));
      // Cards are role="button", so Enter and Space open them too
      card.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'Enter' || key === ' ') {
          e.preventDefault();
          openModal(index);
        }
      });
    });

    modalClose?.addEventListener('click', closeModal);

    modalPrev?.addEventListener('click', () => {
      const newIndex = currentIndex > 0 ? currentIndex - 1 : photos.length - 1;
      showPhoto(newIndex);
    });

    modalNext?.addEventListener('click', () => {
      const newIndex = currentIndex < photos.length - 1 ? currentIndex + 1 : 0;
      showPhoto(newIndex);
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (modal?.classList.contains('hidden')) return;

      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft') {
        const newIndex = currentIndex > 0 ? currentIndex - 1 : photos.length - 1;
        showPhoto(newIndex);
      }
      if (e.key === 'ArrowRight') {
        const newIndex = currentIndex < photos.length - 1 ? currentIndex + 1 : 0;
        showPhoto(newIndex);
      }
    });
  });
</script>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .peer:checked ~ .line-clamp-3 {
    -webkit-line-clamp: unset;
  }
</style>
