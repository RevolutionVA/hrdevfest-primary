---
import { getEntry } from 'astro:content';
import { Image } from "astro:assets";
import YearLayout from "../../themes/2024/layouts/YearLayout.astro";
import headerDots from "../../assets/dots/header_dots.svg";
import header2024 from "../../assets/header_2024.png";

import photo1 from "../../assets/2024-photos/2024-05-31 08.30.41.jpg";
import photo2 from "../../assets/2024-photos/2024-05-31 09.48.48.jpg";
import photo3 from "../../assets/2024-photos/2024-05-31 12.04.00.jpg";
import photo4 from "../../assets/2024-photos/2024-05-31 12.11.53.jpg";
import photo5 from "../../assets/2024-photos/2024-05-31 14.13.46.jpg";

const event = await getEntry('events', '2024/event');
if (!event) {
  throw new Error('Event data not found for 2024');
}
const eventData = event.data;

const photoAssets: Record<string, ImageMetadata> = {
  "2024-05-31 08.30.41.jpg": photo1,
  "2024-05-31 09.48.48.jpg": photo2,
  "2024-05-31 12.04.00.jpg": photo3,
  "2024-05-31 12.11.53.jpg": photo4,
  "2024-05-31 14.13.46.jpg": photo5,
};
---

<YearLayout title={eventData.title} description={eventData.description}>
  <!-- Header Section with Event Highlights and 2024 Image -->
  <section class="w-full bg-white relative overflow-hidden">
    <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

    <div class="relative z-10 flex flex-col items-center py-10 px-8 lg:px-[280px] md:px-8">
      <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center mb-10">
        <h1 class="text-black text-[24px] md:text-[32px] font-bold leading-8 md:leading-10">
          {eventData.tagline}
        </h1>
        <p class="text-black text-base font-normal leading-relaxed">
          {eventData.description}
        </p>
      </div>

      <Image
        src={header2024}
        alt="2024"
        class="w-[250px] md:w-[500px] lg:w-[763px] h-auto"
      />
    </div>
  </section>

  <!-- Photo Gallery -->
  <section class="w-full bg-gray-100 py-10 px-8 lg:px-10">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {eventData.photos.map((photo, index) => (
          <div class="flex flex-col rounded-[10px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.1)] overflow-hidden photo-card" data-index={index}>
            <div class="h-[160px] lg:h-[256px] relative rounded-tl-[40px] rounded-tr-[10px] overflow-hidden">
              {photoAssets[photo.src] && (
                <Image
                  src={photoAssets[photo.src]}
                  alt={photo.caption}
                  class="absolute inset-0 w-full h-full object-cover"
                />
              )}
            </div>
            <div class="bg-white p-4 rounded-bl-[10px] rounded-br-[40px]">
              <p class="text-black text-sm font-normal leading-6">
                {photo.caption}
                <span class="text-[#3361c9] text-xs ml-1">(</span><button class="text-[#3361c9] text-xs underline enlarge-btn" data-index={index}>Enlarge Photo</button><span class="text-[#3361c9] text-xs">)</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2024 Schedule Section -->
  <section class="w-full py-10 px-8 bg-white relative overflow-hidden">
    <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

    <div class="max-w-4xl mx-auto flex flex-col gap-6 relative z-10">
      <h2 class="text-[24px] md:text-[32px] font-bold text-black text-center">
        2024 Schedule
      </h2>
      <p class="text-black text-base font-normal leading-relaxed text-center">
        All sessions took place in the Main Auditorium on {eventData.dateFormatted}.
      </p>
      <div class="flex flex-col gap-4">
        {eventData.schedule.map((item) => (
          <div class="bg-[#F3F4F6] p-6 card-asymmetric flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              {item.time}
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">{item.title}</p>
              {item.description && (
                <p class="text-sm text-gray-600">{item.description}</p>
              )}
              {item.abstract && (
                <p class="text-sm text-gray-700 mt-2">{item.abstract}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2024 Speakers Section -->
  <section class="w-full py-10 px-8 bg-[#F3F4F6]">
    <div class="max-w-7xl mx-auto flex flex-col gap-10">
      <div class="flex flex-col gap-2 text-center lg:px-[280px]">
        <h2 class="text-black text-[24px] md:text-[32px] font-semibold md:font-bold leading-8 md:leading-10">
          2024 Speakers
        </h2>
        <p class="text-black text-base font-normal leading-relaxed">
          Meet the amazing speakers who shared their knowledge at Hampton Roads DevFest 2024.
        </p>
      </div>

      <div class="flex flex-col lg:grid lg:grid-cols-3 gap-8">
        {eventData.speakers.map((speaker) => (
          <div class="bg-white p-6 md:p-8 card-asymmetric card-shadow flex flex-col md:flex-row lg:flex-col gap-4 items-center">
            <img
              src={speaker.image}
              alt={speaker.name}
              class="w-[100px] h-[100px] rounded-full object-cover shrink-0"
            />
            <div class="flex flex-col gap-4 w-full">
              <p class="text-[24px] font-semibold text-black text-center md:text-left lg:text-center">{speaker.name}</p>
              {speaker.role && (
                <p class="text-sm text-gray-600 text-center md:text-left lg:text-center">{speaker.role}</p>
              )}
              <p class="text-base font-normal text-black leading-relaxed">
                {speaker.bio}
              </p>
              <div class="flex items-center gap-4 justify-center md:justify-start lg:justify-center">
                {speaker.linkedin && (
                  <a href={speaker.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0077B5] hover:opacity-80">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    <span class="text-sm font-medium">LinkedIn</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo Modal -->
  <div id="photo-modal" class="fixed inset-0 z-[100] bg-black/80 hidden items-center justify-center p-4">
    <button id="modal-close" class="absolute top-4 right-4 text-white text-4xl font-light hover:opacity-80">&times;</button>
    <button id="modal-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl font-light hover:opacity-80 p-2">&larr;</button>
    <button id="modal-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-4xl font-light hover:opacity-80 p-2">&rarr;</button>
    <div class="max-w-5xl max-h-[90vh] flex flex-col items-center">
      <img id="modal-image" src="" alt="" class="max-w-full max-h-[80vh] object-contain" />
      <p id="modal-caption" class="text-white text-center mt-4 text-lg"></p>
    </div>
  </div>
</YearLayout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('photo-modal');
    const modalImage = document.getElementById('modal-image') as HTMLImageElement;
    const modalCaption = document.getElementById('modal-caption');
    const modalClose = document.getElementById('modal-close');
    const modalPrev = document.getElementById('modal-prev');
    const modalNext = document.getElementById('modal-next');
    const enlargeBtns = document.querySelectorAll('.enlarge-btn');
    const photoCards = document.querySelectorAll('.photo-card');

    const photos: { src: string; caption: string }[] = [];
    photoCards.forEach((card) => {
      const img = card.querySelector('img') as HTMLImageElement;
      const caption = card.querySelector('p')?.textContent?.split('(')[0].trim() || '';
      if (img) {
        photos.push({ src: img.src, caption });
      }
    });

    let currentIndex = 0;

    function showPhoto(index: number) {
      if (photos[index]) {
        currentIndex = index;
        if (modalImage) modalImage.src = photos[index].src;
        if (modalCaption) modalCaption.textContent = photos[index].caption;
      }
    }

    function openModal(index: number) {
      showPhoto(index);
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }

    enlargeBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((btn as HTMLElement).dataset.index || '0');
        openModal(index);
      });
    });

    photoCards.forEach((card) => {
      const img = card.querySelector('.relative');
      img?.addEventListener('click', () => {
        const index = parseInt((card as HTMLElement).dataset.index || '0');
        openModal(index);
      });
    });

    modalClose?.addEventListener('click', closeModal);

    modalPrev?.addEventListener('click', () => {
      const newIndex = currentIndex > 0 ? currentIndex - 1 : photos.length - 1;
      showPhoto(newIndex);
    });

    modalNext?.addEventListener('click', () => {
      const newIndex = currentIndex < photos.length - 1 ? currentIndex + 1 : 0;
      showPhoto(newIndex);
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (modal?.classList.contains('hidden')) return;

      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft') {
        const newIndex = currentIndex > 0 ? currentIndex - 1 : photos.length - 1;
        showPhoto(newIndex);
      }
      if (e.key === 'ArrowRight') {
        const newIndex = currentIndex < photos.length - 1 ? currentIndex + 1 : 0;
        showPhoto(newIndex);
      }
    });
  });
</script>

<style>
  .photo-card .relative {
    cursor: pointer;
  }
  .photo-card .relative:hover {
    opacity: 0.9;
  }
</style>
