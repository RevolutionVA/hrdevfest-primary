          <form id="sponsor-hold-form" action={BENTO_SPONSOR_FORM_ACTION} method="POST" enctype="multipart/form-data" class="bp-box p-5 md:p-8 flex flex-col gap-4">
            <input type="hidden" name="redirect" value={SPONSOR_THANK_YOU_URL} data-redirect-path="/sponsor/thank-you" />
