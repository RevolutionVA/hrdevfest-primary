---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import CanonicalLink from "../components/CanonicalLink.astro";
import PastYearsNav from "../components/PastYearsNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { sheetFor } from "../data/titleBlock";
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";

const pageTitle = "Sponsor | Hampton Roads DevFest 2027";
const pageDescription = "Sponsorship prospectus for Hampton Roads DevFest 2027, Friday, April 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA. Presented by RevolutionVA, a 501(c)(3) nonprofit.";

interface ScheduleItem {
  time: string;
  what: string;
  sponsorTime?: boolean; // a moment sponsors are on, at a table, or being named
}

const schedule: ScheduleItem[] = [
  { time: "7:30", what: "Building opens, sponsor setup", sponsorTime: true },
  { time: "8:00", what: "Registration and networking at the sponsor tables", sponsorTime: true },
  { time: "9:00", what: "Opening, with the Presenting sponsor's 15-minute talk", sponsorTime: true },
  { time: "9:30", what: "Talk" },
  { time: "10:15", what: "Talk" },
  { time: "11:00", what: "Networking break at the sponsor tables", sponsorTime: true },
  { time: "11:30", what: "Talk" },
  { time: "12:15", what: "Lunch in the Studio", sponsorTime: true },
  { time: "12:45", what: "Scholar Meetup in the Studio", sponsorTime: true },
  { time: "1:30", what: "Main Stage sponsor's 15-minute talk", sponsorTime: true },
  { time: "1:45", what: "Talk" },
  { time: "2:30", what: "Networking break at the sponsor tables", sponsorTime: true },
  { time: "3:00", what: "Talk" },
  { time: "3:45", what: "Talk" },
  { time: "4:30", what: "Closing, then networking and sponsor teardown (building closes at 6:00)", sponsorTime: true },
];

interface GlanceRow {
  mark: string; // callout mark, keyed to the tier detail card
  detail: string; // id of the tier detail card
  tier: string;
  price: string;
  available: string;
  table: string;
  talk: boolean;
  tickets: string;
  social: string;
  report: boolean;
}

const glance: GlanceRow[] = [
  { mark: "P", detail: "presenting", tier: "Presenting", price: "$10,000", available: "1", table: "Yes", talk: true, tickets: "12", social: "4", report: true },
  { mark: "M", detail: "main-stage", tier: "Main Stage", price: "$5,000", available: "1", table: "Yes", talk: true, tickets: "10", social: "3", report: true },
  { mark: "S", detail: "studio", tier: "Studio", price: "$3,500", available: "1", table: "Yes (in the Studio)", talk: false, tickets: "6", social: "3", report: true },
  { mark: "VS", detail: "scholarship", tier: "Veteran Scholarship", price: "$2,500", available: "3", table: "Yes", talk: false, tickets: "4", social: "2", report: true },
  { mark: "SS", detail: "scholarship", tier: "Student Scholarship", price: "$2,500", available: "3", table: "Yes", talk: false, tickets: "4", social: "2", report: true },
  { mark: "J", detail: "jobs-board", tier: "Jobs Board", price: "$1,000", available: "Open", table: "", talk: false, tickets: "2", social: "1", report: false },
  { mark: "C", detail: "community", tier: "Community", price: "$500", available: "Open", table: "", talk: false, tickets: "1", social: "Group thank-you", report: false },
];

interface Tier {
  id: string;
  mark: string;
  name: string;
  price: string;
  available?: string;
  tagline?: string;
  lead?: string;
  benefits: string[];
  quickPath?: boolean;
}

const tiers: Tier[] = [
  {
    id: "presenting",
    mark: "P",
    name: "Presenting Sponsor",
    price: "$10,000",
    available: "1 available",
    tagline: "Your name on the event: \"Hampton Roads DevFest presented by [Your Company].\"",
    benefits: [
      "A 15-minute talk at the 9:00 opening, when the whole room is in their seats. The talk can include a product demo, or it can be a welcome from a public official.",
      "Top logo placement on the website, slides, and signage",
      "A sponsor table",
      "12 tickets",
      "A feature in the 757tech newsletter",
      "At least 4 sponsor posts on 757tech's social channels: an announcement, a reminder, a day-of post, and a thank-you",
      "Year-round Pop-up Meetup naming: your company names every quarterly 757tech Pop-up Meetup for 12 months, with 2 minutes at the start of each",
      "Optional spot on the Who's hiring board, free if you want it, in print at the event and on the DevFest site",
      "The post-event report",
    ],
  },
  {
    id: "main-stage",
    mark: "M",
    name: "Main Stage Sponsor",
    price: "$5,000",
    available: "1 available",
    tagline: "Your name on the room where every talk happens: \"The [Your Company] Main Stage.\"",
    benefits: [
      "A 15-minute talk at 1:30, right after lunch. The talk can include a product demo.",
      "Main Stage naming on signage, slides, and the schedule",
      "A sponsor table",
      "10 tickets",
      "A feature in the 757tech newsletter",
      "At least 3 sponsor posts on 757tech's social channels",
      "Year-round Pop-up Meetup naming (how this is shared with the Presenting sponsor: details coming soon)",
      "Optional spot on the Who's hiring board, free if you want it, in print at the event and on the DevFest site",
      "The post-event report",
    ],
  },
  {
    id: "studio",
    mark: "S",
    name: "Studio Sponsor",
    price: "$3,500",
    available: "1 available",
    tagline: "The room where everyone eats, hangs out, and talks: \"The [Your Company] Studio.\"",
    benefits: [
      "Naming of the Studio, the lunch and hangout room",
      "Signage in the Studio",
      "Your sponsor table inside the Studio",
      "6 tickets",
      "A mention in the 757tech newsletter",
      "At least 3 sponsor posts on 757tech's social channels",
      "Optional spot on the Who's hiring board, free if you want it, in print at the event and on the DevFest site",
      "The post-event report",
    ],
  },
  {
    id: "scholarship",
    mark: "VS / SS",
    name: "Veteran Scholarship and Student Scholarship Sponsors",
    price: "$2,500 each",
    available: "3 of each available",
    tagline: "Your sponsorship funds scholarship seats.",
    lead: "Every dollar of the Scholarship tier funds lottery seats, named for your company as a Veteran Scholarship or a Student Scholarship. Your 10 seats are held for the lottery, even if we sell out, and we hand them out the week of the event. Veteran Scholarship seats are drawn from veteran entries, and Student Scholarship seats are drawn from student entries. Scholars never need to show proof of need.",
    benefits: [
      "Funds 10 named scholarship seats, held for our lottery even if we sell out and handed out the week of the event",
      "Meet your scholars at the Scholar Meetup (12:45, in the Studio). The meetup is optional for scholars.",
      "A sponsor table",
      "4 tickets for your team",
      "A mention in the 757tech newsletter",
      "At least 2 sponsor posts on 757tech's social channels: an announcement and a thank-you to your company",
      "Scholars are never named or labeled, in posts, on badges, or at the event",
      "Optional spot on the Who's hiring board, free if you want it, in print at the event and on the DevFest site",
      "The post-event report, including scholars who attended versus scholars funded",
    ],
  },
  {
    id: "jobs-board",
    mark: "J",
    name: "Jobs Board Sponsor",
    price: "$1,000",
    available: "open",
    benefits: [
      "Your logo, 2 to 3 open role titles, and a QR code to your careers page on the printed Who's hiring board near registration",
      "A listing in the Who's hiring section of the DevFest site, live from when you sign until about 30 days after the event",
      "You write your own listings, for example clearance required, remote, or internship. Every role you list must include an expected salary range.",
      "A mention in the post-event recap email",
      "One named contact from your team for attendees to reach out to",
      "Your logo on the website and slides",
      "A sponsor post on 757tech's social channels",
      "2 tickets",
      "A one-page recap after the event: total attendance, the \"Looking for work\" ribbon count, role mix, and top tech stacks",
      "No sponsor table and no stage time. We don't collect resumes.",
    ],
  },
  {
    id: "community",
    mark: "C",
    name: "Community Sponsor",
    price: "$500",
    available: "open",
    benefits: [
      "Your logo on the website and slides",
      "1 ticket",
      "Included in a group thank-you post on 757tech's social channels",
    ],
    quickPath: true,
  },
];

const reportItems: string[] = [
  "Attendance and check-ins",
  "The mix of attendee roles and seniority",
  "Counts for all four opt-in ribbons: Hiring, Looking for work, Internship, and Open to contract work (counts only, never names)",
  "Counts by region, veterans, students, and tech stacks and languages (proposed)",
  "Whether attendees are military or transitioning from the military, which we ask at registration. The question is optional, and we only ever report it to sponsors as totals, never names",
  "Scholars who attended versus scholars funded (proposed)",
  "Newsletter and social reach",
  "Photos of your table or signage",
];

interface Commitment {
  title: string;
  body: string;
}

const commitments: Commitment[] = [
  {
    title: "Commit by December 15, 2026. Pay in January.",
    body: "Commit to your sponsorship by December 15, 2026 so we can include you in signage, slides, and announcements. Your invoice and payment can come in January 2027. A written intent to sponsor by December 15, 2026 counts as committed, with your purchase order or payment in January. Scholarship tiers are assigned in order of written intent and held for 30 days from your written intent to sponsor.",
  },
  {
    title: "Attendee privacy comes first.",
    body: "Sponsor email opt-in for attendees is off by default. When attendees opt in, we include your message in our one post-event sponsor email, and attendee contacts are never handed to sponsors. After the event, we send one email to attendees who opted in, covering all sponsors. We never sell attendee lists, and we never scan badges.",
  },
  {
    title: "A one-page recap for Jobs Board sponsors.",
    body: "After DevFest, Jobs Board sponsors get a one-page recap covering total attendance, the \"Looking for work\" ribbon count, the mix of attendee roles, and the top tech stacks attendees work with.",
  },
  {
    title: "A Who's hiring board for sponsor roles.",
    body: "Jobs Board sponsors get a listing on the Who's hiring board, and Scholarship tier sponsors and up can opt in for free. The board is printed near registration and posted on the DevFest site. Full-time, internship, apprenticeship, contract, and freelance roles are all welcome. Sponsors write their own listings, for example clearance required, remote, or internship, and every role listed must include an expected salary range. Roles from recruiting agencies are clearly labeled as agency roles. We don't collect resumes.",
  },
  {
    title: "Opt-in ribbons.",
    body: "Attendees can choose to wear Hiring, Looking for work, Internship, or Open to contract work ribbons. The post-event report includes counts for each ribbon, never names.",
  },
  {
    title: "A vendor packet sent with the prospectus.",
    body: "Our W-9, a certificate of insurance, and our 501(c)(3) letter are sent with the prospectus.",
  },
  {
    title: "Simple payment (proposed).",
    body: "Invoices go out by January. If you need a quote before the invoice for a purchase order, we'll send one. Public agencies can pay by purchase order.",
  },
  {
    title: "In-kind support is itemized separately (proposed).",
    body: "In-kind support, such as venue or Pop-up Meetup hosting, is itemized separately from cash sponsorship. In-kind support with an agreed written value counts toward Community recognition.",
  },
  {
    title: "Talks are never tied to sponsorship.",
    body: "Our call for speakers is open to sponsor engineers, and every talk is chosen on its own merits. Talks are never tied to sponsorship tier.",
  },
  {
    title: "No access to elected officials.",
    body: "Sponsorship buys no access to elected officials.",
  },
];

// The "Past years" menu sits between these two groups
const navLinksBeforeYears = [
  { href: "/#about", label: "About" },
  { href: "/#venue", label: "Venue" },
  { href: "/#testimonials", label: "Testimonials" },
];
const navLinksAfterYears = [
  { href: "/faq", label: "FAQ" },
  { href: "/sponsor", label: "Sponsor" },
];

// Sheet index. The footer title block calls this page sheet N of the set,
// so each section is numbered N.1, N.2, ... like sheets in a drawing set.
const sheet = sheetFor("/sponsor");
const sheetNo = sheet ? sheet.split(" ")[0] : "2";
const sections = [
  { id: "why-sponsor", title: "Why sponsor DevFest" },
  { id: "the-day", title: "The day" },
  { id: "at-a-glance", title: "Sponsorship at a glance" },
  { id: "tiers", title: "Tier details" },
  { id: "add-ons", title: "Add-ons" },
  { id: "report", title: "Post-event report" },
  { id: "how-we-work", title: "How we work with sponsors" },
  { id: "tickets", title: "Tickets" },
  { id: "how-to-sponsor", title: "How to sponsor" },
  { id: "schools", title: "For schools and programs" },
];
const ref = (id: string) => `${sheetNo}.${sections.findIndex((s) => s.id === id) + 1}`;

// Plan legend: which tier puts its name on which space
const planLegend = [
  { mark: "1", href: "#presenting", label: "The event itself: \u201cHampton Roads DevFest presented by [Your Company]\u201d", tier: "Presenting, $10,000" },
  { mark: "2", href: "#main-stage", label: "The room where every talk happens: \u201cThe [Your Company] Main Stage\u201d", tier: "Main Stage, $5,000" },
  { mark: "3", href: "#studio", label: "The lunch and hangout room: \u201cThe [Your Company] Studio\u201d", tier: "Studio, $3,500" },
  { mark: "4", href: "#scholarship", label: "A sponsor table at registration and every break", tier: "Scholarship tier and above, from $2,500" },
];

const email = "kevin@revolutionva.org";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://hrdevfest.org/sponsor" />
    <CanonicalLink href="https://hrdevfest.org/sponsor" />
    <meta property="og:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hrdevfest" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <GoogleAnalytics />
  </head>
  <body class="min-h-screen">
    <!-- Mobile hamburger button - outside the frame so it stays fixed -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bp-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bp-frame">
    <!-- Draft Banner -->
    <div id="draft-banner" role="note" class="w-full text-center py-4 pl-4 pr-16 md:px-4 border-b border-[var(--bp-line)]">
      <span class="inline-block border border-dashed border-[var(--bp-line)] px-4 py-2 bp-mono font-bold uppercase tracking-[0.12em] text-sm md:text-base">NOT FINAL: draft prospectus, details may change.</span>
    </div>

    <!-- Logo Bar (the hero below carries the date and place) -->
    <a href="/" class="block w-full py-4 pl-4 pr-16 md:px-4 border-b border-[var(--bp-line)]">
      <div class="flex justify-center">
        <Image src={logoWhite} alt="Hampton Roads DevFest home" class="h-14 w-auto" width={150} height={113} />
      </div>
    </a>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-[var(--bp-paper)] hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          {navLinksBeforeYears.map((link) => (
            <a href={link.href} class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
          <PastYearsNav variant="mobile" />
          {navLinksAfterYears.map((link) => (
            <a href={link.href} class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full py-4 px-4 md:px-8 border-b border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-6 lg:gap-10">
          {navLinksBeforeYears.map((link) => (
            <a href={link.href} class="bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
          <PastYearsNav variant="desktop" />
          {navLinksAfterYears.map((link) => (
            <a
              href={link.href}
              class="bp-nav-link text-base font-bold leading-relaxed aria-[current=page]:underline"
              aria-current={link.href === "/sponsor" ? "page" : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Hero: cover sheet. Title on the left, the plan on the right. -->
    <section class="w-full px-4 md:px-8 py-10 lg:py-16">
      <div class="max-w-[1120px] mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] gap-10 lg:gap-14 items-center">
        <div class="flex flex-col gap-4">
          <p class="bp-label text-sm">Sponsorship prospectus</p>
          <h1 class="text-[34px] md:text-[48px] font-bold leading-[1.08]">Sponsor Hampton Roads DevFest 2027</h1>
          <p class="text-lg md:text-xl font-semibold leading-snug">
            Friday, April 23, 2027<br />Zeiders American Dream Theater, Virginia Beach
          </p>
          <p class="bp-muted text-base md:text-lg leading-relaxed max-w-[42ch]">
            One day, one track. Every talk is a keynote and every sponsor is in the room with the people building software in Hampton Roads.
          </p>
          <p class="bp-muted text-sm leading-relaxed max-w-[48ch]">
            Presented by RevolutionVA, a 501(c)(3) nonprofit that builds the Hampton Roads tech community all year.
          </p>
          <div class="flex flex-wrap items-start gap-3 mt-2">
            <a href="#how-to-sponsor" class="px-8 py-3 btn-primary text-base whitespace-nowrap">How to Sponsor</a>
            <a href="#at-a-glance" class="px-8 py-3 btn-secondary text-base whitespace-nowrap">Compare tiers</a>
          </div>
        </div>

        <!-- Plan diagram: what each tier puts its name on -->
        <figure class="bp-box p-5 md:p-6 flex flex-col gap-5" aria-label="Plan of the day's spaces, keyed to sponsor naming rights. Not to scale.">
          <div class="flex items-baseline justify-end gap-4 border-b border-[var(--bp-line)] pb-3">
            <p class="bp-label">Not to scale</p>
          </div>

          <div class="relative pt-5 pr-5">
            <!-- 1: the event -->
            <div class="bp-room border-solid border-[var(--bp-line)] p-3 md:p-4">
              <span class="bp-mark" aria-hidden="true">1</span>
              <p class="bp-mono text-xs md:text-sm tracking-[0.08em] uppercase mb-3">Hampton Roads DevFest presented by [Your Company]</p>

              <div class="grid grid-cols-[3fr_2fr] gap-3 md:gap-4">
                <!-- 2: Main Stage -->
                <div class="bp-room p-3 md:p-4 min-h-[13rem] md:min-h-[15rem] flex flex-col">
                  <span class="bp-mark" aria-hidden="true">2</span>
                  <p class="font-bold leading-tight">Main Stage</p>
                  <div class="mt-auto pt-5 flex flex-col items-center gap-1 md:gap-1.5 overflow-hidden">
                    <!-- Theater seating: back rows widest, rows bow toward the stage at the edges -->
                    {Array.from({ length: 8 }).map((_, row) => {
                      const seats = 14 - Math.floor(row / 2);
                      const mid = (seats - 1) / 2;
                      return (
                        <div class="flex gap-[3px] md:gap-1" aria-hidden="true">
                          {Array.from({ length: seats }).map((_, i) => (
                            <span
                              class:list={[
                                "w-1.5 h-1.5 md:w-2 md:h-2 rounded-[2px] bg-[var(--bp-line-faint)]",
                                (i < 2 || i >= seats - 2) && "hidden sm:block",
                              ]}
                              style={`transform: translateY(${(((i - mid) / mid) ** 2 * 3).toFixed(1)}px)`}
                            ></span>
                          ))}
                        </div>
                      );
                    })}
                    <div class="mt-3 w-[70%] h-8 border border-[var(--bp-line)] flex items-center justify-center">
                      <p class="bp-label text-[0.65rem]">Stage</p>
                    </div>
                  </div>
                </div>

                <div class="flex flex-col gap-3 md:gap-4">
                  <!-- 3: Studio -->
                  <div class="bp-room p-3 md:p-4 flex-1 flex flex-col">
                    <span class="bp-mark" aria-hidden="true">3</span>
                    <p class="font-bold leading-tight">The Studio</p>
                  </div>
                  <!-- 4: Registration -->
                  <div class="bp-room p-3 md:p-4 flex-1 flex flex-col">
                    <span class="bp-mark" aria-hidden="true">4</span>
                    <p class="font-bold leading-tight">Registration</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <figcaption>
            <ol class="flex flex-col divide-y divide-[var(--bp-line-faint)] border-t border-[var(--bp-line-faint)]">
              {planLegend.map((item) => (
                <li class="grid grid-cols-[auto_1fr] gap-x-3 py-2.5 items-start">
                  <a href={item.href} class="bp-mark" aria-label={`Go to ${item.tier}`}>{item.mark}</a>
                  <div class="leading-snug">
                    <p class="text-sm md:text-base">{item.label}</p>
                    <p class="bp-mono text-xs md:text-sm bp-muted mt-0.5">{item.tier}</p>
                  </div>
                </li>
              ))}
            </ol>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Sheet index -->
    <section id="index" class="w-full px-4 md:px-8 pb-10 lg:pb-16">
      <nav class="max-w-[1120px] mx-auto bp-box" aria-label="Sections of this prospectus">
        <p class="bp-label px-5 py-3 border-b border-[var(--bp-line)]">Sheet {sheetNo} index</p>
        <ol class="grid grid-cols-1 md:grid-cols-2 md:[&>li:nth-child(odd)]:border-r md:[&>li]:border-[var(--bp-line-faint)]">
          {sections.map((section) => (
            <li class="border-b border-[var(--bp-line-faint)] md:[&:nth-last-child(-n+2)]:border-b-0 last:border-b-0">
              <a href={`#${section.id}`} class="grid grid-cols-[4rem_1fr] items-baseline px-5 py-2.5 bp-nav-link hover:bg-[var(--bp-paper-deep)]">
                <span class="bp-sheet-ref">{ref(section.id)}</span>
                <span class="text-base font-semibold">{section.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>

    <!-- Why Sponsor -->
    <section id="why-sponsor" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <span class="bp-sheet-ref">{ref("why-sponsor")}</span>
