// A bullet can carry a nested list (for example, what the report covers)
type FaqBullet = string | { text: string; items: string[] };

interface FaqItem {
  title: string;
  bullets: FaqBullet[];
  open?: boolean;
}

const faqItems: FaqItem[] = [
  {
    title: "Commit now. Pay in 2027 if needed.",
    open: true,
    bullets: [
      "Email team@revolutionva.org to reserve your sponsorship. If you need to use your 2027 budget, let us know when you book. We'll confirm your payment date with your reservation.",
      "Payment is due within 30 days of invoicing unless we agree on a 2027 payment date when you book.",
      "Community ($500) is paid at checkout.",
      "We hold your package for 30 days after you email us. Need longer for approvals? Ask and we'll extend it.",
      "Sign and logo files are due by Apr 1, 2027.",
    ],
  },
  {
    title: "Payment",
    bullets: [
      "Community ($500) checkout is a flat $500 by card or bank transfer. Checkout asks for your company name, contact emails, and a logo link (or we follow up).",
      "Paying an invoice by card adds 3%. Check and ACH have no fee.",
      "In-kind support, such as venue or Pop-up Meetup hosting, is itemized separately and counts toward Community recognition once we agree on a written value.",
      "Purchase orders accepted. Quotes are available on request.",
    ],
  },
  {
    title: "Do you work with supplier portals?",
    bullets: [
      "Yes. We're happy to register in your supplier portal for Presenting, Main Stage, and Reception sponsorships.",
    ],
  },
  {
    title: "Attendee privacy",
    open: true,
    bullets: [
      "Sponsor email opt-in is off by default.",
      "Presenting, Main Stage and Reception each include one post-event email, sent by DevFest to attendees who opt in. One email per qualifying offering.",
      "Attendee contacts are never handed to sponsors.",
      "We never sell attendee lists, and we never scan badges.",
    ],
  },
  {
    title: "Post-event report",
    bullets: [
      "Every sponsor receives the post-event report.",
      "The report lists companies present, when attendees provide them.",
      {
        text: "The report includes aggregate audience data and photos of sponsor tables or signage. It does not include attendee names or contact details.",
        items: [
          "Attendance and check-ins",
          "Roles and seniority",
          "Hiring, looking for work, internship, and open-to-contract ribbons",
          "Regions, students, veterans, and tech stacks",
          "Military or transitioning from the military (optional at registration)",
          "Scholars who attended versus scholars funded",
          "Newsletter and social reach",
        ],
      },
    ],
  },
  {
    title: "Hiring board and ribbons",
    bullets: [
      "Exhibitor, Featured, Main Stage and Presenting include a hiring-board listing near registration and on the DevFest site.",
      "Standalone partnerships do not include a hiring-board listing.",
      "Sponsors write their own listings. Every role must include an expected salary range.",
      "We don't collect resumes.",
      "Attendees can wear Hiring, Looking for work, Internship, or Open to contract work ribbons.",
    ],
  },
  {
    title: "Speakers and Sponsor Stage Time",
    bullets: [
      "We invite speakers from community recommendations. There's no open call.",
      "Anyone can be recommended, including sponsor staff, and that is separate from sponsorship.",
      "Presenting and Main Stage each include 15 minutes of Sponsor Stage Time during the conference. Those talks are clearly identified as sponsor presentations.",
      "The Post-Event Reception Partner includes a sponsor welcome of up to two minutes at the reception, separate from conference talks.",
    ],
  },
  {
    title: "Logo files",
    bullets: [
      "SVG (or EPS or PDF) preferred, since we use it for print signs too.",
      "If you only have a PNG, send it with a transparent background, at least 1,000 px wide.",
      "Send a version for light backgrounds and one for dark backgrounds, such as all-white.",
      "A horizontal logo works best. We'll resize it for the site.",
      "Send files to team@revolutionva.org by Apr 1, 2027.",
    ],
  },
  {
    title: "Paperwork",
    bullets: [
      "Our W-9 and 501(c)(3) letter are available on request.",
      "Sponsorships are invoiced as sponsorships, not donations.",
      "Please consult your tax advisor on how to treat them.",
      "Sponsorship does not include access to officials. This includes elected, government, and military officials who attend.",
    ],
  },
];

// The "Past years" menu sits between these two groups
const navLinksBeforeYears = [
  { href: "/#about", label: "About" },
  { href: "/#venue", label: "Venue" },
  { href: "/#testimonials", label: "Testimonials" },
];
const navLinksAfterYears = [
  { href: "/faq", label: "FAQ" },
  { href: "/sponsor", label: "Sponsor" },
];

const sections = [
  { id: "why-sponsor", title: "Why sponsor DevFest" },
  { id: "who-was-at-devfest-2026", title: "Who was at DevFest 2026?" },
  { id: "at-a-glance", title: "Core sponsorship packages" },
  { id: "partnerships", title: "Event & Community Partnerships" },
  { id: "the-day", title: "The day" },
  { id: "reserve", title: "Reserve your sponsorship" },
  { id: "sponsor-faq", title: "Sponsor FAQ" },
];

// Options for the "Hold my package" form
const packageOptions = [
  ...glance.filter((row) => !row.checkoutHref).map((row) => `${row.package} (${row.price})`),
  ...partnerships.map((partner) => `${partner.name} (${partner.price})`),
  "Not sure yet",
];


const devfest2026Employers = [
  'AI Collective',
  'City of Chesapeake',
