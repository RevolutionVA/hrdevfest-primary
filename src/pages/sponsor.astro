---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import CanonicalLink from "../components/CanonicalLink.astro";
import PastYearsNav from "../components/PastYearsNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { sheetFor } from "../data/titleBlock";
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";
import FooterBridge from "../components/FooterBridge.astro";

const pageTitle = "Sponsor | Hampton Roads DevFest 2027";
const pageDescription = "Sponsorship prospectus for Hampton Roads DevFest 2027, Friday, April 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA. Presented by RevolutionVA, a 501(c)(3) nonprofit.";

interface ScheduleItem {
  time: string;
  what: string;
  sponsorTime?: boolean; // a moment sponsors are on, at a table, or being named
}

const schedule: ScheduleItem[] = [
  { time: "7:30", what: "Building opens, sponsor setup", sponsorTime: true },
  { time: "8:00", what: "Registration and networking at the sponsor tables", sponsorTime: true },
  { time: "9:00", what: "Opening, with the Presenting sponsor's 15-minute presentation", sponsorTime: true },
  { time: "9:30", what: "Talk" },
  { time: "10:15", what: "Talk" },
  { time: "11:00", what: "Networking break at the sponsor tables", sponsorTime: true },
  { time: "11:30", what: "Talk" },
  { time: "12:15", what: "Lunch in the Studio", sponsorTime: true },
  { time: "1:30", what: "Main Stage sponsor's 15-minute presentation", sponsorTime: true },
  { time: "1:45", what: "Talk" },
  { time: "2:30", what: "Networking break at the sponsor tables", sponsorTime: true },
  { time: "3:00", what: "Talk" },
  { time: "3:45", what: "Talk" },
  { time: "4:30", what: "Closing, then networking and sponsor teardown (building closes at 6:00)", sponsorTime: true },
];

interface GlanceRow {
  mark: string;
  detail: string;
  package: string;
  price: string;
  available: string;
  tickets: string;
  extras: string;
}

const glance: GlanceRow[] = [
  {
    mark: "P",
    detail: "presenting",
    package: "Presenting Sponsor",
    price: "$10,000",
    available: "1",
    tickets: "12",
    extras: '"DevFest presented by [Company]"; highest branding prominence across website, event emails and signage; 15-minute opening sponsor presentation; newsletter feature; 4 dedicated social posts.',
  },
  {
    mark: "M",
    detail: "main-stage",
    package: "Main Stage Sponsor",
    price: "$5,000",
    available: "1",
    tickets: "10",
    extras: '"[Company] Main Stage" naming on signage and schedule; 15-minute afternoon sponsor presentation; newsletter feature; 3 dedicated social posts.',
  },
  {
    mark: "F",
    detail: "featured",
    package: "Featured Sponsor",
    price: "$2,500",
    available: "5",
    tickets: "4",
    extras: "Larger logo placement; newsletter mention; 2 dedicated social posts.",
  },
  {
    mark: "E",
    detail: "exhibitor",
    package: "Exhibitor Sponsor",
    price: "$1,500",
    available: "5",
    tickets: "2",
    extras: "Standard logo placement; 1 dedicated social post.",
  },
  {
    mark: "C",
    detail: "community",
    package: "Community Sponsor",
    price: "$500",
    available: "Unlimited",
    tickets: "1",
    extras: "Shared logo placement and group recognition.",
  },
];

interface Tier {
  id: string;
  mark: string;
  name: string;
  price: string;
  available?: string;
  tagline?: string;
  benefits: string[];
  quickPath?: boolean;
}

const sharedCoreBenefits = [
  "Website and slide recognition",
  "A group thank-you",
  "The post-event report",
];

const tableAndHiring = [
  "One sponsor table",
  "A hiring-board listing",
];

const tiers: Tier[] = [
  {
    id: "presenting",
    mark: "P",
    name: "Presenting Sponsor",
    price: "$10,000",
    available: "1 available",
    tagline: '"DevFest presented by [Company]"',
    benefits: [
      ...sharedCoreBenefits,
      ...tableAndHiring,
      "12 standard tickets",
      "Highest branding prominence across website, event emails and signage",
      "15-minute opening sponsor presentation",
      "Newsletter feature",
      "4 dedicated social posts",
    ],
  },
  {
    id: "main-stage",
    mark: "M",
    name: "Main Stage Sponsor",
    price: "$5,000",
    available: "1 available",
    tagline: '"[Company] Main Stage" naming on signage and schedule',
    benefits: [
      ...sharedCoreBenefits,
      ...tableAndHiring,
      "10 standard tickets",
      "15-minute afternoon sponsor presentation",
      "Newsletter feature",
      "3 dedicated social posts",
    ],
  },
  {
    id: "featured",
    mark: "F",
    name: "Featured Sponsor",
    price: "$2,500",
    available: "5 available",
    benefits: [
      ...sharedCoreBenefits,
      ...tableAndHiring,
      "4 standard tickets",
      "Larger logo placement",
      "Newsletter mention",
      "2 dedicated social posts",
    ],
  },
  {
    id: "exhibitor",
    mark: "E",
    name: "Exhibitor Sponsor",
    price: "$1,500",
    available: "5 available",
    benefits: [
      ...sharedCoreBenefits,
      ...tableAndHiring,
      "2 standard tickets",
      "Standard logo placement",
      "1 dedicated social post",
    ],
  },
  {
    id: "community",
    mark: "C",
    name: "Community Sponsor",
    price: "$500",
    available: "Unlimited",
    benefits: [
      ...sharedCoreBenefits,
      "1 standard ticket",
      "Shared logo placement and group recognition",
    ],
    quickPath: true,
  },
];

interface Partnership {
  id: string;
  mark: string;
  name: string;
  price: string;
  available: string;
  benefits: string[];
  linkLabel?: string;
  linkHref?: string;
}

const partnerships: Partnership[] = [
  {
    id: "scholarship-partner",
    mark: "SP",
    name: "Scholarship Partner",
    price: "$1,000",
    available: "1 exclusive",
    benefits: [
      "Underwrites 20 standard admissions for students and veterans",
      "Recognition as the scholarship program's supporter",
    ],
  },
  {
    id: "popup-series-partner",
    mark: "PP",
    name: "Pop-up Series Partner",
    price: "$1,000",
    available: "1 exclusive",
    benefits: [
      "Series partner recognition across all four 2027 Pop-up Meetups",
    ],
    linkLabel: "Pop-up Meetups",
    linkHref: "https://revolutionva.org/programs/pop-up-meetups/",
  },
  {
    id: "coffee-partner",
    mark: "CP",
    name: "Coffee Partner",
    price: "$1,000",
    available: "1 exclusive",
    benefits: [
      "Coffee station branding",
      "A thank-you during opening remarks",
    ],
  },
  {
    id: "lunch-partner",
    mark: "LP",
    name: "Lunch Partner",
    price: "$2,000",
    available: "1 exclusive",
    benefits: [
      "Lunch area branding",
      "A thank-you before lunch",
    ],
  },
  {
    id: "lanyard-partner",
    mark: "YP",
    name: "Lanyard Partner",
    price: "$1,000",
    available: "1 exclusive",
    benefits: [
      "Company logo alongside DevFest branding on attendee lanyards",
    ],
  },
];

const reportItems: string[] = [
  "Attendance and check-ins",
  "The mix of attendee roles and seniority",
  "Counts for all four opt-in ribbons: Hiring, Looking for work, Internship, and Open to contract work (counts only, never names)",
  "Counts by region, veterans, students, and tech stacks and languages (proposed)",
  "Whether attendees are military or transitioning from the military, which we ask at registration. The question is optional, and we only ever report it to sponsors as totals, never names",
  "Scholars who attended versus scholars funded (proposed)",
  "Newsletter and social reach",
  "Photos of your table or signage",
];

interface Commitment {
  title: string;
  body?: string;
  bullets?: string[];
  bodyHref?: string;
  bodyHrefLabel?: string;
}

const commitments: Commitment[] = [
  {
    title: "Commit in 2026. Pay in 2027.",
    bullets: [
      "Commit to your sponsorship in 2026 so we can include you in signage, slides, and announcements.",
      "Your invoice and payment can come in 2027.",
      "A written intent to sponsor in 2026 counts as committed, with your purchase order or payment in 2027.",
      "Sign and logo files are due by April 1, 2027.",
      "Exclusive packages and partnerships are assigned in order of written intent and held for 30 days from your written intent to sponsor.",
    ],
  },
  {
    title: "Attendee privacy comes first.",
    bullets: [
      "Sponsor email opt-in for attendees is off by default.",
      "When attendees opt in, we include your message in our one post-event sponsor email.",
      "Attendee contacts are never handed to sponsors.",
      "After the event, we send one email to attendees who opted in, covering all sponsors.",
      "We never sell attendee lists, and we never scan badges.",
    ],
  },
  {
    title: "A post-event report with every core package.",
    bullets: [
      "Every core sponsorship package includes the full post-event report.",
      "The report is aggregate only, with no attendee names or employers.",
      "Attendance and check-ins",
      "The mix of attendee roles and seniority",
      "Counts for all four opt-in ribbons: Hiring, Looking for work, Internship, and Open to contract work (counts only, never names)",
      "Counts by region, veterans, students, and tech stacks and languages (proposed)",
      "Whether attendees are military or transitioning from the military, which we ask at registration. The question is optional, and we only ever report it to sponsors as totals, never names",
      "Scholars who attended versus scholars funded (proposed)",
      "Newsletter and social reach",
      "Photos of your table or signage",
    ],
  },
  {
    title: "A hiring board for Exhibitor and above.",
    bullets: [
      "Every package at $1,500 and above includes a hiring-board listing.",
      "The board is printed near registration and posted on the DevFest site.",
      "Full-time, internship, apprenticeship, contract, and freelance roles are all welcome.",
      "Sponsors write their own listings, for example clearance required, remote, or internship.",
      "Every role listed must include an expected salary range.",
      "Roles from recruiting agencies are clearly labeled as agency roles.",
      "We don't collect resumes.",
    ],
  },
  {
    title: "Opt-in ribbons.",
    body: "Attendees can choose to wear Hiring, Looking for work, Internship, or Open to contract work ribbons. The post-event report includes counts for each ribbon, never names.",
  },
  {
    title: "W-9, insurance, and 501(c)(3) letter on request.",
    body: "Our W-9, certificate of insurance, and 501(c)(3) letter are available on request.",
  },
  {
    title: "Simple payment.",
    body: "Payment options are listed under Package details.",
    bodyHref: "#payment-options",
    bodyHrefLabel: "Payment options",
  },
  {
    title: "In-kind support is itemized separately.",
    body: "See Payment options under Package details.",
    bodyHref: "#payment-options",
    bodyHrefLabel: "Payment options",
  },
  {
    title: "How speakers and sponsor talks work.",
    bullets: [
      "Speakers are invited, based on recommendations from the community. There's no open call.",
      "Sponsorship doesn't buy a spot in the speaker lineup.",
      "Presenting and Main Stage include a separate 15-minute sponsor talk.",
      "Sponsor presentations are clearly identified separately from independently selected conference sessions.",
    ],
  },
  {
    title: "Purchasing rules.",
    bullets: [
      "Standalone partnerships include website and slide recognition and one standard ticket, plus the listed benefit.",
      "Sponsor tables come with Exhibitor ($1,500) and up. A standalone partnership doesn't include a table.",
      "You can add any available partnership to a core package.",
      "Naming rights belong to the package or partnership purchased. Meetup naming stays with the Pop-up Series Partner.",
    ],
  },
  {
    title: "No access to elected or city officials.",
    body: "We don't promise access to elected or city officials, even if they attend the event.",
  },
];

// The "Past years" menu sits between these two groups
const navLinksBeforeYears = [
  { href: "/#about", label: "About" },
  { href: "/#venue", label: "Venue" },
  { href: "/#testimonials", label: "Testimonials" },
];
const navLinksAfterYears = [
  { href: "/faq", label: "FAQ" },
  { href: "/sponsor", label: "Sponsor" },
];

// Sheet index. The footer title block calls this page sheet N of the set,
// so each section is numbered N.1, N.2, ... like sheets in a drawing set.
const sheet = sheetFor("/sponsor");
const sheetNo = sheet ? sheet.split(" ")[0] : "2";
const sections = [
  { id: "why-sponsor", title: "Why sponsor DevFest" },
  { id: "the-day", title: "The day" },
  { id: "at-a-glance", title: "Core packages" },
  { id: "tiers", title: "Package details" },
  { id: "partnerships", title: "Event & Community Partnerships" },
  { id: "report", title: "Post-event report" },
  { id: "how-we-work", title: "How we work with sponsors" },
  { id: "how-to-sponsor", title: "How to sponsor" },
];
const ref = (id: string) => `${sheetNo}.${sections.findIndex((s) => s.id === id) + 1}`;


const email = "team@revolutionva.org";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://hrdevfest.org/sponsor" />
    <CanonicalLink href="https://hrdevfest.org/sponsor" />
    <meta property="og:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hrdevfest" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <GoogleAnalytics />
  </head>
  <body class="min-h-screen">
    <!-- Mobile hamburger button - outside the frame so it stays fixed -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bp-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bp-frame">
    <!-- Draft Banner -->
    <div id="draft-banner" role="note" class="w-full text-center py-4 pl-4 pr-16 md:px-4 border-b border-[var(--bp-line)]">
      <span class="inline-block border border-dashed border-[var(--bp-line)] px-4 py-2 bp-mono font-bold uppercase tracking-[0.12em] text-sm md:text-base">NOT FINAL: draft prospectus, details may change.</span>
    </div>

    <!-- Logo Bar (the hero below carries the date and place) -->
    <a href="/" class="block w-full py-4 pl-4 pr-16 md:px-4 border-b border-[var(--bp-line)]">
      <div class="flex justify-center">
        <Image src={logoWhite} alt="Hampton Roads DevFest home" class="h-24 md:h-28 w-auto" width={300} height={225} />
      </div>
    </a>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-[var(--bp-paper)] hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          {navLinksBeforeYears.map((link) => (
            <a href={link.href} class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
          <PastYearsNav variant="mobile" />
          {navLinksAfterYears.map((link) => (
            <a href={link.href} class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full py-4 px-4 md:px-8 border-b border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-6 lg:gap-10">
          {navLinksBeforeYears.map((link) => (
            <a href={link.href} class="bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
          <PastYearsNav variant="desktop" />
          {navLinksAfterYears.map((link) => (
            <a
              href={link.href}
              class="bp-nav-link text-base font-bold leading-relaxed aria-[current=page]:underline"
              aria-current={link.href === "/sponsor" ? "page" : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Hero: cover sheet. Title on the left, the plan on the right. -->
    <section class="w-full px-4 md:px-8 py-10 lg:py-16">
      <div class="max-w-[1120px] mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] gap-10 lg:gap-14 items-center">
        <div class="flex flex-col gap-4">
          <p class="bp-label text-sm">Sponsorship prospectus</p>
          <h1 class="text-[34px] md:text-[48px] font-bold leading-[1.08]">Sponsor Hampton Roads DevFest 2027</h1>
          <p class="text-lg md:text-xl font-semibold leading-snug">
            Friday, April 23, 2027<br />Zeiders American Dream Theater, Virginia Beach
          </p>
          <p class="bp-muted text-base md:text-lg leading-relaxed max-w-[42ch]">
            One day, one track. Every talk is a keynote and every sponsor is in the room with the people solving problems with technology in Hampton Roads.
          </p>
          <p class="bp-muted text-sm leading-relaxed max-w-[48ch]">
            Presented by RevolutionVA, a 501(c)(3) nonprofit that builds the Hampton Roads tech community all year.
          </p>
          <div class="flex flex-wrap items-start gap-3 mt-2">
            <a href="#how-to-sponsor" class="px-8 py-3 btn-primary text-base whitespace-nowrap">How to Sponsor</a>
            <a href="#at-a-glance" class="px-8 py-3 btn-secondary text-base whitespace-nowrap">Compare packages</a>
          </div>
        </div>

        <!-- Plan diagram: what each tier puts its name on -->
        <figure class="bp-box p-5 md:p-6 flex flex-col gap-5" aria-label="Plan of the day's spaces: the event, Main Stage, the Studio, and Registration. Not to scale.">
          <p class="bp-label self-end">Not to scale</p>

          <div class="relative pt-5 pr-5">
            <!-- 1: the event -->
            <div class="bp-room border-solid border-[var(--bp-line)] p-3 md:p-4">
              <p class="bp-mono text-xs md:text-sm tracking-[0.08em] uppercase mb-3">Hampton Roads DevFest presented by [Your Company]</p>

              <div class="grid grid-cols-[3fr_2fr] gap-3 md:gap-4">
                <!-- 2: Main Stage -->
                <div class="bp-room p-3 md:p-4 min-h-[13rem] md:min-h-[15rem] flex flex-col">
                  <p class="font-bold leading-tight">Main Stage</p>
                  <div class="mt-auto pt-5 flex flex-col items-center gap-1 md:gap-1.5 overflow-hidden">
                    <!-- Theater seating: back rows widest, rows bow toward the stage at the edges -->
                    {Array.from({ length: 8 }).map((_, row) => {
                      const seats = 14 - Math.floor(row / 2);
                      const mid = (seats - 1) / 2;
                      return (
                        <div class="flex gap-[3px] md:gap-1" aria-hidden="true">
                          {Array.from({ length: seats }).map((_, i) => (
                            <span
                              class:list={[
                                "w-1.5 h-1.5 md:w-2 md:h-2 rounded-[2px] bg-[var(--bp-line-faint)]",
                                (i < 2 || i >= seats - 2) && "hidden sm:block",
                              ]}
                              style={`transform: translateY(${(((i - mid) / mid) ** 2 * 3).toFixed(1)}px)`}
                            ></span>
                          ))}
                        </div>
                      );
                    })}
                    <div class="mt-3 w-[70%] h-8 border border-[var(--bp-line)] flex items-center justify-center">
                      <p class="bp-label text-[0.65rem]">Stage</p>
                    </div>
                  </div>
                </div>

                <div class="flex flex-col gap-3 md:gap-4">
                  <!-- 3: Studio -->
                  <div class="bp-room p-3 md:p-4 flex-1 flex flex-col">
                    <p class="font-bold leading-tight">The Studio</p>
                  </div>
                  <!-- 4: Registration -->
                  <div class="bp-room p-3 md:p-4 flex-1 flex flex-col">
                    <p class="font-bold leading-tight">Registration</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </figure>
      </div>
    </section>

    <!-- Sheet index -->
    <section id="index" class="w-full px-4 md:px-8 pb-10 lg:pb-16">
      <nav class="max-w-[1120px] mx-auto bp-box" aria-label="Sections of this prospectus">
        <p class="bp-label px-5 py-3 border-b border-[var(--bp-line)]">Sheet {sheetNo} index</p>
        <ol class="grid grid-cols-1 md:grid-cols-2 md:[&>li:nth-child(odd)]:border-r md:[&>li]:border-[var(--bp-line-faint)]">
          {sections.map((section) => (
            <li class="border-b border-[var(--bp-line-faint)] md:[&:nth-last-child(-n+2)]:border-b-0 last:border-b-0">
              <a href={`#${section.id}`} class="grid grid-cols-[4rem_1fr] items-baseline px-5 py-2.5 bp-nav-link hover:bg-[var(--bp-paper-deep)]">
                <span class="bp-sheet-ref">{ref(section.id)}</span>
                <span class="text-base font-semibold">{section.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>

    <!-- Why Sponsor -->
    <section id="why-sponsor" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <span class="bp-sheet-ref">{ref("why-sponsor")}</span>
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Why sponsor DevFest</h2>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-8 lg:gap-12">
          <div class="bp-surface flex flex-col gap-3 max-w-[48ch]">
            <p class="text-lg font-semibold">Hampton Roads talent and excellence.</p>
            <ul class="flex flex-col divide-y divide-[var(--bp-line-faint)] border-y border-[var(--bp-line-faint)] text-base leading-relaxed">
              <li class="py-2.5">Hampton Roads DevFest is the region's one-day developer conference, built to show what Hampton Roads developers can do.</li>
              <li class="py-2.5">Local developers, engineers, veterans, and students come together to learn from each other, connect, and meet the companies building technology here.</li>
              <li class="py-2.5">2026: 255 of 299 seats sold.</li>
              <li class="py-2.5">2027: we expect to sell out.</li>
            </ul>
          </div>
          <div class="bp-surface">
            <p class="bp-label mb-3">For 2027</p>
            <ul class="flex flex-col divide-y divide-[var(--bp-line-faint)] border-y border-[var(--bp-line-faint)] text-base leading-relaxed">
              <li class="py-3"><strong>Local talent on stage.</strong> DevFest is single track, in one room. Every speaker is a keynote, and everyone sees every talk.</li>
