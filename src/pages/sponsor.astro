---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import HeaderTagline from "../components/HeaderTagline.astro";
import PastYearsNav from "../components/PastYearsNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";

const pageTitle = "Sponsor | Hampton Roads DevFest 2027";
const pageDescription = "Sponsorship prospectus for Hampton Roads DevFest 2027, Friday, April 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA. Presented by RevolutionVA, a 501(c)(3) nonprofit.";

interface ScheduleItem {
  time: string;
  what: string;
}

const schedule: ScheduleItem[] = [
  { time: "7:30", what: "Building opens, sponsor setup" },
  { time: "8:00", what: "Registration and networking at the sponsor tables" },
  { time: "9:00", what: "Opening, with the Presenting sponsor's 15-minute talk" },
  { time: "9:30", what: "Talk" },
  { time: "10:15", what: "Talk" },
  { time: "11:00", what: "Networking break at the sponsor tables" },
  { time: "11:30", what: "Talk" },
  { time: "12:15", what: "Lunch in the Studio" },
  { time: "12:45", what: "Scholar Meetup in the Studio" },
  { time: "1:30", what: "Main Stage sponsor's 15-minute talk" },
  { time: "1:45", what: "Talk" },
  { time: "2:30", what: "Networking break at the sponsor tables" },
  { time: "3:00", what: "Talk" },
  { time: "3:45", what: "Talk" },
  { time: "4:30", what: "Closing, then networking and sponsor teardown (building closes at 6:00)" },
];

interface GlanceRow {
  tier: string;
  price: string;
  available: string;
  table: string;
  talk: boolean;
  tickets: string;
  social: string;
  report: boolean;
}

const glance: GlanceRow[] = [
  { tier: "Presenting", price: "$10,000", available: "1", table: "Yes", talk: true, tickets: "12", social: "4", report: true },
  { tier: "Main Stage", price: "$5,000", available: "1", table: "Yes", talk: true, tickets: "10", social: "3", report: true },
  { tier: "Studio", price: "$3,500", available: "1", table: "Yes (in the Studio)", talk: false, tickets: "6", social: "3", report: true },
  { tier: "Veteran Scholarship", price: "$2,500", available: "3", table: "Yes", talk: false, tickets: "4", social: "2", report: true },
  { tier: "Student Scholarship", price: "$2,500", available: "3", table: "Yes", talk: false, tickets: "4", social: "2", report: true },
  { tier: "Jobs Board", price: "$1,000", available: "Open", table: "", talk: false, tickets: "2", social: "1", report: false },
  { tier: "Community", price: "$500", available: "Open", table: "", talk: false, tickets: "1", social: "Group thank-you", report: false },
];

interface Tier {
  id: string;
  name: string;
  price: string;
  available?: string;
  tagline?: string;
  lead?: string;
  benefits: string[];
  quickPath?: boolean;
}

const tiers: Tier[] = [
  {
    id: "presenting",
    name: "Presenting Sponsor",
    price: "$10,000",
    available: "1 available",
    tagline: "Your name on the event: \"Hampton Roads DevFest presented by [Your Company].\"",
    benefits: [
      "A 15-minute talk at the 9:00 opening, when the whole room is in their seats. The talk can include a product demo, or it can be a welcome from a public official.",
      "Top logo placement on the website, slides, and signage",
      "A sponsor table",
      "12 tickets",
      "A feature in the 757tech newsletter",
      "At least 4 sponsor posts on 757tech's social channels: an announcement, a reminder, a day-of post, and a thank-you",
      "Year-round Pop-up Meetup naming: your company names every quarterly 757tech Pop-up Meetup for 12 months, with 2 minutes at the start of each",
      "Optional spot on the Who's hiring board, free if you want it, in print at the event and on the DevFest site",
      "The post-event report",
    ],
  },
  {
    id: "main-stage",
    name: "Main Stage Sponsor",
    price: "$5,000",
    available: "1 available",
    tagline: "Your name on the room where every talk happens: \"The [Your Company] Main Stage.\"",
    benefits: [
      "A 15-minute talk at 1:30, right after lunch. The talk can include a product demo.",
      "Main Stage naming on signage, slides, and the schedule",
      "A sponsor table",
      "10 tickets",
      "A feature in the 757tech newsletter",
      "At least 3 sponsor posts on 757tech's social channels",
      "Year-round Pop-up Meetup naming (how this is shared with the Presenting sponsor: details coming soon)",
      "Optional spot on the Who's hiring board, free if you want it, in print at the event and on the DevFest site",
      "The post-event report",
    ],
  },
  {
    id: "studio",
    name: "Studio Sponsor",
    price: "$3,500",
    available: "1 available",
    tagline: "The room where everyone eats, hangs out, and talks: \"The [Your Company] Studio.\"",
    benefits: [
      "Naming of the Studio, the lunch and hangout room",
      "Signage in the Studio",
      "Your sponsor table inside the Studio",
      "6 tickets",
      "A mention in the 757tech newsletter",
      "At least 3 sponsor posts on 757tech's social channels",
      "Optional spot on the Who's hiring board, free if you want it, in print at the event and on the DevFest site",
      "The post-event report",
    ],
  },
  {
    id: "scholarship",
    name: "Veteran Scholarship and Student Scholarship Sponsors",
    price: "$2,500 each",
    available: "3 of each available",
    tagline: "Your sponsorship funds scholarship seats.",
    lead: "Every dollar of the Scholarship tier funds lottery seats, named for your company as a Veteran Scholarship or a Student Scholarship. Your 10 seats are held for the lottery, even if we sell out, and we hand them out the week of the event. Veteran Scholarship seats are drawn from veteran entries, and Student Scholarship seats are drawn from student entries. Scholars never need to show proof of need.",
    benefits: [
      "Funds 10 named scholarship seats, held for our lottery even if we sell out and handed out the week of the event",
      "Meet your scholars at the Scholar Meetup (12:45, in the Studio). The meetup is optional for scholars.",
      "A sponsor table",
      "4 tickets for your team",
      "A mention in the 757tech newsletter",
      "At least 2 sponsor posts on 757tech's social channels: an announcement and a thank-you to your company",
      "Scholars are never named or labeled, in posts, on badges, or at the event",
      "Optional spot on the Who's hiring board, free if you want it, in print at the event and on the DevFest site",
      "The post-event report, including scholars who attended versus scholars funded",
    ],
  },
  {
    id: "jobs-board",
    name: "Jobs Board Sponsor",
    price: "$1,000",
    available: "open",
    benefits: [
      "Your logo, 2 to 3 open role titles, and a QR code to your careers page on the printed Who's hiring board near registration",
      "A listing in the Who's hiring section of the DevFest site, live from when you sign until about 30 days after the event",
      "You write your own listings, for example clearance required, remote, or internship. Every role you list must include an expected salary range.",
      "A mention in the post-event recap email",
      "One named contact from your team for attendees to reach out to",
      "Your logo on the website and slides",
      "A sponsor post on 757tech's social channels",
      "2 tickets",
      "A one-page recap after the event: total attendance, the \"Looking for work\" ribbon count, role mix, and top tech stacks",
      "No sponsor table and no stage time. We don't collect resumes.",
    ],
  },
  {
    id: "community",
    name: "Community Sponsor",
    price: "$500",
    available: "open",
    benefits: [
      "Your logo on the website and slides",
      "1 ticket",
      "Included in a group thank-you post on 757tech's social channels",
    ],
    quickPath: true,
  },
];

const reportItems: string[] = [
  "Attendance and check-ins",
  "The mix of attendee roles and seniority",
  "Counts for all four opt-in ribbons: Hiring, Looking for work, Internship, and Open to contract work (counts only, never names)",
  "Counts by region, veterans, students, and tech stacks and languages (proposed)",
  "Whether attendees are military or transitioning from the military, which we ask at registration. The question is optional, and we only ever report it to sponsors as totals, never names",
  "Scholars who attended versus scholars funded (proposed)",
  "Newsletter and social reach",
  "Photos of your table or signage",
];

interface Commitment {
  title: string;
  body: string;
}

const commitments: Commitment[] = [
  {
    title: "Commit by December 15, 2026. Pay in January.",
    body: "Commit to your sponsorship by December 15, 2026 so we can include you in signage, slides, and announcements. Your invoice and payment can come in January 2027. A written intent to sponsor by December 15, 2026 counts as committed, with your purchase order or payment in January. Scholarship tiers are assigned in order of written intent and held for 30 days from your written intent to sponsor.",
  },
  {
    title: "Attendee privacy comes first.",
    body: "Sponsor email opt-in for attendees is off by default. When attendees opt in, we include your message in our one post-event sponsor email, and attendee contacts are never handed to sponsors. After the event, we send one email to attendees who opted in, covering all sponsors. We never sell attendee lists, and we never scan badges.",
  },
  {
    title: "A one-page recap for Jobs Board sponsors.",
    body: "After DevFest, Jobs Board sponsors get a one-page recap covering total attendance, the \"Looking for work\" ribbon count, the mix of attendee roles, and the top tech stacks attendees work with.",
  },
  {
    title: "A Who's hiring board for sponsor roles.",
    body: "Jobs Board sponsors get a listing on the Who's hiring board, and Scholarship tier sponsors and up can opt in for free. The board is printed near registration and posted on the DevFest site. Full-time, internship, apprenticeship, contract, and freelance roles are all welcome. Sponsors write their own listings, for example clearance required, remote, or internship, and every role listed must include an expected salary range. Roles from recruiting agencies are clearly labeled as agency roles. We don't collect resumes.",
  },
  {
    title: "Opt-in ribbons.",
    body: "Attendees can choose to wear Hiring, Looking for work, Internship, or Open to contract work ribbons. The post-event report includes counts for each ribbon, never names.",
  },
  {
    title: "A vendor packet sent with the prospectus.",
    body: "Our W-9, a certificate of insurance, and our 501(c)(3) letter are sent with the prospectus. The certificate of insurance can name your organization or agency as additional insured (proposed).",
  },
  {
    title: "Simple payment (proposed).",
    body: "Invoices go out by January. If you need a quote before the invoice for a purchase order, we'll send one. Public agencies can pay by purchase order.",
  },
  {
    title: "In-kind support is itemized separately (proposed).",
    body: "In-kind support, such as venue or Pop-up Meetup hosting, is itemized separately from cash sponsorship. In-kind support with an agreed written value counts toward Community recognition.",
  },
  {
    title: "Talks are never tied to sponsorship.",
    body: "Our call for speakers is open to sponsor engineers, and every talk is chosen on its own merits. Talks are never tied to sponsorship tier.",
  },
  {
    title: "No access to elected officials.",
    body: "Sponsorship buys no access to elected officials.",
  },
];

// The "Past years" menu sits between these two groups
const navLinksBeforeYears = [
  { href: "/#about", label: "About" },
  { href: "/#venue", label: "Venue" },
  { href: "/#testimonials", label: "Testimonials" },
];
const navLinksAfterYears = [
  { href: "/faq", label: "FAQ" },
  { href: "/sponsor", label: "Sponsor" },
];

const email = "kevin@revolutionva.org";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://hrdevfest.org/sponsor" />
    <meta property="og:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hrdevfest" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <GoogleAnalytics />
  </head>
  <body class="min-h-screen">
    <!-- Mobile hamburger button - outside the frame so it stays fixed -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bp-box bg-[var(--bp-paper)]" aria-label="Toggle menu">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bp-frame">
    <!-- Draft Banner -->
    <div id="draft-banner" role="note" class="w-full text-center py-4 pl-4 pr-16 md:px-4 border-b border-[var(--bp-line)]">
      <span class="inline-block border border-dashed border-[var(--bp-line)] px-4 py-2 bp-mono font-bold uppercase tracking-[0.12em] text-sm md:text-base">NOT FINAL: draft prospectus, details may change.</span>
    </div>

    <!-- Logo Bar (the hero below carries the date and place) -->
    <a href="/" class="block w-full py-4 pl-4 pr-16 md:px-4 border-b border-[var(--bp-line)]">
      <div class="flex justify-center">
        <Image src={logoWhite} alt="Hampton Roads DevFest home" class="h-14 w-auto" width={150} height={113} />
      </div>
    </a>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-[var(--bp-paper)] hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          {navLinksBeforeYears.map((link) => (
            <a href={link.href} class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
          <PastYearsNav variant="mobile" />
          {navLinksAfterYears.map((link) => (
            <a href={link.href} class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full py-4 px-4 md:px-8 border-b border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto flex items-center gap-6">
        <HeaderTagline />
        <div class="hidden md:flex flex-1 justify-center">
          <div class="flex items-center gap-6 lg:gap-10">
            {navLinksBeforeYears.map((link) => (
              <a href={link.href} class="bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
            ))}
            <PastYearsNav variant="desktop" />
            {navLinksAfterYears.map((link) => (
              <a
                href={link.href}
                class="bp-nav-link text-base font-bold leading-relaxed aria-[current=page]:underline"
                aria-current={link.href === "/sponsor" ? "page" : undefined}
              >{link.label}</a>
            ))}
          </div>
        </div>
        <div class="md:hidden h-6"></div>
      </div>
    </nav>

    <!-- Hero -->
    <section class="w-full">
      <div class="max-w-4xl mx-auto py-12 px-4 md:px-8 lg:py-20 flex flex-col items-center gap-4 text-center">
        <p class="bp-label text-sm">Sponsorship Prospectus</p>
        <h1 class="text-[32px] md:text-[48px] font-bold leading-[1.1]">Sponsor Hampton Roads DevFest 2027</h1>
        <p class="text-[18px] md:text-[22px] font-semibold leading-[1.3]">
          Friday, April 23, 2027 · Zeiders American Dream Theater · Virginia Beach, VA
        </p>
        <p class="max-w-2xl bp-muted text-base md:text-lg leading-relaxed">
          Presented by RevolutionVA, a 501(c)(3) nonprofit that builds the Hampton Roads tech community all year.
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-4 mt-2">
          <a href="#how-to-sponsor" class="px-8 py-3 btn-primary text-base">How to Sponsor</a>
          <a href="#at-a-glance" class="px-8 py-3 btn-secondary text-base">Compare tiers</a>
        </div>
      </div>
    </section>

    <!-- Why Sponsor -->
    <section id="why-sponsor" class="w-full py-10 px-4 md:px-8 lg:py-20 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto p-8 bp-box flex flex-col gap-4">
        <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Why sponsor DevFest</h2>
        <p class="text-lg font-semibold">Hampton Roads talent and excellence.</p>
        <p class="text-base leading-relaxed">
          Hampton Roads DevFest is the region's one-day developer conference, built to show what Hampton Roads developers can do. Local developers, engineers, veterans, and students come together to learn from each other, connect, and meet the companies building technology here. DevFest 2026 was a near sell out.
        </p>
        <p class="text-base font-bold">For 2027:</p>
        <ul class="flex flex-col gap-3 list-disc pl-6 text-base leading-relaxed">
          <li><strong>Local talent on stage.</strong> DevFest is single track, with 299 seats in one room. Every speaker is a keynote, and everyone sees every talk.</li>
          <li><strong>Showing what's built here.</strong> Talks cover a range of topics, including AI, alongside the rest of what Hampton Roads developers work on every day.</li>
          <li><strong>The Studio.</strong> An open room for hanging out and lunch, where many of the day's conversations happen.</li>
          <li><strong>Real time with attendees.</strong> Registration networking, two 30-minute breaks at the sponsor tables, and a 75-minute lunch.</li>
          <li><strong>The next generation of local talent.</strong> Many attendees come on Veteran and Student Scholarships, funded directly by sponsors. The Scholar Meetup at lunch, optional for scholars, connects them with the companies that sponsored their seats.</li>
        </ul>
      </div>
    </section>

    <!-- Privacy Promise -->
    <section id="privacy" class="w-full pb-10 px-4 md:px-8 lg:pb-20 scroll-mt-4">
      <div class="max-w-[1040px] mx-auto p-6 bp-box flex flex-col gap-2">
        <h2 class="text-xl md:text-2xl font-bold">Our privacy promise to attendees</h2>
        <p class="text-base leading-relaxed">
          Sponsor email opt-in is off by default. When attendees opt in, we include your message in our one post-event sponsor email, and attendee contacts are never handed to sponsors. We never sell attendee lists, and we never scan badges. <a href="#how-we-work" class="bp-link font-bold">How we work with sponsors</a>
        </p>
      </div>
    </section>

    <!-- The Day -->
    <section id="the-day" class="w-full pb-10 px-4 md:px-8 lg:pb-20 scroll-mt-4">
      <div class="max-w-[1040px] mx-auto p-8 bp-box flex flex-col gap-4">
        <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">The day</h2>
        <div class="overflow-x-auto">
          <table class="bp-table text-base">
            <thead>
              <tr>
                <th scope="col">Time</th>
                <th scope="col">What</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((item) => (
                <tr>
                  <td class="bp-mono whitespace-nowrap">{item.time}</td>
                  <td>{item.what}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="bp-muted text-sm leading-relaxed">
          Speakers are chosen through our open call for speakers. The two 15-minute sponsor talks are separate from the speaker lineup.
        </p>
      </div>
    </section>

    <!-- At a Glance -->
    <section id="at-a-glance" class="w-full py-10 px-4 md:px-8 lg:py-20 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-7xl mx-auto flex flex-col gap-6">
        <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10 text-center">Sponsorship at a glance</h2>
        <div class="overflow-x-auto">
          <table class="bp-table min-w-[900px] text-sm md:text-base">
            <thead>
              <tr>
                <th scope="col">Tier</th>
                <th scope="col">Price</th>
                <th scope="col">Available</th>
                <th scope="col">Table</th>
                <th scope="col">15-min talk</th>
                <th scope="col">Tickets</th>
                <th scope="col">757tech social posts (at least)</th>
                <th scope="col">Post-event report</th>
              </tr>
            </thead>
            <tbody>
              {glance.map((row) => (
                <tr>
                  <th scope="row" class="font-bold">{row.tier}</th>
                  <td class="bp-mono whitespace-nowrap">{row.price}</td>
                  <td>{row.available}</td>
                  <td>{row.table}</td>
                  <td>{row.talk ? "Yes" : ""}</td>
                  <td>{row.tickets}</td>
                  <td>{row.social}</td>
                  <td>{row.report ? "Yes" : ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="bp-muted text-sm leading-relaxed text-center">
          Sponsor tables are included at the Scholarship tier ($2,500) and above, and they are limited. The total number of tables: details coming soon.
        </p>
      </div>
    </section>

    <!-- Tier Details -->
    <section id="tiers" class="w-full py-10 px-4 md:px-8 lg:py-20 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10 text-center">Tier details</h2>
        <p class="text-base leading-relaxed text-center">
          <strong>Payment options:</strong> card, purchase order plus W-9, or in-kind. In-kind support, such as venue or Pop-up Meetup hosting, is itemized separately from cash sponsorship, and in-kind support with an agreed written value counts toward Community recognition (proposed).
        </p>
        {tiers.map((tier) => (
          <div id={tier.id} class="bp-box flex flex-col scroll-mt-4">
            <h3 class="p-6 md:px-8 pb-4 text-xl md:text-2xl font-bold border-b border-[var(--bp-line)]">
              {tier.name}: <span class="bp-mono">{tier.price}</span>{tier.available && <span class="bp-label text-sm"> ({tier.available})</span>}
            </h3>
            <div class="p-6 md:p-8 flex flex-col gap-3">
              {tier.tagline && <p class="text-base font-semibold">{tier.tagline}</p>}
              {tier.lead && <p class="text-base leading-relaxed">{tier.lead}</p>}
              <ul class="list-disc pl-6 flex flex-col gap-2 text-base leading-relaxed">
                {tier.benefits.map((benefit) => <li>{benefit}</li>)}
              </ul>
              {tier.quickPath && (
                <p class="text-base font-semibold">
                  Community? Just <a href={`mailto:${email}`} class="bp-link font-bold">email Kevin</a> and pay the invoice.
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Add-ons -->
    <section id="add-ons" class="w-full py-10 px-4 md:px-8 lg:py-20 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10 text-center">Add-ons</h2>
        <div class="overflow-x-auto">
          <table class="bp-table min-w-[640px] text-base">
            <thead>
              <tr>
                <th scope="col">Add-on</th>
                <th scope="col">Price</th>
                <th scope="col">Details</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row" class="font-bold">Pop-up Meetup host</th>
                <td>$500 per meetup, or $1,750 for all four 2027 Pop-ups</td>
