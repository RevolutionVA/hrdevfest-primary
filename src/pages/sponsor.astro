---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import BentoTracking from "../components/BentoTracking.astro";
import CanonicalLink from "../components/CanonicalLink.astro";
import PastYearsNav from "../components/PastYearsNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";
import FooterBridge from "../components/FooterBridge.astro";
import Callout from "../components/Callout.astro";
import { getEntry } from "astro:content";
import { testimonials } from "../data/testimonials";
import travisWebbImage from "../assets/testimonials/travis-webb.png";

// 2026 platinum and gold sponsors, shown on white plates next to the 2026 attendee list
const sponsorLogoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/sponsors/*", { eager: true });
const sponsorLogos: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(sponsorLogoFiles).map(([path, mod]) => [path.split("/").pop()!, mod.default])
);
const sponsors2026 = ((await getEntry("events", "2026/event"))?.data.sponsors ?? [])
  .filter((sponsor) => (sponsor.tier === "platinum" || sponsor.tier === "gold") && sponsorLogos[sponsor.logo]);

// The quote that speaks to companies sending their teams
const sponsorTestimonial = testimonials.find((t) => t.name === "Travis Webb");

// "Hold my package" form, posted to Bento as its own event (not the attendee signup event)
const BENTO_SPONSOR_FORM_ACTION =
  "https://track.bentonow.com/forms/57d9b8196b2b704a30da5ac245bf2cfe/$sponsorHoldHRDevFest?hardened=true";
const SPONSOR_THANK_YOU_URL = "https://hrdevfest.org/sponsor/thank-you";

const pageTitle = "Sponsor | Hampton Roads DevFest 2027";
const pageDescription = "Sponsorship prospectus for Hampton Roads DevFest 2027, Friday, April 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA. Presented by RevolutionVA, a 501(c)(3) nonprofit.";

interface ScheduleItem {
  time: string;
  what: string;
  sponsorTime?: boolean; // a moment sponsors are on, at a table, or being named
}

const schedule: ScheduleItem[] = [
  { time: "7:30", what: "Building opens, sponsor setup", sponsorTime: true },
  { time: "8:00", what: "Registration and networking at the sponsor tables", sponsorTime: true },
  { time: "9:00", what: "Opening, with the Presenting sponsor's 15 minutes of Sponsor Stage Time", sponsorTime: true },
  { time: "9:30", what: "Talk" },
  { time: "10:15", what: "Talk" },
  { time: "11:00", what: "Networking break at the sponsor tables", sponsorTime: true },
  { time: "11:30", what: "Talk" },
  { time: "12:15", what: "Lunch in the Studio", sponsorTime: true },
  { time: "1:30", what: "Main Stage sponsor's 15 minutes of Sponsor Stage Time", sponsorTime: true },
  { time: "1:45", what: "Talk" },
  { time: "2:30", what: "Networking break at the sponsor tables", sponsorTime: true },
  { time: "3:00", what: "Talk" },
  { time: "3:45", what: "Talk" },
  { time: "4:30", what: "Closing, then networking and sponsor teardown (building closes at 6:00)", sponsorTime: true },
  { time: "After conference closing", what: "Official DevFest Reception: venue and exact timing to be announced", sponsorTime: true },
];

const PROSPECTUS_PDF_HREF = "/sponsor/hrdevfest-2027-sponsor-sheet-2026-10-28.pdf";
const PROSPECTUS_PRINT_PDF_HREF = "/sponsor/hrdevfest-2027-sponsor-sheet-print-2026-10-28.pdf";

const COMMUNITY_CHECKOUT_HREF = "https://buy.stripe.com/cNi3cv4eG6CpcnP1b44AU06";
const COMMUNITY_CALLOUT_BULLETS = [
  "1 conference ticket",
  "Your logo on the website and event slides",
  "A group thank-you",
  "The post-event report",
];

