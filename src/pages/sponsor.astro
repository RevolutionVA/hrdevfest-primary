---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import headerDots from "../assets/dots/header_dots.svg";

const pageTitle = "Sponsor | Hampton Roads DevFest 2027";
const pageDescription = "Sponsorship prospectus for Hampton Roads DevFest 2027, Friday, April 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA. Presented by RevolutionVA, a 501(c)(3) nonprofit.";

interface ScheduleItem {
  time: string;
  what: string;
}

const schedule: ScheduleItem[] = [
  { time: "7:30", what: "Building opens, sponsor setup" },
  { time: "8:00", what: "Registration and networking at the sponsor tables" },
  { time: "9:00", what: "Opening, with the Presenting sponsor's 15-minute talk" },
  { time: "9:30", what: "Talk" },
  { time: "10:15", what: "Talk" },
  { time: "11:00", what: "Networking break at the sponsor tables" },
  { time: "11:30", what: "Talk" },
  { time: "12:15", what: "Lunch in the Studio" },
  { time: "12:45", what: "Scholar Meetup in the Studio" },
  { time: "1:30", what: "Main Stage sponsor's 15-minute talk" },
  { time: "1:45", what: "Talk" },
  { time: "2:30", what: "Networking break at the sponsor tables" },
  { time: "3:00", what: "Talk" },
  { time: "3:45", what: "Talk" },
  { time: "4:30", what: "Closing, then networking and sponsor teardown (building closes at 6:00)" },
];

interface GlanceRow {
  tier: string;
  price: string;
  available: string;
  table: string;
  talk: boolean;
  tickets: string;
  social: string;
  report: boolean;
}

const glance: GlanceRow[] = [
  { tier: "Presenting", price: "$10,000", available: "1", table: "Yes", talk: true, tickets: "12", social: "4 @HRDevFest + 2 organizer", report: true },
  { tier: "Main Stage", price: "$5,000", available: "1", table: "Yes", talk: true, tickets: "10", social: "3 @HRDevFest + 1 organizer", report: true },
  { tier: "Studio", price: "$3,500", available: "1", table: "Yes (in the Studio)", talk: false, tickets: "6", social: "3 @HRDevFest + 1 organizer", report: true },
  { tier: "Veteran Scholarship", price: "$2,500", available: "3", table: "Yes", talk: false, tickets: "4", social: "2 @HRDevFest", report: true },
  { tier: "Student Scholarship", price: "$2,500", available: "3", table: "Yes", talk: false, tickets: "4", social: "2 @HRDevFest", report: true },
  { tier: "Jobs Board", price: "$1,000", available: "Limited, details coming soon", table: "", talk: false, tickets: "2", social: "1 @HRDevFest", report: false },
  { tier: "Community", price: "$500", available: "Open", table: "", talk: false, tickets: "1", social: "Group thank-you", report: false },
];

interface Tier {
  id: string;
  name: string;
  price: string;
  available?: string;
  tagline?: string;
  lead?: string;
  benefits: string[];
  quickPath?: boolean;
}

const tiers: Tier[] = [
  {
    id: "presenting",
    name: "Presenting Sponsor",
    price: "$10,000",
    available: "1 available",
    tagline: "Your name on the event: \"Hampton Roads DevFest presented by [Your Company].\"",
    benefits: [
      "A 15-minute talk at the 9:00 opening, when the whole room is in their seats",
      "Top logo placement on the website, slides, and signage",
      "A sponsor table",
      "12 tickets",
      "A feature in the 757tech newsletter",
      "At least 4 @HRDevFest posts about your sponsorship: an announcement, a reminder, a day-of post, and a thank-you",
      "At least 2 organizer shoutouts: posts about your sponsorship from Kevin Griffin and Linda Nichols on their own channels",
      "Year-round Pop-up Meetup naming: your company names every quarterly 757tech Pop-up Meetup for 12 months, with 2 minutes at the start of each",
      "The post-event report",
    ],
  },
  {
    id: "main-stage",
    name: "Main Stage Sponsor",
    price: "$5,000",
    available: "1 available",
    tagline: "Your name on the room where every talk happens: \"The [Your Company] Main Stage.\"",
    benefits: [
      "A 15-minute talk at 1:30, right after lunch",
      "Main Stage naming on signage, slides, and the schedule",
      "A sponsor table",
      "10 tickets",
      "A feature in the 757tech newsletter",
      "At least 3 @HRDevFest posts about your sponsorship",
      "At least 1 organizer shoutout: a post about your sponsorship from Kevin Griffin or Linda Nichols on their own channels",
      "Year-round Pop-up Meetup naming (how this is shared with the Presenting sponsor: details coming soon)",
      "The post-event report",
    ],
  },
  {
    id: "studio",
    name: "Studio Sponsor",
    price: "$3,500",
    available: "1 available",
    tagline: "The room where everyone eats, hangs out, and talks: \"The [Your Company] Studio.\"",
    benefits: [
      "Naming of the Studio, the lunch and hangout room",
      "Signage in the Studio",
      "Your sponsor table inside the Studio",
      "6 tickets",
      "A mention in the 757tech newsletter",
      "At least 3 @HRDevFest posts about your sponsorship",
      "At least 1 organizer shoutout: a post about your sponsorship from Kevin Griffin or Linda Nichols on their own channels",
      "The post-event report",
    ],
  },
  {
    id: "scholarship",
    name: "Veteran Scholarship and Student Scholarship Sponsors",
    price: "$2,500 each",
    available: "3 of each available",
    tagline: "Your sponsorship funds scholarship seats.",
    lead: "Every dollar of the Scholarship tier pays for DevFest seats, named for your company as a Veteran Scholarship or a Student Scholarship. Scholarships are open to veterans, students, people who have been laid off, and career changers, with no proof of need required.",
    benefits: [
      "Named scholarship seats, funded by your sponsorship (number of seats: details coming soon)",
      "Meet your scholars at the Scholar Meetup (12:45, in the Studio). The meetup is optional for scholars.",
      "A sponsor table",
      "4 tickets for your team",
      "A mention in the 757tech newsletter",
      "At least 2 @HRDevFest posts: an announcement and a thank-you to your company",
      "Scholars are never named or labeled, in posts, on badges, or at the event",
      "The post-event report, including scholars who attended versus scholars funded",
    ],
  },
  {
    id: "jobs-board",
    name: "Jobs Board Sponsor",
    price: "$1,000",
    available: "limited, details coming soon",
    benefits: [
      "Your logo on the website and slides",
      "At least 1 @HRDevFest post about your sponsorship",
      "2 tickets",
      "Post your open roles on the DevFest jobs board (Jobs Board tier and up): full-time, internship, apprenticeship, and contract roles",
      "A one-page recap after the event: total attendance, the \"Looking for work\" ribbon count, role mix, and top tech stacks (proposed)",
    ],
  },
  {
    id: "community",
    name: "Community Sponsor",
    price: "$500",
    available: "open",
    benefits: [
      "Your logo on the website and slides",
      "1 ticket",
      "Included in a group @HRDevFest thank-you post",
    ],
    quickPath: true,
  },
];

const reportItems: string[] = [
  "Attendance and check-ins",
  "The mix of attendee roles and seniority",
  "Counts for all four opt-in ribbons: Hiring, Looking for work, Internship, and Open to contract work (counts only, never names)",
  "Counts by region, veterans, students, and tech stacks and languages (proposed)",
  "Optional anonymous totals for attendees who hold or are eligible for a security clearance, and for attendees transitioning from the military (proposed)",
  "Scholars who attended versus scholars funded (proposed)",
  "Newsletter and social reach",
  "Photos of your table or signage",
];

interface Commitment {
  title: string;
  body: string;
}

const commitments: Commitment[] = [
  {
    title: "Commit by December 15, 2026. Pay in January.",
    body: "Commit to your sponsorship by December 15, 2026 so we can include you in signage, slides, and announcements. Your invoice and payment can come in January 2027. A written intent to sponsor by December 15, 2026 counts as committed, with your purchase order or payment in January. Scholarship tiers are assigned in order of written intent and held for 30 days from your written intent to sponsor (proposed).",
  },
  {
    title: "Attendee privacy comes first.",
    body: "Sponsor email opt-in for attendees is off by default. When attendees opt in, RevolutionVA sends your email on your behalf, and attendee contacts are never handed to sponsors. How often sponsor emails go out: details coming soon. We never sell attendee lists, and we never scan badges.",
  },
  {
    title: "A one-page recap for Jobs Board sponsors (proposed).",
    body: "After DevFest, Jobs Board sponsors get a one-page recap covering total attendance, the \"Looking for work\" ribbon count, the mix of attendee roles, and the top tech stacks attendees work with.",
  },
  {
    title: "A jobs board for sponsor roles.",
    body: "Jobs Board tier sponsors and up can post full-time, internship, apprenticeship, and contract roles on the DevFest jobs board. Contract and freelance gigs and internships are welcome. Roles from recruiting agencies are clearly labeled as agency roles.",
  },
  {
    title: "Opt-in ribbons.",
    body: "Attendees can choose to wear Hiring, Looking for work, Internship, or Open to contract work ribbons. The post-event report includes counts for each ribbon, never names.",
  },
  {
    title: "A vendor packet sent with the prospectus.",
    body: "Our W-9, a certificate of insurance, and our 501(c)(3) letter are sent with the prospectus. The certificate of insurance can name your organization or agency as additional insured (proposed).",
  },
  {
    title: "Simple payment (proposed).",
    body: "Invoices go out by January. If you need a quote before the invoice for a purchase order, we'll send one. Public agencies can pay by purchase order.",
  },
  {
    title: "In-kind support is itemized separately (proposed).",
    body: "In-kind support, such as venue or Pop-up Meetup hosting, is itemized separately from cash sponsorship. In-kind support with an agreed written value counts toward Community recognition.",
  },
  {
    title: "Talks are never tied to sponsorship.",
    body: "Our call for speakers is open to sponsor engineers, and every talk is chosen on its own merits. Talks are never tied to sponsorship tier.",
  },
  {
    title: "No access to officials (proposed).",
    body: "Sponsorship buys no access to any government or military official.",
  },
];

const navLinks = [
  { href: "/#about", label: "About" },
  { href: "/#venue", label: "Venue" },
  { href: "/#testimonials", label: "Testimonials" },
  { href: "/years/2024", label: "2024" },
  { href: "/years/2026", label: "2026" },
  { href: "/faq", label: "FAQ" },
  { href: "/sponsor", label: "Sponsor" },
];

const email = "kevin@revolutionva.org";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://hrdevfest.org/sponsor" />
    <meta property="og:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hrdevfest" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Inter', sans-serif;
      }
      .card-asymmetric {
        border-top-left-radius: 40px;
        border-top-right-radius: 10px;
        border-bottom-right-radius: 40px;
        border-bottom-left-radius: 10px;
      }
      .card-shadow {
        box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.10);
      }
      .btn-primary {
        background: linear-gradient(0deg, #D33B32 0%, #D33B32 100%);
        border-radius: 100px;
        transition: all 0.3s ease;
      }
      .btn-primary:hover {
        filter: brightness(0.9);
        transform: scale(1.02);
      }
    </style>

    <GoogleAnalytics />
  </head>
  <body class="flex flex-col items-center min-h-screen bg-white text-gray-900">
    <div class="w-full max-w-[1920px] mx-auto bg-[#F3F4F6]">
    <!-- Draft Banner -->
    <div id="draft-banner" role="note" class="w-full bg-[#FACC15] text-black text-center py-4 pl-4 pr-16 md:px-4 border-b-4 border-black font-extrabold tracking-wide text-base md:text-xl">
      NOT FINAL: draft prospectus, details may change.
    </div>

    <!-- Save the Date Banner -->
    <a href="/#signup" class="block w-full bg-[#D33B32] text-white text-center py-3 pl-4 pr-16 md:px-4 font-bold text-sm md:text-base hover:brightness-95 transition-all">
      Hampton Roads DevFest returns April 23, 2027. Sign up for updates! 🎉
    </a>

    <!-- Mobile hamburger button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bg-[#052831] rounded-lg" aria-label="Toggle menu">
      <svg id="hamburger-icon" class="w-6 h-6 text-white transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 text-white hidden transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-white hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          {navLinks.map((link) => (
            <a href={link.href} class="mobile-menu-link text-black text-base font-bold leading-relaxed">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full bg-[#052831] py-4 px-8 lg:px-20">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-12 lg:gap-20">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity"
              aria-current={link.href === "/sponsor" ? "page" : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Hero -->
    <section class="w-full bg-gradient-to-br from-[#123F4E] to-[#052831] relative overflow-hidden">
      <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-20 pointer-events-none" />

      <div class="relative z-10 max-w-4xl mx-auto py-12 px-8 lg:py-20 flex flex-col items-center gap-4 text-center">
        <p class="text-[#4DB7B9] text-sm md:text-base font-bold uppercase tracking-wider">Sponsorship Prospectus</p>
        <h1 class="text-white text-[32px] md:text-[48px] font-bold leading-[1.1]">Sponsor Hampton Roads DevFest 2027</h1>
        <p class="text-white text-[18px] md:text-[24px] font-semibold leading-[1.3]">
          Friday, April 23, 2027 · Zeiders American Dream Theater · Virginia Beach, VA
        </p>
        <p class="max-w-2xl text-white/90 text-base md:text-lg leading-relaxed">
          Presented by RevolutionVA, a 501(c)(3) nonprofit that builds the Hampton Roads tech community all year.
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-4 mt-2">
          <a href="#how-to-sponsor" class="px-8 py-3 btn-primary text-white text-base font-bold">How to Sponsor</a>
          <a href="#at-a-glance" class="text-[#4DB7B9] text-base font-bold hover:underline">Compare tiers</a>
        </div>
      </div>
    </section>

    <!-- Why Sponsor -->
    <section id="why-sponsor" class="w-full py-10 px-8 lg:py-20 lg:px-[200px] bg-[#F3F4F6] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto p-8 bg-white card-shadow card-asymmetric flex flex-col gap-4">
        <h2 class="text-black text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Why sponsor DevFest</h2>
        <p class="text-black text-lg font-semibold">Hampton Roads talent and excellence.</p>
        <p class="text-black text-base leading-relaxed">
          Hampton Roads DevFest is the region's one-day developer conference, built to show what Hampton Roads developers can do. Local developers, engineers, veterans, and students come together to learn from each other, connect, and meet the companies building technology here.
        </p>
        <p class="text-black text-base font-bold">For 2027:</p>
        <ul class="flex flex-col gap-3 list-disc pl-6 text-black text-base leading-relaxed">
          <li><strong>Local talent on stage.</strong> DevFest is single track, with 299 seats in one room. Every speaker is a keynote, and everyone sees every talk.</li>
          <li><strong>Showing what's built here.</strong> Talks cover a range of topics, including AI, alongside the rest of what Hampton Roads developers work on every day.</li>
          <li><strong>The Studio.</strong> An open room for hanging out and lunch, where many of the day's conversations happen.</li>
          <li><strong>Real time with attendees.</strong> Registration networking, two 30-minute breaks at the sponsor tables, and a 75-minute lunch.</li>
          <li><strong>The next generation of local talent.</strong> Many attendees come on scholarships for veterans, students, people who have been laid off, and career changers, funded directly by sponsors. The Scholar Meetup at lunch, optional for scholars, connects them with the companies that sponsored their seats.</li>
        </ul>
      </div>
    </section>

    <!-- Privacy Promise -->
    <section id="privacy" class="w-full pb-10 px-8 lg:pb-20 lg:px-[200px] bg-[#F3F4F6] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto p-6 bg-[#052831] text-white card-shadow card-asymmetric flex flex-col gap-2">
        <h2 class="text-xl md:text-2xl font-bold">Our privacy promise to attendees</h2>
        <p class="text-base leading-relaxed">
          Sponsor email opt-in is off by default. When attendees opt in, RevolutionVA sends your email on your behalf, and attendee contacts are never handed to sponsors. We never sell attendee lists, and we never scan badges. <a href="#how-we-work" class="text-[#4DB7B9] font-bold underline hover:opacity-80">How we work with sponsors</a>
        </p>
      </div>
    </section>

    <!-- The Day -->
    <section id="the-day" class="w-full pb-10 px-8 lg:pb-20 lg:px-[200px] bg-[#F3F4F6] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto p-8 bg-white card-shadow card-asymmetric flex flex-col gap-4">
        <h2 class="text-black text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">The day</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-base">
            <thead>
              <tr class="border-b-2 border-[#052831]">
                <th scope="col" class="py-2 pr-6 font-bold text-black">Time</th>
                <th scope="col" class="py-2 font-bold text-black">What</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((item) => (
                <tr class="border-b border-gray-200">
                  <td class="py-2 pr-6 font-semibold text-black whitespace-nowrap">{item.time}</td>
                  <td class="py-2 text-black">{item.what}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-gray-700 text-sm leading-relaxed">
          Speakers are chosen through our open call for speakers. The two 15-minute sponsor talks are separate from the speaker lineup.
        </p>
      </div>
    </section>

    <!-- At a Glance -->
    <section id="at-a-glance" class="w-full py-10 px-8 lg:py-20 lg:px-20 bg-white scroll-mt-4">
      <div class="max-w-7xl mx-auto flex flex-col gap-6">
        <h2 class="text-black text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10 text-center">Sponsorship at a glance</h2>
        <div class="overflow-x-auto card-shadow rounded-[10px]">
          <table class="w-full min-w-[900px] text-left text-sm md:text-base bg-white">
            <thead class="bg-[#052831] text-white">
              <tr>
                <th scope="col" class="py-3 px-4 font-bold">Tier</th>
                <th scope="col" class="py-3 px-4 font-bold">Price</th>
                <th scope="col" class="py-3 px-4 font-bold">Available</th>
                <th scope="col" class="py-3 px-4 font-bold">Table</th>
                <th scope="col" class="py-3 px-4 font-bold">15-min talk</th>
                <th scope="col" class="py-3 px-4 font-bold">Tickets</th>
                <th scope="col" class="py-3 px-4 font-bold">Social posts (at least)</th>
                <th scope="col" class="py-3 px-4 font-bold">Post-event report</th>
              </tr>
            </thead>
            <tbody>
              {glance.map((row) => (
                <tr class="border-b border-gray-200 even:bg-[#F3F4F6]">
                  <th scope="row" class="py-3 px-4 font-bold text-black">{row.tier}</th>
                  <td class="py-3 px-4 text-black whitespace-nowrap">{row.price}</td>
                  <td class="py-3 px-4 text-black">{row.available}</td>
                  <td class="py-3 px-4 text-black">{row.table}</td>
                  <td class="py-3 px-4 text-black">{row.talk ? "Yes" : ""}</td>
                  <td class="py-3 px-4 text-black">{row.tickets}</td>
                  <td class="py-3 px-4 text-black">{row.social}</td>
                  <td class="py-3 px-4 text-black">{row.report ? "Yes" : ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-gray-700 text-sm leading-relaxed text-center">
          Sponsor tables are included at the Scholarship tier ($2,500) and above, and they are limited. The total number of tables: details coming soon.
        </p>
      </div>
    </section>

    <!-- Tier Details -->
    <section id="tiers" class="w-full py-10 px-8 lg:py-20 lg:px-[200px] bg-[#F3F4F6] relative scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <h2 class="text-black text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10 text-center">Tier details</h2>
        <p class="text-black text-base leading-relaxed text-center">
          <strong>Payment options:</strong> card, purchase order plus W-9, or in-kind. In-kind support, such as venue or Pop-up Meetup hosting, is itemized separately from cash sponsorship, and in-kind support with an agreed written value counts toward Community recognition (proposed).
        </p>
        {tiers.map((tier) => (
          <div id={tier.id} class="p-8 bg-white card-shadow card-asymmetric flex flex-col gap-3 relative overflow-hidden scroll-mt-4">
            <img src={headerDots.src} alt="" class="absolute right-0 bottom-0 h-16 w-auto opacity-20 pointer-events-none rotate-180" />
            <h3 class="text-black text-xl md:text-2xl font-bold relative z-10">
              {tier.name}: <span class="text-[#D33B32]">{tier.price}</span>{tier.available && <span class="text-gray-600 text-base md:text-lg font-semibold"> ({tier.available})</span>}
            </h3>
            {tier.tagline && <p class="text-black text-base font-semibold relative z-10">{tier.tagline}</p>}
            {tier.lead && <p class="text-black text-base leading-relaxed relative z-10">{tier.lead}</p>}
            <ul class="list-disc pl-6 flex flex-col gap-2 text-black text-base leading-relaxed relative z-10">
              {tier.benefits.map((benefit) => <li>{benefit}</li>)}
            </ul>
            {tier.quickPath && (
              <p class="text-black text-base font-semibold relative z-10">
