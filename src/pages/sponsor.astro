---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import BentoTracking from "../components/BentoTracking.astro";
import CanonicalLink from "../components/CanonicalLink.astro";
import PastYearsNav from "../components/PastYearsNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";
import FooterBridge from "../components/FooterBridge.astro";
import Callout from "../components/Callout.astro";
import { getEntry } from "astro:content";
import { testimonials } from "../data/testimonials";
import travisWebbImage from "../assets/testimonials/travis-webb.png";
import kristinaKrasnolobovaImage from "../assets/testimonials/kristina-krasnolobova.webp";
import {
  SPONSOR_SHEET_PDF_HREF,
  schedule,
  COMMUNITY_CHECKOUT_HREF,
  COMMUNITY_CALLOUT_BULLETS,
  glance,
  partnerships,
  faqItems,
  devfest2026Employers,
  email,
  whySponsorIntro,
  whySponsorBullets,
  for2027,
  packageIncludes,
  partnershipIncludes,
  scheduleNote,
} from "../data/sponsor";

// 2026 platinum and gold sponsors, shown on white plates next to the 2026 attendee list
const sponsorLogoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/sponsors/*", { eager: true });
const sponsorLogos: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(sponsorLogoFiles).map(([path, mod]) => [path.split("/").pop()!, mod.default])
);
const sponsors2026 = ((await getEntry("events", "2026/event"))?.data.sponsors ?? [])
  .filter((sponsor) => (sponsor.tier === "platinum" || sponsor.tier === "gold") && sponsorLogos[sponsor.logo]);

// The quote that speaks to companies sending their teams
const sponsorTestimonial = testimonials.find((t) => t.name === "Travis Webb");
const volunteerTestimonial = testimonials.find((t) => t.name === "Kristina Krasnolobova");

// "Inquire about Sponsorship" form, posted to Bento as its own event (not the attendee signup event)
const BENTO_SPONSOR_FORM_ACTION =
  "https://track.bentonow.com/forms/57d9b8196b2b704a30da5ac245bf2cfe/$sponsorHoldHRDevFest?hardened=true";
const SPONSOR_THANK_YOU_URL = "https://hrdevfest.org/sponsor/thank-you";

const pageTitle = "Sponsor | Hampton Roads DevFest 2027";
const pageDescription = "Sponsorship prospectus for Hampton Roads DevFest 2027, Apr 23, 2027, at Zeiders American Dream Theater in Virginia Beach, VA. Presented by RevolutionVA, a 501(c)(3) nonprofit.";

// The "Past years" menu sits between these two groups
const navLinksBeforeYears = [
  { href: "/#about", label: "About" },
  { href: "/#venue", label: "Venue" },
  { href: "/#testimonials", label: "Testimonials" },
];
const navLinksAfterYears = [
  { href: "/faq", label: "FAQ" },
  { href: "/sponsor", label: "Sponsor" },
];

const sections = [
  { id: "why-sponsor", title: "Why sponsor DevFest" },
  { id: "who-was-at-devfest-2026", title: "Who was at DevFest 2026?" },
  { id: "at-a-glance", title: "Core sponsorship packages" },
  { id: "partnerships", title: "Event & Community Partnerships" },
  { id: "the-day", title: "The day (tentative schedule)" },
  { id: "reserve", title: "Reserve your sponsorship" },
  { id: "sponsor-faq", title: "Sponsor FAQ" },
];

// Options for the "Inquire about Sponsorship" form
const packageOptions = [
  ...glance.filter((row) => !row.checkoutHref).map((row) => `${row.package} (${row.price})`),
  ...partnerships.map((partner) => `${partner.name} (${partner.price})`),
  "Not sure yet",
];


---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://hrdevfest.org/sponsor" />
    <CanonicalLink href="https://hrdevfest.org/sponsor" />
    <meta property="og:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hrdevfest" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://hrdevfest.org/2027/og_promo_2027.jpg" />

    <GoogleAnalytics />
    <BentoTracking />
  </head>
  <body class="min-h-screen">
    <!-- Mobile hamburger button - outside the frame so it stays fixed -->
    <button id="mobile-menu-btn" class="md:hidden p-2.5 fixed top-4 right-4 z-[60] bp-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="square" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="square" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bp-frame">

    <!-- Logo Bar (the hero below carries the date and place) -->
    <a href="/" class="block w-full py-4 pl-4 pr-16 md:px-4 border-b border-[var(--bp-line)]">
      <div class="flex justify-center">
        <Image src={logoWhite} alt="Hampton Roads DevFest home" class="h-24 md:h-28 w-auto" width={300} height={225} />
      </div>
    </a>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-[var(--bp-paper)] hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          {navLinksBeforeYears.map((link) => (
            <a href={link.href} class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
          <PastYearsNav variant="mobile" />
          {navLinksAfterYears.map((link) => (
            <a href={link.href} class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full py-4 px-4 md:px-8 border-b border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-6 lg:gap-10">
          {navLinksBeforeYears.map((link) => (
            <a href={link.href} class="bp-nav-link text-base font-bold leading-relaxed">{link.label}</a>
          ))}
          <PastYearsNav variant="desktop" />
          {navLinksAfterYears.map((link) => (
            <a
              href={link.href}
              class="bp-nav-link text-base font-bold leading-relaxed aria-[current=page]:underline"
              aria-current={link.href === "/sponsor" ? "page" : undefined}
            >{link.label}</a>
          ))}
        </div>
      </div>
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Hero: cover sheet. Title on the left, the plan on the right. -->
    <section class="w-full px-4 md:px-8 py-10 lg:py-16">
      <div class="max-w-[1120px] mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] gap-10 lg:gap-14 items-center">
        <div class="flex flex-col gap-4">
          <p class="bp-label text-sm">Sponsorship prospectus</p>
          <h1 class="text-[32px] md:text-[48px] font-bold leading-[1.08]">Sponsor Hampton Roads DevFest 2027</h1>
          <p class="text-lg md:text-xl font-semibold leading-snug">
            Apr 23, 2027<br />Zeiders American Dream Theater, Virginia Beach
          </p>
          <p class="bp-muted text-base md:text-lg leading-relaxed max-w-[42ch]">
            One day. One track. Meet developers and technology teams from across Hampton&nbsp;Roads.
          </p>
          <p class="bp-muted text-sm leading-relaxed max-w-[48ch]">
            Presented by RevolutionVA, a 501(c)(3) nonprofit.
          </p>
          <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-start gap-3 mt-2">
            <a href="#reserve" class="px-8 py-3 btn-primary text-base whitespace-nowrap w-full sm:w-auto min-h-12 justify-center">Become a Sponsor</a>
            <a href="#at-a-glance" class="px-8 py-3 btn-secondary text-base whitespace-nowrap w-full sm:w-auto min-h-12 justify-center">Compare packages</a>
            <a
              href={SPONSOR_SHEET_PDF_HREF}
              download
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-3 btn-secondary text-base whitespace-nowrap w-full sm:w-auto min-h-12 justify-center"
            >Download PDF</a>
          </div>
        </div>

        <!-- Plan diagram: what each tier puts its name on -->
        <figure class="bp-box p-5 md:p-6 flex flex-col gap-5" aria-label="Plan of the day's spaces: the event, Main Stage, the Studio, and Registration.">
          <div class="relative pt-5 pr-5">
            <!-- 1: the event -->
            <div class="bp-room border-solid border-[var(--bp-line)] p-3 md:p-4">
              <p class="bp-mono text-xs md:text-sm tracking-[0.08em] uppercase mb-3">Hampton Roads DevFest presented by [Your Company]</p>

              <div class="grid grid-cols-[3fr_2fr] gap-3 md:gap-4">
                <!-- 2: Main Stage -->
                <div class="bp-room p-3 md:p-4 min-h-[13rem] md:min-h-[15rem] flex flex-col">
                  <p class="font-bold leading-tight">Main Stage</p>
                  <div class="mt-auto pt-5 flex flex-col items-center gap-1 md:gap-1.5 overflow-hidden">
                    <!-- Theater seating: back rows widest, rows bow toward the stage at the edges -->
                    {Array.from({ length: 8 }).map((_, row) => {
                      const seats = 14 - Math.floor(row / 2);
                      const mid = (seats - 1) / 2;
                      return (
                        <div class="flex gap-[3px] md:gap-1" aria-hidden="true">
                          {Array.from({ length: seats }).map((_, i) => (
                            <span
                              class:list={[
                                "w-1.5 h-1.5 md:w-2 md:h-2 bg-[var(--bp-line-faint)]",
                                (i < 2 || i >= seats - 2) && "hidden sm:block",
                              ]}
                              style={`transform: translateY(${(((i - mid) / mid) ** 2 * 3).toFixed(1)}px)`}
                            ></span>
                          ))}
                        </div>
                      );
                    })}
                    <div class="mt-3 w-[70%] h-8 border border-[var(--bp-line)] flex items-center justify-center">
                      <p class="bp-label">Stage</p>
                    </div>
                  </div>
                </div>

                <div class="flex flex-col gap-3 md:gap-4">
                  <!-- 3: Studio -->
                  <div class="bp-room p-3 md:p-4 flex-1 flex flex-col">
                    <p class="font-bold leading-tight">The Studio</p>
                  </div>
                  <!-- 4: Registration -->
                  <div class="bp-room p-3 md:p-4 flex-1 flex flex-col">
                    <p class="font-bold leading-tight">Registration</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </figure>
      </div>
    </section>

    <!-- Sheet index -->
    <section id="index" class="w-full px-4 md:px-8 pb-10 lg:pb-16">
      <nav class="max-w-[1120px] mx-auto bp-box" aria-label="Sections of this prospectus">
        <p class="bp-label px-5 py-3 border-b border-[var(--bp-line)]">On this page</p>
        <ol class="grid grid-cols-1 md:grid-cols-2 md:[&>li:nth-child(odd)]:border-r md:[&>li]:border-[var(--bp-line-faint)]">
          {sections.map((section) => (
            <li class="border-b border-[var(--bp-line-faint)] md:[&:nth-last-child(-n+2)]:border-b-0 last:border-b-0">
              <a href={`#${section.id}`} class="block px-5 py-2.5 bp-nav-link hover:bg-[var(--bp-paper-deep)]">
                <span class="text-base font-semibold">{section.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>

    <!-- Why Sponsor -->
    <section id="why-sponsor" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Why sponsor DevFest</h2>
        </div>
        <p class="text-base md:text-lg leading-relaxed max-w-[64ch]">{whySponsorIntro}</p>
        <ul class="pl-5 list-disc flex flex-col gap-1.5 text-base leading-relaxed max-w-[72ch]">
          {whySponsorBullets.map((item) => <li>{item}</li>)}
        </ul>
        <div class="bp-surface max-w-[72ch]">
          <p class="bp-label mb-3">For 2027</p>
          <ul class="flex flex-col divide-y divide-[var(--bp-line-faint)] border-y border-[var(--bp-line-faint)] text-base leading-relaxed">
            {for2027.map((item) => <li class="py-3"><strong>{item.label}</strong> {item.text}</li>)}
          </ul>
        </div>
        <p class="text-base leading-relaxed">
          Payment, privacy and deadlines: see the <a href="#sponsor-faq" class="bp-link font-bold">Sponsor FAQ</a>.
        </p>
      </div>
    </section>

    <!-- Who was at DevFest 2026 -->
    <section id="who-was-at-devfest-2026" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4" aria-label="Who was at DevFest 2026">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Who was at DevFest 2026?</h2>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-base leading-relaxed bp-muted">Attendees came from teams at:</p>
          <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-1.5 text-base leading-snug">
            {devfest2026Employers.map((name) => (
              <li class="min-w-0">{name}</li>
            ))}
            <li class="min-w-0 italic">And more&hellip;</li>
          </ul>
        </div>
        {sponsors2026.length > 0 && (
          <div class="flex flex-col gap-3">
            <p class="text-base leading-relaxed bp-muted">Our 2026 sponsors included:</p>
            <ul class="flex flex-wrap items-center gap-3">
              {sponsors2026.map((sponsor) => (
                <li>
                  <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="bp-plate px-3 py-2 flex items-center min-h-11">
                    <Image src={sponsorLogos[sponsor.logo]} alt={sponsor.name} class={sponsor.tier === "platinum" ? "h-12 w-auto object-contain" : "h-8 w-auto object-contain"} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {sponsorTestimonial && (
          <figure class="bp-box p-5 md:p-6 flex flex-col sm:flex-row gap-4 sm:items-start max-w-[72ch]">
            <Image src={travisWebbImage} alt="" class="bp-photo w-16 h-16 object-cover shrink-0" width={64} height={64} />
            <div class="flex flex-col gap-3">
              <blockquote class="text-base leading-relaxed">
                <p>&ldquo;{sponsorTestimonial.quote}&rdquo;</p>
              </blockquote>
              <figcaption class="text-base">
                <span class="font-bold">{sponsorTestimonial.name}</span><span class="bp-muted">, {sponsorTestimonial.role}</span>
              </figcaption>
            </div>
          </figure>
        )}
        {volunteerTestimonial && (
          <figure class="bp-box p-5 md:p-6 flex flex-col sm:flex-row gap-4 sm:items-start max-w-[72ch]">
            <Image src={kristinaKrasnolobovaImage} alt={volunteerTestimonial.name} class="bp-photo w-16 h-16 object-cover shrink-0" width={64} height={64} />
            <div class="flex flex-col gap-3">
              <blockquote class="text-base leading-relaxed">
                <p>&ldquo;{volunteerTestimonial.quote}&rdquo;</p>
              </blockquote>
              <figcaption class="text-base">
                <span class="font-bold">{volunteerTestimonial.name}</span><span class="bp-muted">, {volunteerTestimonial.role}</span>
              </figcaption>
            </div>
          </figure>
        )}
      </div>
    </section>

    <!-- Community $500: one-line pointer; the full callout follows the core packages -->
    <section class="w-full px-4 md:px-8 py-6 border-t border-[var(--bp-line)]" aria-label="Community Sponsor for $500">
      <p class="max-w-[1040px] mx-auto text-base leading-relaxed">
        <strong>Small team?</strong> Community sponsorship is $500, paid online. <a href="#community" class="bp-link font-bold inline-flex min-h-11 items-center">See Community</a>
      </p>
    </section>


    <!-- Core packages -->
    <section id="at-a-glance" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Core sponsorship packages</h2>
        </div>
        <div class="md:hidden flex flex-col gap-4">
          {glance.map((row) => (
            <article class="bp-box p-5 flex flex-col gap-3">
              <div class="min-w-0">
                <h3 class="text-lg font-bold leading-tight">{row.package}</h3>
                <p class="bp-mono text-xl font-bold mt-1">{row.price}</p>
              </div>
              <ul class="flex flex-col divide-y divide-[var(--bp-line-faint)] border-y border-[var(--bp-line-faint)] text-base leading-relaxed">
                <li class="py-2.5"><span class="bp-label">Available</span> {row.available}</li>
                <li class="py-2.5"><span class="bp-label">Tickets for your team</span> {row.tickets}</li>
                <li class="py-2.5">
                  <span class="bp-label">Additional benefits</span>
                  <ul class="mt-1.5 pl-5 list-disc flex flex-col gap-1">
                    {row.benefits.map((benefit) => (
                      <li>{benefit}</li>
                    ))}
                  </ul>
                </li>
              </ul>
              {row.checkoutHref && (
                <p class="text-base leading-relaxed">
                  Paid online at checkout. <a href="#community" class="bp-link font-bold inline-flex min-h-11 items-center">See Community</a>
                </p>
              )}
            </article>
          ))}
        </div>

        <div class="hidden md:block overflow-x-auto">
          <table class="bp-table min-w-[880px]">
            <thead>
              <tr>
                <th scope="col">Package</th>
                <th scope="col">Price</th>
                <th scope="col">Available</th>
                <th scope="col">Tickets for your team</th>
                <th scope="col">Additional benefits</th>
              </tr>
            </thead>
            <tbody>
              {glance.map((row) => (
                <tr>
                  <th scope="row" class="font-bold whitespace-nowrap">{row.package}</th>
                  <td class="bp-mono whitespace-nowrap">{row.price}</td>
                  <td>{row.available}</td>
                  <td>{row.tickets}</td>
                  <td class="leading-snug">
                    <ul class="flex flex-col gap-1 list-disc m-0 pl-5">
                      {row.benefits.map((benefit) => (
                        <li>{benefit}</li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <!-- What every package includes: short lists, under the table -->
        <div class="grid gap-6 md:grid-cols-2 max-w-[880px]">
          <div>
            <h3 class="text-base font-bold leading-snug">{packageIncludes.every.title}</h3>
            <ul class="mt-2 pl-5 list-disc flex flex-col gap-1.5 text-base leading-relaxed">
              {packageIncludes.every.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="text-base font-bold leading-snug">{packageIncludes.tableTiers.title}</h3>
            <ul class="mt-2 pl-5 list-disc flex flex-col gap-1.5 text-base leading-relaxed">
              {packageIncludes.tableTiers.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        <!-- Community $500: the one full callout -->
        <div id="community" class="mt-2 md:mt-0 mx-[5px] scroll-mt-6">
          <Callout
            heading="Small team? Sponsor for $500."
            bullets={COMMUNITY_CALLOUT_BULLETS}
            afterBullets="Pay online by card or bank transfer."
            buttonLabel="Sponsor at Community ($500)"
            buttonLabelShort="Community ($500)"
            buttonHref={COMMUNITY_CHECKOUT_HREF}
          />
        </div>

        <!-- How to sponsor: right after the packages, so the next step is next -->
        <div class="bp-box p-6 md:p-8 flex flex-col gap-4">
          <h3 class="text-[20px] lg:text-[24px] font-bold leading-7 lg:leading-8">How to sponsor</h3>
          <ol class="list-decimal pl-6 flex flex-col gap-2 text-base leading-relaxed max-w-[72ch]">
            <li><strong>Choose a package or partnership.</strong> Partnerships are below.</li>
            <li><strong>Reserve it.</strong> Use the <a href="#reserve" class="bp-link font-bold">reservation form</a> or email <a href={`mailto:${email}`} class="bp-link font-bold">{email}</a>. We confirm your payment date. Community ($500) uses the checkout button above.</li>
            <li><strong>Send logo files</strong> by Apr 1, 2027. Specs are in the <a href="#sponsor-faq" class="bp-link font-bold">Sponsor FAQ</a>.</li>
            <li><strong>Assign your team's tickets.</strong></li>
          </ol>
        </div>
      </div>
    </section>

    <!-- Partnerships: compact -->
    <section id="partnerships" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Event &amp; Community Partnerships</h2>
        </div>
        <div class="md:hidden flex flex-col gap-4">
          {partnerships.map((partner) => (
            <article class="bp-box p-5 flex flex-col gap-3">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="text-base font-bold leading-tight">{partner.name}</h3>
                <p class="bp-mono font-bold whitespace-nowrap">{partner.price}</p>
              </div>
              <p class="bp-label">{partner.available}</p>
              <p class="text-base leading-relaxed"><span class="bp-label">Tickets for your team</span> {partner.tickets}</p>
              <ul class="pl-5 list-disc text-base leading-relaxed flex flex-col gap-1">
                {partner.benefits.map((benefit) => (
                  <li>
                    {partner.linkLabel && partner.linkHref && benefit.includes(partner.linkLabel) ? (
                      <>
                        {benefit.split(partner.linkLabel)[0]}
                        <a href={partner.linkHref} class="bp-link font-bold">{partner.linkLabel}</a>
                        {benefit.split(partner.linkLabel)[1]}
                      </>
                    ) : benefit}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="hidden md:block overflow-x-auto">
          <table class="bp-table text-base">
            <thead>
              <tr>
                <th scope="col">Partnership</th>
                <th scope="col">Price</th>
                <th scope="col">Available</th>
                <th scope="col">Tickets for your team</th>
                <th scope="col">Includes</th>
              </tr>
            </thead>
            <tbody>
              {partnerships.map((partner) => (
                <tr>
                  <th scope="row" class="font-bold whitespace-nowrap">{partner.name}</th>
                  <td class="bp-mono whitespace-nowrap">{partner.price}</td>
                  <td>{partner.available}</td>
                  <td>{partner.tickets}</td>
                  <td class="leading-snug">
                    <ul class="flex flex-col gap-1 list-disc m-0 pl-5">
                      {partner.benefits.map((benefit) => (
                        <li>
                          {partner.linkLabel && partner.linkHref && benefit.includes(partner.linkLabel) ? (
                            <>
                              {benefit.split(partner.linkLabel)[0]}
                              <a href={partner.linkHref} class="bp-link font-bold">{partner.linkLabel}</a>
                              {benefit.split(partner.linkLabel)[1]}
                            </>
                          ) : benefit}
                        </li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <!-- How partnerships work: short lists, under the table -->
        <div class="grid gap-6 md:grid-cols-2 max-w-[880px]">
          <div>
            <h3 class="text-base font-bold leading-snug">{partnershipIncludes.every.title}</h3>
            <ul class="mt-2 pl-5 list-disc flex flex-col gap-1.5 text-base leading-relaxed">
              {partnershipIncludes.every.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="text-base font-bold leading-snug">{partnershipIncludes.notes.title}</h3>
            <ul class="mt-2 pl-5 list-disc flex flex-col gap-1.5 text-base leading-relaxed">
              {partnershipIncludes.notes.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#reserve" class="px-8 py-3 btn-primary text-base whitespace-nowrap min-h-12">Become a Sponsor</a>
        </div>
      </div>
    </section>

    <!-- The Day -->
    <section id="the-day" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">The day (tentative schedule)</h2>
        </div>
        <!-- Mobile: one ruled row per slot, so the sponsor-time flag never scrolls off-screen -->
        <ol class="md:hidden bp-surface flex flex-col divide-y divide-[var(--bp-line-faint)] border border-[var(--bp-line-soft)]">
          {schedule.map((item) => (
            <li class="grid grid-cols-[4.5rem_1fr] gap-x-3 gap-y-1 px-3 py-2.5">
              <span class:list={["bp-mono text-base leading-snug", item.time.length > 5 && "col-span-2"]}>{item.time}</span>
              <div class:list={["min-w-0 flex flex-col gap-1", item.time.length > 5 && "col-start-2"]}>
                <span class:list={["text-base leading-snug", item.sponsorTime && "font-semibold"]}>{item.what}</span>
                {item.sponsorTime && <span class="bp-label"><span aria-hidden="true">■ </span>Sponsor time</span>}
              </div>
            </li>
          ))}
        </ol>
        <div class="hidden md:block overflow-x-auto">
          <table class="bp-table text-base">
            <thead>
              <tr>
                <th scope="col" class="w-[7rem]">Time</th>
                <th scope="col">What</th>
                <th scope="col" class="w-[7.5rem] whitespace-nowrap">Sponsor time</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((item) => (
                <tr>
                  <td class="bp-mono">{item.time}</td>
                  <td class:list={[item.sponsorTime && "font-semibold"]}>{item.what}</td>
                  <td class="bp-mono text-center">{item.sponsorTime ? <><span aria-hidden="true">■</span><span class="sr-only">Sponsor time</span></> : ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="bp-muted text-sm leading-relaxed">
          {scheduleNote}
        </p>
      </div>
    </section>

    <!-- Reserve: "Inquire about Sponsorship" form, posted to Bento -->
    <section id="reserve" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Reserve your sponsorship</h2>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-8 lg:gap-12 items-start">
          <form id="sponsor-hold-form" action={BENTO_SPONSOR_FORM_ACTION} method="POST" enctype="multipart/form-data" class="bp-box p-5 md:p-8 flex flex-col gap-4">
            <input type="hidden" name="redirect" value={SPONSOR_THANK_YOU_URL} data-redirect-path="/sponsor/thank-you" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="flex flex-col gap-1.5">
                <span class="bp-label">First name</span>
                <input type="text" name="fields_first_name" required autocomplete="given-name" class="bp-input px-4 py-3 text-base" />
              </label>
              <label class="flex flex-col gap-1.5">
                <span class="bp-label">Last name</span>
                <input type="text" name="fields_last_name" required autocomplete="family-name" class="bp-input px-4 py-3 text-base" />
              </label>
            </div>
            <label class="flex flex-col gap-1.5">
              <span class="bp-label">Work email</span>
              <input type="email" name="email" required autocomplete="email" class="bp-input px-4 py-3 text-base" />
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="bp-label">Company</span>
              <input type="text" name="fields_company" required autocomplete="organization" class="bp-input px-4 py-3 text-base" />
            </label>
            <label class="flex flex-col gap-1.5">
              <span class="bp-label">Package or partnership</span>
              <select name="fields_package" required class="bp-input bp-select px-4 py-3 text-base">
                <option value="" disabled selected>Choose one</option>
                {packageOptions.map((option) => <option value={option}>{option}</option>)}
              </select>
            </label>
            <!-- Newsletter opt-in: the hidden "no" is dropped on submit when the box is checked -->
            <input type="hidden" name="fields_newsletter_opt_in" value="no" data-newsletter-default />
            <label class="inline-flex items-center gap-2 min-h-11 text-base">
              <input type="checkbox" name="fields_newsletter_opt_in" value="yes" class="bp-check" data-newsletter-opt-in />
              <span>Add me to the <a href="https://757tech.org" target="_blank" rel="noopener" class="bp-link font-bold">757tech</a> newsletter</span>
            </label>
            <!-- Honeypot: hidden from people; if a bot fills it, the script skips Bento -->
            <div class="sr-only" aria-hidden="true">
              <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" data-honeypot /></label>
            </div>
            <div class="flex flex-col gap-3 pt-2">
              <button type="submit" class="px-8 py-3 btn-primary text-base min-h-12 w-full sm:w-auto sm:self-start">Inquire about Sponsorship</button>
              <p class="text-xs bp-muted">By submitting, you agree to our <a href="https://revolutionva.org/privacy/" target="_blank" rel="noopener" class="bp-link">Privacy Policy</a>.</p>
            </div>
          </form>
          <div class="flex flex-col gap-5">
            <div class="flex flex-col gap-2">
              <p class="bp-label">What happens next</p>
              <ul class="flex flex-col divide-y divide-[var(--bp-line-faint)] border-y border-[var(--bp-line-faint)] text-base leading-relaxed">
                <li class="py-2.5">We email you to confirm your package and payment date.</li>
                <li class="py-2.5">We hold your sponsorship for 30 days. Need longer for approvals? Ask and we'll extend it.</li>
                <li class="py-2.5">Nothing is charged when you submit this form.</li>
              </ul>
            </div>
            <div class="flex flex-col gap-2">
              <p class="bp-label">Prefer email?</p>
              <p class="text-base leading-relaxed">
                Write <a href="mailto:team@revolutionva.org?subject=DevFest%202027%20Sponsorship" class="bp-link font-bold select-all">{email}</a>.
              </p>
            </div>
            <p class="text-base leading-relaxed">
              Community ($500) is paid online. <a href="#community" class="bp-link font-bold inline-flex min-h-11 items-center">See Community</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sponsor FAQ -->
    <section id="sponsor-faq" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Sponsor FAQ</h2>
        </div>
        <ol id="payment-options" class="bp-surface flex flex-col divide-y divide-[var(--bp-line-faint)] border-y border-[var(--bp-line-faint)] scroll-mt-4">
          {faqItems.map((item, i) => (
            <li>
              <details class="bp-faq group" open={item.open}>
                <summary class="grid grid-cols-[3.5rem_1fr_auto] gap-x-2 items-baseline py-4 min-h-11 cursor-pointer list-none">
                  <span class="bp-sheet-ref">{String(i + 1).padStart(2, "0")}</span>
                  <h3 class="text-base font-bold">{item.title}</h3>
                  <span class="bp-mono text-base bp-muted" aria-hidden="true"><span class="group-open:hidden">+</span><span class="hidden group-open:inline">&minus;</span></span>
                </summary>
                <div class="grid grid-cols-[3.5rem_1fr] gap-x-2 pb-4">
                  <div class="col-start-2 max-w-[72ch] flex flex-col gap-3 text-base leading-relaxed">
                    {item.paragraphs.map((text) => <p>{text}</p>)}
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Questions -->
    <section id="questions" class="w-full py-10 px-4 md:px-8 lg:py-16">
      <div class="max-w-3xl mx-auto flex flex-col items-center gap-3 text-center">
        <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Questions?</h2>
        <p class="text-base leading-relaxed">
          Email us at <a href={`mailto:${email}`} class="bp-link font-bold">{email}</a>. We're happy to talk through which package fits your team.
        </p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="relative isolate overflow-hidden w-full py-8 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <FooterBridge />
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center md:items-end gap-8">
        <div class="flex flex-col items-center md:items-start gap-4">
          <!-- Branding -->
          <p class="text-base font-normal leading-relaxed text-center md:text-left">
            Hampton Roads DevFest is presented by RevolutionVA, a 501(c)(3) nonprofit.
          </p>

          <!-- Social Links -->
          <div class="flex gap-9">
            <a href="https://x.com/hrdevfest" target="_blank" rel="noopener noreferrer" class="bp-nav-link p-2.5 -m-2.5 inline-flex" aria-label="Follow us on X/Twitter">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.750H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href="https://www.linkedin.com/company/revolutionva/" target="_blank" rel="noopener noreferrer" class="bp-nav-link p-2.5 -m-2.5 inline-flex" aria-label="Follow us on LinkedIn">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://www.facebook.com/profile.php?id=61584002302188" target="_blank" rel="noopener noreferrer" class="bp-nav-link p-2.5 -m-2.5 inline-flex" aria-label="Follow us on Facebook">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.830c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          </div>

          <!-- Quick Links -->
          <div class="flex flex-wrap justify-center md:justify-start gap-x-5 text-sm">
            <a href="/faq" class="bp-link inline-flex items-center min-h-11">FAQ</a>
            <a href="/sponsor" class="bp-link inline-flex items-center min-h-11">Sponsor</a>
            <a href="/code-of-conduct" class="bp-link inline-flex items-center min-h-11">Code of Conduct</a>
          </div>
        </div>
        <TitleBlock />
      </div>
    </footer>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Mobile menu toggle
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');
        const menuLinks = document.querySelectorAll('.mobile-menu-link');
        let isOpen = false;

        function toggleMenu() {
          isOpen = !isOpen;
          if (isOpen) {
            mobileMenu?.classList.remove('hidden');
            menuBtn?.setAttribute('aria-expanded', 'true');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu?.classList.add('hidden');
            menuBtn?.setAttribute('aria-expanded', 'false');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        menuBtn?.addEventListener('click', toggleMenu);

        menuLinks.forEach(link => {
          link.addEventListener('click', () => {
            if (isOpen) toggleMenu();
          });
        });

        // Honeypot: a filled trap skips Bento; an empty one is left out of the post
        const holdForm = document.getElementById('sponsor-hold-form') as HTMLFormElement | null;

        // Bento needs an absolute redirect; point it at this host so previews stay on the preview
        const redirectInput = holdForm?.querySelector<HTMLInputElement>('[data-redirect-path]');
        if (redirectInput?.dataset.redirectPath) {
          redirectInput.value = new URL(redirectInput.dataset.redirectPath, window.location.origin).href;
        }

        holdForm?.addEventListener('submit', (event) => {
          const trap = holdForm.querySelector<HTMLInputElement>('[data-honeypot]');
          if (!trap) return;
          if (trap.value.trim() !== '') {
            event.preventDefault();
            window.location.href = '/sponsor/thank-you';
            return;
          }
          trap.disabled = true;

          // Send exactly one newsletter value: "yes" if checked, otherwise "no"
          const optIn = holdForm.querySelector<HTMLInputElement>('[data-newsletter-opt-in]');
          const optInDefault = holdForm.querySelector<HTMLInputElement>('[data-newsletter-default]');
          if (optIn && optInDefault) optInDefault.disabled = optIn.checked;
        });

        // Close menu on Escape and return focus to the button
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && isOpen) {
            toggleMenu();
            menuBtn?.focus();
          }
        });
      });
    </script>
  </body>
</html>
