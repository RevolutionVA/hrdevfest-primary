    <!-- The Day -->
    <section id="the-day" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">The day</h2>
        </div>
        <!-- Mobile: one ruled row per slot, so the sponsor-time flag never scrolls off-screen -->
        <ol class="md:hidden bp-surface flex flex-col divide-y divide-[var(--bp-line-faint)] border border-[var(--bp-line-soft)]">
          {schedule.map((item) => (
            <li class="grid grid-cols-[4.5rem_1fr] gap-x-3 gap-y-1 px-3 py-2.5">
              <span class:list={["bp-mono text-base leading-snug", item.time.length > 5 && "col-span-2"]}>{item.time}</span>
              <div class:list={["min-w-0 flex flex-col gap-1", item.time.length > 5 && "col-start-2"]}>
                <span class:list={["text-base leading-snug", item.sponsorTime && "font-semibold"]}>{item.what}</span>
                {item.sponsorTime && <span class="bp-label"><span aria-hidden="true">■ </span>Sponsor time</span>}
              </div>
            </li>
          ))}
        </ol>
        <div class="hidden md:block overflow-x-auto">
          <table class="bp-table text-base">
            <thead>
              <tr>
                <th scope="col" class="w-[7rem]">Time</th>
                <th scope="col">What</th>
                <th scope="col" class="w-[7.5rem] whitespace-nowrap">Sponsor time</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((item) => (
                <tr>
                  <td class="bp-mono">{item.time}</td>
                  <td class:list={[item.sponsorTime && "font-semibold"]}>{item.what}</td>
                  <td class="bp-mono text-center">{item.sponsorTime ? <><span aria-hidden="true">■</span><span class="sr-only">Sponsor time</span></> : ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="bp-muted text-sm leading-relaxed">This schedule is subject to change.</p>
        <p class="bp-muted text-sm leading-relaxed">
          Sponsor time is any part of the day when sponsors are speaking, at their tables, or hosting a room.
        </p>
      </div>
    </section>

    <!-- Reserve: "Hold my package" form, posted to Bento -->
    <section id="reserve" class="w-full py-10 px-4 md:px-8 lg:py-16 border-t border-[var(--bp-line)] scroll-mt-4">
      <div class="max-w-[1040px] mx-auto flex flex-col gap-6">
        <div class="flex items-baseline gap-4 border-b border-[var(--bp-line)] pb-3">
          <h2 class="text-[24px] lg:text-[32px] font-bold leading-8 lg:leading-10">Reserve your sponsorship</h2>
        </div>
