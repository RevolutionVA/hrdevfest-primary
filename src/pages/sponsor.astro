                              {benefit.split(partner.linkLabel)[0]}
                              <a href={partner.linkHref} class="bp-link font-bold">{partner.linkLabel}</a>
                              {benefit.split(partner.linkLabel)[1]}
                            </>
                          ) : benefit}
                        </li>
                      ))}
                    </ul>
                  </td>
                </tr>
