---
import { Image } from "astro:assets";
import logoWhite from "../../../assets/logo-white.png";
import header2024 from "../../../assets/header_2024.png";
import headerDots from "../../../assets/dots/header_dots.svg";

// Import 2024 event photos
import photo1 from "../../../assets/2024-photos/2024-05-31 08.30.41.jpg";
import photo2 from "../../../assets/2024-photos/2024-05-31 09.48.48.jpg";
import photo3 from "../../../assets/2024-photos/2024-05-31 12.04.00.jpg";
import photo4 from "../../../assets/2024-photos/2024-05-31 12.11.53.jpg";
import photo5 from "../../../assets/2024-photos/2024-05-31 14.13.46.jpg";

// Photo data with captions
const photos = [
  { src: photo1, caption: "Attendees arriving at the venue" },
  { src: photo2, caption: "Morning keynote session" },
  { src: photo3, caption: "Lunch and networking" },
  { src: photo4, caption: "Workshop in progress" },
  { src: photo5, caption: "Panel discussion" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hampton Roads DevFest 2024 | Event Highlights</title>
    <link href="/dist/index.css" rel="stylesheet" />
  </head>
  <body class="flex flex-col min-h-screen bg-gray-100 text-gray-900">
    <!-- Mobile hamburger button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60]" aria-label="Toggle menu">
      <svg id="hamburger-icon" class="w-6 h-6 text-white transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 text-black hidden transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-white hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          <a href="/#tickets" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Buy Tickets</a>
          <a href="/#about" class="mobile-menu-link text-black text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Venue</a>
          <a href="/speakers" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Speakers</a>
          <a href="/#testimonials" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Testimonials</a>
          <a href="/years/2024" class="mobile-menu-link text-black text-base font-bold leading-relaxed">2024</a>
          <a href="/#faq" class="mobile-menu-link text-black text-base font-bold leading-relaxed">FAQ</a>
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full bg-[#052831] py-4 px-8 lg:px-20">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-12 lg:gap-20">
          <a href="/#tickets" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Buy Tickets</a>
          <a href="/#about" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">About</a>
          <a href="/#venue" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Venue</a>
          <a href="/speakers" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Speakers</a>
          <a href="/#testimonials" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Testimonials</a>
          <a href="/years/2024" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">2024</a>
          <a href="/#faq" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">FAQ</a>
        </div>
      </div>
      <!-- Mobile nav placeholder for hamburger positioning -->
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Header Section with Event Highlights and 2024 Image -->
    <section class="w-full bg-white relative overflow-hidden">
      <!-- Background dots - anchored to left -->
      <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

      <div class="relative z-10 flex flex-col items-center py-10 px-8 lg:px-[280px] md:px-8">
        <!-- Event Highlights Title and Description -->
        <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center mb-10">
          <h1 class="text-black text-[24px] md:text-[32px] font-bold leading-8 md:leading-10">
            Event Highlights
          </h1>
          <p class="text-black text-base font-normal leading-relaxed">
            Take a look back at Hampton Roads DevFest 2024! Our 5th annual event brought together local developers, industry professionals, and tech enthusiasts for a day of learning and networking.
          </p>
        </div>

        <!-- 2024 Header Image - Responsive sizes -->
        <Image
          src={header2024}
          alt="2024"
          class="w-[250px] md:w-[500px] lg:w-[763px] h-auto"
        />
      </div>
    </section>

    <!-- Photo Gallery -->
    <section class="w-full bg-gray-100 py-10 px-8 lg:px-10">
      <div class="max-w-7xl mx-auto">
        <!-- Responsive grid: 1 col mobile, 2 col tablet, 3 col desktop -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {photos.map((photo, index) => (
            <div class="flex flex-col rounded-[10px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.1)] overflow-hidden photo-card" data-index={index}>
              <!-- Photo with asymmetric top corners -->
              <div class="h-[160px] lg:h-[256px] relative rounded-tl-[40px] rounded-tr-[10px] overflow-hidden">
                <Image
                  src={photo.src}
                  alt={photo.caption}
                  class="absolute inset-0 w-full h-full object-cover"
                />
              </div>
              <!-- Caption with asymmetric bottom corners -->
              <div class="bg-white p-4 rounded-bl-[10px] rounded-br-[40px]">
                <p class="text-black text-sm font-normal leading-6">
                  {photo.caption}
                  <span class="text-[#3361c9] text-xs ml-1">(</span><button class="text-[#3361c9] text-xs underline enlarge-btn" data-index={index}>Enlarge Photo</button><span class="text-[#3361c9] text-xs">)</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 2024 Schedule Section -->
    <section class="w-full py-10 px-8 bg-white relative overflow-hidden">
      <!-- Background dots - anchored to left -->
      <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

      <div class="max-w-4xl mx-auto flex flex-col gap-6 relative z-10">
        <h2 class="text-[24px] md:text-[32px] font-bold text-black text-center">
          2024 Schedule
        </h2>
        <p class="text-black text-base font-normal leading-relaxed text-center">
          All sessions took place in the Main Auditorium on May 31, 2024.
        </p>
        <div class="flex flex-col gap-4">
          <!-- Session 1 -->
          <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              1:15 PM – 2:00 PM
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">You Really Should Look at the Execution Plan</p>
              <p class="text-sm text-gray-600">Monica Morehouse (Rathbun)</p>
              <p class="text-sm text-gray-700 mt-2">Learn to gather and read execution plans, understand query operators, and improve database performance through plan analysis.</p>
            </div>
          </div>

          <!-- Session 2 -->
          <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              2:15 PM – 3:00 PM
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">Is Gen AI the killer app, or the final boss?</p>
              <p class="text-sm text-gray-600">Travis Webb</p>
              <p class="text-sm text-gray-700 mt-2">Explores whether generative AI will reshape technology markets or follow historical patterns of overhyped innovations.</p>
            </div>
          </div>

          <!-- Session 3 -->
          <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              3:15 PM – 4:00 PM
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">How love lessons can land you a great job</p>
              <p class="text-sm text-gray-600">Chazona Baum</p>
              <p class="text-sm text-gray-700 mt-2">Apply relationship-building principles to job searching, showing communication can be your greatest job-seeking superpower.</p>
            </div>
          </div>

          <!-- Session 4 -->
          <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              4:45 PM – 5:30 PM
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">How to Lose an App in 60 seconds</p>
              <p class="text-sm text-gray-600">Michael Buckbee</p>
              <p class="text-sm text-gray-700 mt-2">Practical web security strategies based on real-world attacks covering threat identification and prevention.</p>
            </div>
          </div>

          <!-- Session 5 -->
          <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              5:45 PM – 6:30 PM
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">Empowering Efficiency at a National Lab through Low Code Solutions</p>
              <p class="text-sm text-gray-600">Jenah Parman & Marla Schuchman</p>
              <p class="text-sm text-gray-700 mt-2">Case study of a low-code grant management system developed at Jefferson Lab.</p>
            </div>
          </div>

          <!-- Session 6 -->
          <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              6:45 PM – 7:30 PM
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">The Rise of AI Copilots</p>
              <p class="text-sm text-gray-600">Ken Collins</p>
              <p class="text-sm text-gray-700 mt-2">Guide to implementing AI assistants using semantic interfaces and modern software architecture.</p>
            </div>
          </div>

          <!-- Session 7 -->
          <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              7:45 PM – 8:30 PM
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">The Day of Learning: Amplifying L&D</p>
              <p class="text-sm text-gray-600">Omar McNeil</p>
              <p class="text-sm text-gray-700 mt-2">Transform organizational learning programs using agile principles and data-driven strategies.</p>
            </div>
          </div>

          <!-- Session 8 -->
          <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
            <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
              8:45 PM – 9:30 PM
            </div>
            <div class="flex-1">
              <p class="font-semibold text-black">Managing On-Call Chaos</p>
              <p class="text-sm text-gray-600">Guillermo Fisher</p>
              <p class="text-sm text-gray-700 mt-2">Strategies to optimize on-call rotations, communication, scheduling, and post-mortems to reduce burnout.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2024 Speakers Section -->
    <section class="w-full py-10 px-8 bg-[#F3F4F6]">
      <div class="max-w-7xl mx-auto flex flex-col gap-10">
        <!-- Header -->
        <div class="flex flex-col gap-2 text-center lg:px-[280px]">
          <h2 class="text-black text-[24px] md:text-[32px] font-semibold md:font-bold leading-8 md:leading-10">
            2024 Speakers
          </h2>
          <p class="text-black text-base font-normal leading-relaxed">
            Meet the amazing speakers who shared their knowledge at Hampton Roads DevFest 2024.
          </p>
        </div>

        <!-- Speakers Grid -->
        <div class="flex flex-col lg:grid lg:grid-cols-3 gap-8">
          <!-- Chazona Baum -->
          <div class="bg-white p-6 md:p-8 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.1)] flex flex-col md:flex-row lg:flex-col gap-4 items-center">
            <img
              src="https://sessionize.com/image/7315-400o400o1-YpS113ikSWsdK8K3KHsw23.png"
              alt="Chazona Baum"
              class="w-[100px] h-[100px] rounded-full object-cover shrink-0"
            />
            <div class="flex flex-col gap-4 w-full">
              <p class="text-[24px] font-semibold text-black text-center md:text-left lg:text-center">Chazona Baum</p>
              <p class="text-sm text-gray-600 text-center md:text-left lg:text-center">Founder at Tingles Labs</p>
              <p class="text-base font-normal text-black leading-relaxed">
                Self-taught engineer who transitioned from veterinary, tax, and insurance work to tech. Observing frustrations in recruiting systems, she's building an improved dating-like platform for jobseekers.
              </p>
              <div class="flex items-center gap-4 justify-center md:justify-start lg:justify-center">
                <a href="https://www.linkedin.com/in/chazonabaum/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0077B5] hover:opacity-80">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  <span class="text-sm font-medium">LinkedIn</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Guillermo Fisher -->
          <div class="bg-white p-6 md:p-8 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.1)] flex flex-col md:flex-row lg:flex-col gap-4 items-center">
            <img
              src="https://sessionize.com/image/3919-400o400o1-YWrj9vFGi2MPTugaMZq86p.jpg"
              alt="Guillermo Fisher"
              class="w-[100px] h-[100px] rounded-full object-cover shrink-0"
            />
            <div class="flex flex-col gap-4 w-full">
              <p class="text-[24px] font-semibold text-black text-center md:text-left lg:text-center">Guillermo Fisher</p>
              <p class="text-sm text-gray-600 text-center md:text-left lg:text-center">Fractional CTO</p>
              <p class="text-base font-normal text-black leading-relaxed">
                Two decades of experience in driving organizational innovation and cultivating high-performing software engineering teams.
              </p>
              <div class="flex items-center gap-4 justify-center md:justify-start lg:justify-center">
                <a href="https://www.linkedin.com/in/guillermofisher/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0077B5] hover:opacity-80">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  <span class="text-sm font-medium">LinkedIn</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Ken Collins -->
          <div class="bg-white p-6 md:p-8 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.1)] flex flex-col md:flex-row lg:flex-col gap-4 items-center">
            <img
              src="https://sessionize.com/image/ba13-400o400o1-hMqZRiMq985nP1FZCz1Nfg.jpg"
              alt="Ken Collins"
              class="w-[100px] h-[100px] rounded-full object-cover shrink-0"
            />
            <div class="flex flex-col gap-4 w-full">
              <p class="text-[24px] font-semibold text-black text-center md:text-left lg:text-center">Ken Collins</p>
              <p class="text-sm text-gray-600 text-center md:text-left lg:text-center">Principal Engineer & GenAI R&D at Custom Ink</p>
              <p class="text-base font-normal text-black leading-relaxed">
                AWS Serverless Hero and AI industry analyst & researcher merging technical expertise with strategic business insights.
              </p>
              <div class="flex items-center gap-4 justify-center md:justify-start lg:justify-center">
                <a href="https://www.linkedin.com/in/metaskills/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0077B5] hover:opacity-80">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  <span class="text-sm font-medium">LinkedIn</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Michael Buckbee -->
          <div class="bg-white p-6 md:p-8 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.1)] flex flex-col md:flex-row lg:flex-col gap-4 items-center">
            <img
              src="https://sessionize.com/image/b0c4-400o400o1-L8qnWhL2upTUZo5aZ2zsVC.jpg"
              alt="Michael Buckbee"
              class="w-[100px] h-[100px] rounded-full object-cover shrink-0"
            />
            <div class="flex flex-col gap-4 w-full">
              <p class="text-[24px] font-semibold text-black text-center md:text-left lg:text-center">Michael Buckbee</p>
              <p class="text-sm text-gray-600 text-center md:text-left lg:text-center">Founder, Expedited Security</p>
              <p class="text-base font-normal text-black leading-relaxed">
                Long-time Rails developer who built secure applications for the U.S. Navy and Fortune 100 companies, helping thousands recover from attacks.
              </p>
              <div class="flex items-center gap-4 justify-center md:justify-start lg:justify-center">
                <a href="https://www.linkedin.com/in/michaelbuckbee/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[#0077B5] hover:opacity-80">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  <span class="text-sm font-medium">LinkedIn</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Monica Morehouse -->
