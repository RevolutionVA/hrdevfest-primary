---
import { Image } from "astro:assets";
import logoWhite from "../../../assets/logo-white.png";
import header2024 from "../../../assets/header_2024.png";
import headerDots from "../../../assets/dots/header_dots.svg";

// Import 2024 event photos
import photo1 from "../../../assets/2024-photos/2024-05-31 08.30.41.jpg";
import photo2 from "../../../assets/2024-photos/2024-05-31 09.48.48.jpg";
import photo3 from "../../../assets/2024-photos/2024-05-31 12.04.00.jpg";
import photo4 from "../../../assets/2024-photos/2024-05-31 12.11.53.jpg";
import photo5 from "../../../assets/2024-photos/2024-05-31 14.13.46.jpg";

// Photo data with captions
const photos = [
  { src: photo1, caption: "Attendees arriving at the venue" },
  { src: photo2, caption: "Morning keynote session" },
  { src: photo3, caption: "Lunch and networking" },
  { src: photo4, caption: "Workshop in progress" },
  { src: photo5, caption: "Panel discussion" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Hampton Roads DevFest 2024 | Event Highlights</title>
    <link href="/dist/index.css" rel="stylesheet" />
  </head>
  <body class="flex flex-col min-h-screen bg-gray-100 text-gray-900">
    <!-- Mobile hamburger button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60]" aria-label="Toggle menu">
      <svg id="hamburger-icon" class="w-6 h-6 text-white transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 text-black hidden transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-white hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          <a href="/#tickets" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Buy Tickets</a>
          <a href="/#about" class="mobile-menu-link text-black text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Venue</a>
          <a href="/#speakers" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Speakers</a>
          <a href="/#testimonials" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Testimonials</a>
          <a href="/years/2024" class="mobile-menu-link text-black text-base font-bold leading-relaxed">2024</a>
          <a href="/#faq" class="mobile-menu-link text-black text-base font-bold leading-relaxed">FAQ</a>
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full bg-[#052831] py-4 px-8 lg:px-20">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-12 lg:gap-20">
          <a href="/#tickets" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Buy Tickets</a>
          <a href="/#about" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">About</a>
          <a href="/#venue" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Venue</a>
          <a href="/#speakers" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Speakers</a>
          <a href="/#testimonials" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Testimonials</a>
          <a href="/years/2024" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">2024</a>
          <a href="/#faq" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">FAQ</a>
        </div>
      </div>
      <!-- Mobile nav placeholder for hamburger positioning -->
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Header Section with Event Highlights and 2024 Image -->
    <section class="w-full bg-white relative overflow-hidden">
      <!-- Background dots - anchored to left -->
      <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

      <div class="relative z-10 flex flex-col items-center py-10 px-8 lg:px-[280px] md:px-8">
        <!-- Event Highlights Title and Description -->
        <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center mb-10">
          <h1 class="text-black text-[24px] md:text-[32px] font-bold leading-8 md:leading-10">
            Event Highlights
          </h1>
          <p class="text-black text-base font-normal leading-relaxed">
            Take a look back at Hampton Roads DevFest 2024! Our 5th annual event brought together local developers, industry professionals, and tech enthusiasts for a day of learning and networking.
          </p>
        </div>

        <!-- 2024 Header Image - Responsive sizes -->
        <Image
          src={header2024}
          alt="2024"
          class="w-[250px] md:w-[500px] lg:w-[763px] h-auto"
        />
      </div>
    </section>

    <!-- Photo Gallery -->
    <section class="w-full bg-gray-100 py-10 px-8 lg:px-10">
      <div class="max-w-7xl mx-auto">
        <!-- Responsive grid: 1 col mobile, 2 col tablet, 3 col desktop -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {photos.map((photo, index) => (
            <div class="flex flex-col rounded-[10px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.1)] overflow-hidden photo-card" data-index={index}>
              <!-- Photo with asymmetric top corners -->
              <div class="h-[160px] lg:h-[256px] relative rounded-tl-[40px] rounded-tr-[10px] overflow-hidden">
                <Image
                  src={photo.src}
                  alt={photo.caption}
                  class="absolute inset-0 w-full h-full object-cover"
                />
              </div>
              <!-- Caption with asymmetric bottom corners -->
              <div class="bg-white p-4 rounded-bl-[10px] rounded-br-[40px]">
                <p class="text-black text-sm font-normal leading-6">
                  {photo.caption}
                  <span class="text-[#3361c9] text-xs ml-1">(</span><button class="text-[#3361c9] text-xs underline enlarge-btn" data-index={index}>Enlarge Photo</button><span class="text-[#3361c9] text-xs">)</span>
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Photo Modal -->
    <div id="photo-modal" class="fixed inset-0 z-[100] bg-black/80 hidden items-center justify-center p-4">
      <button id="modal-close" class="absolute top-4 right-4 text-white text-4xl font-light hover:opacity-80">&times;</button>
      <button id="modal-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl font-light hover:opacity-80 p-2">&larr;</button>
      <button id="modal-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-4xl font-light hover:opacity-80 p-2">&rarr;</button>
      <div class="max-w-5xl max-h-[90vh] flex flex-col items-center">
        <img id="modal-image" src="" alt="" class="max-w-full max-h-[80vh] object-contain" />
        <p id="modal-caption" class="text-white text-center mt-4 text-lg"></p>
      </div>
    </div>

    <!-- Footer -->
    <footer class="w-full bg-[#052831] py-4 px-8 lg:px-20 mt-auto">
      <p class="text-white text-base font-normal leading-relaxed text-center">
        Hampton Roads DevFest is presented by RevolutionVA, a 501c3 organization.
      </p>
    </footer>

    <script>
      // Mobile menu functionality
      document.addEventListener('DOMContentLoaded', function() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');
        const menuLinks = document.querySelectorAll('.mobile-menu-link');
        let isOpen = false;

        function toggleMenu() {
          isOpen = !isOpen;
          if (isOpen) {
            mobileMenu?.classList.remove('hidden');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu?.classList.add('hidden');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        menuBtn?.addEventListener('click', toggleMenu);

        menuLinks.forEach(link => {
          link.addEventListener('click', () => {
            if (isOpen) toggleMenu();
          });
        });

        // Photo modal functionality
        const modal = document.getElementById('photo-modal');
        const modalImage = document.getElementById('modal-image') as HTMLImageElement;
        const modalCaption = document.getElementById('modal-caption');
        const modalClose = document.getElementById('modal-close');
        const modalPrev = document.getElementById('modal-prev');
        const modalNext = document.getElementById('modal-next');
        const enlargeBtns = document.querySelectorAll('.enlarge-btn');
        const photoCards = document.querySelectorAll('.photo-card');

        // Get photo data from DOM
        const photos: { src: string; caption: string }[] = [];
        photoCards.forEach((card) => {
          const img = card.querySelector('img') as HTMLImageElement;
          const caption = card.querySelector('p')?.textContent?.split('(')[0].trim() || '';
          if (img) {
            photos.push({ src: img.src, caption });
          }
        });

        let currentIndex = 0;

        function showPhoto(index: number) {
          if (photos[index]) {
            currentIndex = index;
            if (modalImage) modalImage.src = photos[index].src;
            if (modalCaption) modalCaption.textContent = photos[index].caption;
          }
        }

        function openModal(index: number) {
          showPhoto(index);
          modal?.classList.remove('hidden');
          modal?.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          modal?.classList.add('hidden');
          modal?.classList.remove('flex');
          document.body.style.overflow = '';
        }

        enlargeBtns.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const index = parseInt((btn as HTMLElement).dataset.index || '0');
            openModal(index);
          });
        });

        photoCards.forEach((card) => {
          const img = card.querySelector('.relative');
          img?.addEventListener('click', () => {
            const index = parseInt((card as HTMLElement).dataset.index || '0');
            openModal(index);
          });
        });

        modalClose?.addEventListener('click', closeModal);

        modalPrev?.addEventListener('click', () => {
          const newIndex = currentIndex > 0 ? currentIndex - 1 : photos.length - 1;
          showPhoto(newIndex);
        });

        modalNext?.addEventListener('click', () => {
          const newIndex = currentIndex < photos.length - 1 ? currentIndex + 1 : 0;
          showPhoto(newIndex);
        });

        // Close on background click
        modal?.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
          if (modal?.classList.contains('hidden')) return;

          if (e.key === 'Escape') closeModal();
          if (e.key === 'ArrowLeft') {
            const newIndex = currentIndex > 0 ? currentIndex - 1 : photos.length - 1;
            showPhoto(newIndex);
          }
          if (e.key === 'ArrowRight') {
            const newIndex = currentIndex < photos.length - 1 ? currentIndex + 1 : 0;
            showPhoto(newIndex);
          }
        });
      });
    </script>

    <style>
      .photo-card .relative {
        cursor: pointer;
      }
      .photo-card .relative:hover {
        opacity: 0.9;
      }
    </style>
  </body>
</html>
