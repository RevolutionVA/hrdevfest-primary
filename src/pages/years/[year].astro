---
import "../../styles/global.css";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import PastYearsNav from "../../components/PastYearsNav.astro";
import headerDots from "../../assets/dots/header_dots.svg";
import sponsorBkgd from "../../assets/sponsor_bkgd.png";
import edition2015 from "../../data/archive/2015.json";
import edition2016 from "../../data/archive/2016.json";
import edition2017 from "../../data/archive/2017.json";
import edition2018 from "../../data/archive/2018.json";

interface ArchiveSpeaker {
  name: string;
  bio: string;
  image: string;
  linkedin?: string;
  twitter?: string;
  bluesky?: string;
  github?: string;
  mastodon?: string;
  website?: string;
}

interface ArchiveScheduleItem {
  time: string;
  title: string;
  description: string;
  track?: string;
}

interface ArchiveSponsor {
  name: string;
  logo: string;
  url: string;
}

interface ArchiveEdition {
  year: number;
  title: string;
  dateFormatted: string;
  description: string;
  venue: { name: string; address: string; city: string; state: string; zip: string };
  speakers: ArchiveSpeaker[];
  schedule: ArchiveScheduleItem[];
  sponsors: ArchiveSponsor[];
}

export function getStaticPaths() {
  const editions: ArchiveEdition[] = [edition2015, edition2016, edition2017, edition2018];
  return editions.map((edition) => ({
    params: { year: String(edition.year) },
    props: { edition },
  }));
}

const { edition } = Astro.props as { edition: ArchiveEdition };
const { year, title, dateFormatted, description, venue, speakers, schedule, sponsors } = edition;

// Speaker photos and sponsor logos live under src/assets/archive/<year>/; JSON paths are relative to src/assets
const archiveImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/archive/**/*.{png,jpg,jpeg}",
  { eager: true }
);
const archiveImage = (path: string) => (path ? archiveImages[`../../assets/${path}`]?.default : undefined);

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0].toUpperCase())
    .join("");

const venueLine = [venue.address, venue.city, [venue.state, venue.zip].filter(Boolean).join(" ")]
  .filter(Boolean)
  .join(", ");

const socialLinks = (speaker: ArchiveSpeaker) =>
  [
    { label: "LinkedIn", href: speaker.linkedin },
    { label: "X", href: speaker.twitter },
    { label: "Bluesky", href: speaker.bluesky },
    { label: "GitHub", href: speaker.github },
    { label: "Mastodon", href: speaker.mastodon },
    { label: "Website", href: speaker.website },
  ].filter((link): link is { label: string; href: string } => Boolean(link.href));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{`${title} | Event Highlights`}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Event Highlights`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://hrdevfest.org/years/${year}`} />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Inter', sans-serif;
      }
      .card-asymmetric {
        border-top-left-radius: 40px;
        border-top-right-radius: 10px;
        border-bottom-right-radius: 40px;
        border-bottom-left-radius: 10px;
      }
    </style>

    <GoogleAnalytics />
  </head>
  <body class="flex flex-col items-center min-h-screen bg-white text-gray-900">
    <div class="w-full max-w-[1920px] mx-auto bg-gray-100">
    <!-- Mobile hamburger button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bg-[#052831] rounded-lg" aria-label="Toggle menu">
      <svg id="hamburger-icon" class="w-6 h-6 text-white transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 text-white hidden transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-white hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          <a href="/#about" class="mobile-menu-link text-black text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Venue</a>
          <a href="/#testimonials" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Testimonials</a>
          <PastYearsNav variant="mobile" />
          <a href="/faq" class="mobile-menu-link text-black text-base font-bold leading-relaxed">FAQ</a>
          <a href="/sponsor" class="mobile-menu-link text-black text-base font-bold leading-relaxed">Sponsor</a>
          <a href="/#signup" class="mobile-menu-link text-[#D33B32] text-base font-bold leading-relaxed">Sign Up</a>
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full bg-[#052831] py-4 px-8 lg:px-20">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-12 lg:gap-20">
          <a href="/#about" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">About</a>
          <a href="/#venue" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Venue</a>
          <a href="/#testimonials" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Testimonials</a>
          <PastYearsNav variant="desktop" />
          <a href="/faq" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">FAQ</a>
          <a href="/sponsor" class="text-white text-base font-bold leading-relaxed hover:opacity-80 transition-opacity">Sponsor</a>
          <a href="/#signup" class="text-[#4DB7B9] text-base font-bold leading-relaxed hover:text-white transition-colors">Sign Up</a>
        </div>
      </div>
      <!-- Mobile nav placeholder for hamburger positioning -->
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Header Section -->
    <section class="w-full bg-white relative overflow-hidden">
      <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

      <div class="relative z-10 flex flex-col items-center py-10 px-8 lg:px-[280px] md:px-8">
        <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center">
          <h1 class="text-black text-[24px] md:text-[32px] font-bold leading-8 md:leading-10">
            {title}
          </h1>
          <p class="text-[#D33B32] text-base font-bold leading-relaxed">{dateFormatted}</p>
          <p class="text-black text-base font-normal leading-relaxed">{description}</p>
        </div>
      </div>
    </section>

    <!-- Venue Section -->
    <section id="venue" class="w-full py-10 px-8 bg-[#F3F4F6]">
      <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center">
        <h2 class="text-[24px] md:text-[32px] font-bold text-black">Venue</h2>
        <p class="text-black text-lg font-semibold leading-relaxed">{venue.name}</p>
        {venueLine && <p class="text-black text-base font-normal leading-relaxed">{venueLine}</p>}
      </div>
    </section>

    <!-- Schedule Section -->
    {schedule.length > 0 && (
      <section class="w-full py-10 px-8 bg-white relative overflow-hidden">
        <img src={headerDots.src} alt="" class="absolute left-0 top-0 h-full w-auto opacity-30 pointer-events-none" />

        <div class="max-w-4xl mx-auto flex flex-col gap-6 relative z-10">
          <h2 class="text-[24px] md:text-[32px] font-bold text-black text-center">
            {year} Schedule
          </h2>
          <div class="flex flex-col gap-4">
            {schedule.map((item) => (
              <div class="bg-[#F3F4F6] p-6 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] flex flex-col md:flex-row gap-4">
                <div class="text-[#D33B32] font-bold whitespace-nowrap text-center md:text-left min-w-[140px]">
                  {item.time}
                </div>
                <div class="flex-1">
                  <p class="font-semibold text-black">{item.title}</p>
                  {item.description && (
                    <p class="text-sm text-gray-600">{item.description}</p>
                  )}
                  {item.track && item.track !== "All" && (
                    <p class="text-xs font-semibold uppercase tracking-wide text-[#4DB7B9] mt-2">{item.track}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Speakers Section -->
    {speakers.length > 0 && (
      <section class="w-full py-10 px-8 bg-[#F3F4F6]">
        <div class="max-w-7xl mx-auto flex flex-col gap-10">
          <div class="flex flex-col gap-2 text-center lg:px-[280px]">
            <h2 class="text-black text-[24px] md:text-[32px] font-semibold md:font-bold leading-8 md:leading-10">
              {year} Speakers
            </h2>
            <p class="text-black text-base font-normal leading-relaxed">
              Meet the local speakers who shared their knowledge at {title}.
            </p>
          </div>

          <div class="flex flex-col lg:grid lg:grid-cols-3 gap-8">
            {speakers.map((speaker) => {
              const photo = archiveImage(speaker.image);
              const links = socialLinks(speaker);
              return (
                <div class="bg-white p-6 md:p-8 rounded-tl-[40px] rounded-tr-[10px] rounded-br-[40px] rounded-bl-[10px] shadow-[0px_4px_4px_0px_rgba(0,0,0,0.1)] flex flex-col md:flex-row lg:flex-col gap-4 items-center">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={speaker.name}
                      class="w-[100px] h-[100px] rounded-full object-cover shrink-0"
                      width={100}
                      height={100}
                    />
                  ) : (
                    <div
                      class="w-[100px] h-[100px] rounded-full bg-[#052831] text-white text-3xl font-bold flex items-center justify-center shrink-0"
                      aria-hidden="true"
                    >
                      {initials(speaker.name)}
                    </div>
                  )}
                  <div class="flex flex-col gap-4 w-full">
                    <p class="text-[24px] font-semibold text-black text-center md:text-left lg:text-center">{speaker.name}</p>
                    {speaker.bio && (
                      <p class="text-base font-normal text-black leading-relaxed">{speaker.bio}</p>
                    )}
                    {links.length > 0 && (
                      <div class="flex flex-wrap items-center gap-4 justify-center md:justify-start lg:justify-center">
                        {links.map((link) => (
                          <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-[#4DB7B9] hover:opacity-80">
                            {link.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- Sponsors Section -->
    {sponsors.length > 0 && (
      <section id="sponsors" class="w-full py-10 md:py-20 px-8 lg:px-20 relative overflow-hidden">
        <div class="absolute inset-0 pointer-events-none">
          <div class="absolute inset-0 bg-gradient-to-br from-[#123F4E] to-[#052831]"></div>
          <Image src={sponsorBkgd} alt="" class="absolute inset-0 w-full h-full object-cover" width={1920} height={800} />
        </div>

        <div class="max-w-7xl mx-auto flex flex-col gap-6 relative z-10">
          <div class="py-6 rounded-[10px] flex flex-col items-center gap-2">
            <div class="flex items-center gap-4">
              <svg class="w-10 h-10" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 35.5L17.55 33.27C9.4 25.86 4 21.03 4 15.05C4 10.22 7.82 6.4 12.65 6.4C15.34 6.4 17.92 7.66 20 9.74C22.08 7.66 24.66 6.4 27.35 6.4C32.18 6.4 36 10.22 36 15.05C36 21.03 30.6 25.86 22.45 33.27L20 35.5Z" fill="#D33B32"/>
              </svg>
              <h2 class="text-center text-white text-[32px] font-bold leading-10">{year} Sponsors</h2>
            </div>
            <p class="text-center text-white text-base font-normal leading-relaxed">
              Thank you to the sponsors who supported the Hampton Roads tech community and made the {year} event possible.
            </p>
          </div>

          <div class="pt-10 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {sponsors.map((sponsor) => {
              const logo = archiveImage(sponsor.logo);
              const content = logo ? (
                <Image src={logo} alt={sponsor.name} class="h-12 w-auto object-contain" />
              ) : (
                <span class="text-black text-lg font-bold text-center">{sponsor.name}</span>
              );
              const cardClass = "p-6 md:p-8 bg-white card-asymmetric flex justify-center items-center min-h-[112px]";
              return sponsor.url ? (
                <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class={`${cardClass} hover:shadow-lg transition-shadow`} title={sponsor.name}>
                  {content}
                </a>
              ) : (
                <div class={cardClass} title={sponsor.name}>{content}</div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- Footer -->
    <footer class="w-full bg-[#052831] py-4 px-8 lg:px-20 mt-auto">
      <p class="text-white text-base font-normal leading-relaxed text-center">
        Hampton Roads DevFest is presented by RevolutionVA, a 501c3 organization.
      </p>
    </footer>

    <script>
      // Mobile menu functionality
      document.addEventListener('DOMContentLoaded', function() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');
        const menuLinks = document.querySelectorAll('.mobile-menu-link');
        let isOpen = false;

        function toggleMenu() {
          isOpen = !isOpen;
          if (isOpen) {
            mobileMenu?.classList.remove('hidden');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu?.classList.add('hidden');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        menuBtn?.addEventListener('click', toggleMenu);

        menuLinks.forEach(link => {
          link.addEventListener('click', () => {
            if (isOpen) toggleMenu();
          });
        });
      });
    </script>
    </div>
  </body>
</html>
