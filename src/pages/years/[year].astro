---
import "../../styles/global.css";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import PastYearsNav from "../../components/PastYearsNav.astro";
import TitleBlock from "../../components/TitleBlock.astro";
import edition2015 from "../../data/archive/2015.json";
import edition2016 from "../../data/archive/2016.json";
import edition2017 from "../../data/archive/2017.json";
import edition2018 from "../../data/archive/2018.json";

interface ArchiveSpeaker {
  name: string;
  bio: string;
  image: string;
  linkedin?: string;
  twitter?: string;
  bluesky?: string;
  github?: string;
  mastodon?: string;
  website?: string;
}

interface ArchiveScheduleItem {
  time: string;
  title: string;
  description: string;
  track?: string;
}

interface ArchiveSponsor {
  name: string;
  logo: string;
  url: string;
}

interface ArchiveEdition {
  year: number;
  title: string;
  dateFormatted: string;
  description: string;
  venue: { name: string; address: string; city: string; state: string; zip: string };
  speakers: ArchiveSpeaker[];
  schedule: ArchiveScheduleItem[];
  sponsors: ArchiveSponsor[];
}

export function getStaticPaths() {
  const editions: ArchiveEdition[] = [edition2015, edition2016, edition2017, edition2018];
  return editions.map((edition) => ({
    params: { year: String(edition.year) },
    props: { edition },
  }));
}

const { edition } = Astro.props as { edition: ArchiveEdition };
const { year, title, dateFormatted, description, venue, speakers, schedule, sponsors } = edition;

// Speaker photos and sponsor logos live under src/assets/archive/<year>/; JSON paths are relative to src/assets
const archiveImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/archive/**/*.{png,jpg,jpeg}",
  { eager: true }
);
const archiveImage = (path: string) => (path ? archiveImages[`../../assets/${path}`]?.default : undefined);

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0].toUpperCase())
    .join("");

const venueLine = [venue.address, venue.city, [venue.state, venue.zip].filter(Boolean).join(" ")]
  .filter(Boolean)
  .join(", ");

const socialLinks = (speaker: ArchiveSpeaker) =>
  [
    { label: "LinkedIn", href: speaker.linkedin },
    { label: "X", href: speaker.twitter },
    { label: "Bluesky", href: speaker.bluesky },
    { label: "GitHub", href: speaker.github },
    { label: "Mastodon", href: speaker.mastodon },
    { label: "Website", href: speaker.website },
  ].filter((link): link is { label: string; href: string } => Boolean(link.href));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{`${title} | Event Highlights`}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Event Highlights`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://hrdevfest.org/years/${year}`} />

    <GoogleAnalytics />
  </head>
  <body class="min-h-screen">
    <!-- Mobile hamburger button - outside the frame so it stays fixed -->
    <button id="mobile-menu-btn" class="md:hidden p-2 fixed top-4 right-4 z-[60] bp-box bg-[var(--bp-paper)]" aria-label="Toggle menu">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="square" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="bp-frame">

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-[var(--bp-paper)] hidden md:hidden">
      <div class="flex flex-col h-full">
        <div class="h-[60px]"></div>
        <div class="flex flex-col gap-8 px-8 pt-4">
          <a href="/#about" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Venue</a>
          <a href="/#testimonials" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Testimonials</a>
          <PastYearsNav variant="mobile" />
          <a href="/faq" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">FAQ</a>
          <a href="/sponsor" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Sponsor</a>
          <a href="/#signup" class="mobile-menu-link bp-nav-link text-base font-bold leading-relaxed">Sign Up</a>
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <nav class="w-full py-4 px-4 md:px-8 border-b border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto hidden md:flex justify-center">
        <div class="flex items-center gap-6 lg:gap-10">
          <a href="/#about" class="bp-nav-link text-base font-bold leading-relaxed">About</a>
          <a href="/#venue" class="bp-nav-link text-base font-bold leading-relaxed">Venue</a>
          <a href="/#testimonials" class="bp-nav-link text-base font-bold leading-relaxed">Testimonials</a>
          <PastYearsNav variant="desktop" />
          <a href="/faq" class="bp-nav-link text-base font-bold leading-relaxed">FAQ</a>
          <a href="/sponsor" class="bp-nav-link text-base font-bold leading-relaxed">Sponsor</a>
          <a href="/#signup" class="bp-nav-link text-base font-bold leading-relaxed">Sign Up</a>
        </div>
      </div>
      <!-- Mobile nav placeholder for hamburger positioning -->
      <div class="md:hidden h-6"></div>
    </nav>

    <!-- Header Section -->
    <section class="w-full">
      <div class="flex flex-col items-center py-12 md:py-16 px-4 md:px-8">
        <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center">
          <h1 class="text-[24px] md:text-[32px] font-bold leading-8 md:leading-10">
            {title}
          </h1>
          <p class="bp-mono text-base font-bold leading-relaxed">{dateFormatted}</p>
          <p class="text-base font-normal leading-relaxed">{description}</p>
        </div>
      </div>
    </section>

    <!-- Venue Section -->
    <section id="venue" class="w-full py-10 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-4xl mx-auto flex flex-col gap-2 text-center">
        <p class="bp-label">Location</p>
        <h2 class="text-[24px] md:text-[32px] font-bold">Venue</h2>
        <p class="text-lg font-semibold leading-relaxed">{venue.name}</p>
        {venueLine && <p class="bp-muted text-base font-normal leading-relaxed">{venueLine}</p>}
      </div>
    </section>

    <!-- Schedule Section -->
    {schedule.length > 0 && (
      <section class="w-full py-10 lg:py-16 px-4 md:px-8 border-t border-[var(--bp-line)]">
        <div class="max-w-4xl mx-auto flex flex-col gap-6">
          <h2 class="text-[24px] md:text-[32px] font-bold text-center">
            {year} Schedule
          </h2>
          <table class="bp-table">
            <thead>
              <tr>
                <th scope="col" class="w-[6.5rem] md:w-[8.5rem]">Time</th>
                <th scope="col">Session</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((item) => (
                <tr>
                  <td class="bp-mono text-sm whitespace-nowrap">{item.time}</td>
                  <td>
                    <p class="font-semibold">{item.title}</p>
                    {item.description && (
                      <p class="text-sm bp-muted">{item.description}</p>
                    )}
                    {item.track && item.track !== "All" && (
                      <p class="bp-label mt-2">{item.track}</p>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- Speakers Section -->
    {speakers.length > 0 && (
      <section class="w-full py-10 lg:py-16 px-4 md:px-8 border-t border-[var(--bp-line)]">
        <div class="max-w-7xl mx-auto flex flex-col gap-10">
          <div class="flex flex-col gap-2 text-center lg:px-[280px]">
            <h2 class="text-[24px] md:text-[32px] font-semibold md:font-bold leading-8 md:leading-10">
              {year} Speakers
            </h2>
            <p class="text-base font-normal leading-relaxed">
              Meet the local speakers who shared their knowledge at {title}.
            </p>
          </div>

          <div class="flex flex-col lg:grid lg:grid-cols-3 gap-8">
            {speakers.map((speaker) => {
              const photo = archiveImage(speaker.image);
              const links = socialLinks(speaker);
              return (
                <div class="bp-box p-6 md:p-8 flex flex-col md:flex-row lg:flex-col gap-4 items-center">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={speaker.name}
                      class="bp-photo w-[100px] h-[100px] rounded-full object-cover shrink-0"
                      width={100}
                      height={100}
                    />
                  ) : (
                    <div
                      class="bp-photo bp-mono w-[100px] h-[100px] rounded-full text-3xl font-bold flex items-center justify-center shrink-0"
                      aria-hidden="true"
                    >
                      {initials(speaker.name)}
                    </div>
                  )}
                  <div class="flex flex-col gap-4 w-full">
                    <p class="text-[24px] font-semibold text-center md:text-left lg:text-center">{speaker.name}</p>
                    {speaker.bio && (
                      <p class="text-base font-normal leading-relaxed">{speaker.bio}</p>
                    )}
                    {links.length > 0 && (
                      <div class="flex flex-wrap items-center gap-4 justify-center md:justify-start lg:justify-center">
                        {links.map((link) => (
                          <a href={link.href} target="_blank" rel="noopener noreferrer" class="bp-link text-sm font-medium">
                            {link.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- Sponsors Section -->
    {sponsors.length > 0 && (
      <section id="sponsors" class="w-full py-10 md:py-20 px-4 md:px-8 border-t border-[var(--bp-line)]">
        <div class="max-w-7xl mx-auto flex flex-col gap-6">
          <div class="py-6 flex flex-col items-center gap-2">
            <h2 class="text-center text-[32px] font-bold leading-10">{year} Sponsors</h2>
            <p class="text-center text-base font-normal leading-relaxed">
              Thank you to the sponsors who supported the Hampton Roads tech community and made the {year} event possible.
            </p>
          </div>

          <div class="pt-10 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {sponsors.map((sponsor) => {
              const logo = archiveImage(sponsor.logo);
              const content = logo ? (
                <Image src={logo} alt={sponsor.name} class="h-12 w-auto object-contain" />
              ) : (
                <span class="text-[var(--bp-paper)] text-lg font-bold text-center">{sponsor.name}</span>
              );
              const cardClass = "bp-plate p-6 md:p-8 flex justify-center items-center min-h-[112px]";
              return sponsor.url ? (
                <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class={cardClass} title={sponsor.name}>
                  {content}
                </a>
              ) : (
                <div class={cardClass} title={sponsor.name}>{content}</div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- Footer -->
    <footer class="w-full py-8 px-4 md:px-8 border-t border-[var(--bp-line)]">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center md:items-end gap-8">
        <p class="text-base font-normal leading-relaxed text-center md:text-left">
          Hampton Roads DevFest is presented by RevolutionVA, a 501c3 organization.
        </p>
        <TitleBlock />
      </div>
    </footer>

    </div>

    <script>
      // Mobile menu functionality
      document.addEventListener('DOMContentLoaded', function() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');
        const menuLinks = document.querySelectorAll('.mobile-menu-link');
        let isOpen = false;

        function toggleMenu() {
          isOpen = !isOpen;
          if (isOpen) {
            mobileMenu?.classList.remove('hidden');
            hamburgerIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu?.classList.add('hidden');
            hamburgerIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
            document.body.style.overflow = '';
          }
        }

        menuBtn?.addEventListener('click', toggleMenu);

        menuLinks.forEach(link => {
          link.addEventListener('click', () => {
            if (isOpen) toggleMenu();
          });
        });
      });
    </script>
  </body>
</html>
