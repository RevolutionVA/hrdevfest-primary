---
import cbbt from "../assets/landmark-cbbt.webp";
/*
  Decorative: the Chesapeake Bay Bridge-Tunnel as a faint full-width
  background, anchored to the bottom of the footer, behind its content.
*/
---

<img src={cbbt.src} width={cbbt.width} height={cbbt.height} alt="" aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 w-full h-auto pointer-events-none select-none opacity-20" decoding="async" loading="lazy" />
