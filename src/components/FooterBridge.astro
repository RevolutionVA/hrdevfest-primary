---
import cbbt from "../assets/landmark-cbbt.webp";
/*
  Decorative: the Chesapeake Bay Bridge-Tunnel, a faint blueprint span along
  the top of the footer, in flow so it never sits on the links.
*/
---

<div class="max-w-7xl mx-auto mb-6 pointer-events-none select-none" aria-hidden="true">
  <img src={cbbt.src} width={cbbt.width} height={cbbt.height} alt="" class="w-full max-w-[560px] h-auto mx-auto md:mx-0 md:ml-auto opacity-30" decoding="async" loading="lazy" />
</div>
