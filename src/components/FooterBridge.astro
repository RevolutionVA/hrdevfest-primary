---
import cbbt from "../assets/landmark-cbbt.webp";
/*
  Decorative: the Chesapeake Bay Bridge-Tunnel as a faint full-width
  background, anchored to the bottom of the footer, behind its content.
*/
---

<img src={cbbt.src} width={cbbt.width} height={cbbt.height} alt="" aria-hidden="true" class="absolute inset-0 -z-10 w-full h-full object-cover object-[right_top] md:right-auto md:w-auto md:max-w-none md:object-contain pointer-events-none select-none opacity-[0.32]" decoding="async" loading="lazy" />
