---
import neptune from "../assets/landmark-neptune.webp";
import battleship from "../assets/landmark-battleship.webp";
import bridge from "../assets/landmark-bridge.webp";
/*
  Decorative blueprint line art of three Hampton Roads landmarks: King Neptune
  (Virginia Beach), the battleship Wisconsin (Norfolk), and an open bascule
  drawbridge. Traced from Kevin's samples into white-on-transparent WebP
  (frame and background removed, hull number removed, ship mirrored).

  Pure decoration: aria-hidden, empty alt, no pointer events.
  Below md: just Neptune, small and centered, in flow after the hero text.
  md: Neptune and the ship. lg: all three. From 1440px Neptune rises in the
  left gutter beside the text block while the bridge and ship stay under it.
*/
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={["lla pointer-events-none select-none pb-10 md:pb-0 md:absolute md:inset-x-0 md:bottom-0", className]}
  aria-hidden="true"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-10 min-[90rem]:max-w-none min-[90rem]:px-4 flex items-end justify-center md:justify-between gap-6">
    <img src={neptune.src} width={neptune.width} height={neptune.height} alt="" class="lla-img h-[180px] md:h-[384px] min-[90rem]:h-[560px] w-auto shrink-0" decoding="async" loading="eager" />

    <img src={bridge.src} width={bridge.width} height={bridge.height} alt="" class="lla-img hidden lg:block h-[196px] min-[90rem]:h-[287px] w-auto shrink-0" decoding="async" loading="lazy" />

    <img src={battleship.src} width={battleship.width} height={battleship.height} alt="" class="lla-img hidden md:block h-[231px] min-[90rem]:h-[336px] w-auto shrink-0" decoding="async" loading="lazy" />
  </div>
</div>

<style>
  /* A clear step above the page grid so the shapes read, still under the text */
  .lla-img {
    opacity: 0.6;
  }
</style>
