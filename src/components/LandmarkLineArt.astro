---
import neptune from "../assets/landmark-neptune.webp";
import cbbt from "../assets/landmark-cbbt.webp";
import skyline from "../assets/landmark-skyline.webp";
import battleship from "../assets/landmark-battleship.webp";
/*
  Decorative blueprint line art of Hampton Roads landmarks: King Neptune
  (Virginia Beach), the Chesapeake Bay Bridge-Tunnel low along the waterline,
  and the battleship
  Wisconsin moored in front of the Norfolk skyline (as she is at Nauticus).
  Traced from Kevin's v2 reference sheets into white-on-transparent WebP
  (labels, frames, guide lines and the hull number removed).

  Pure decoration: aria-hidden, empty alt, no pointer events.
  Below md: just Neptune, centered, in flow after the hero text.
  md and up: Neptune and the Norfolk group. From 1440px Neptune
  rises in the left gutter beside the text block.
*/
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={["lla pointer-events-none select-none pb-10 md:pb-0 md:absolute md:inset-x-0 md:bottom-0 md:overflow-hidden", className]}
  aria-hidden="true"
>
  <img src={cbbt.src} width={cbbt.width} height={cbbt.height} alt="" class="lla-img lla-faint hidden lg:block absolute bottom-0 left-[330px] w-[420px] translate-y-[45px] min-[90rem]:translate-y-[70px] min-[90rem]:left-[450px] min-[90rem]:w-[600px] h-auto" decoding="async" loading="lazy" />
  <div class="relative max-w-7xl mx-auto px-6 lg:px-10 min-[90rem]:max-w-none min-[90rem]:px-4 flex items-end justify-center md:justify-between gap-6">
    <img src={neptune.src} width={neptune.width} height={neptune.height} alt="" class="lla-img h-[180px] md:h-[384px] min-[90rem]:h-[560px] w-auto shrink-0" decoding="async" loading="eager" />


    <div class="hidden md:flex flex-col items-end shrink-0 md:translate-y-[24px] lg:translate-y-[36px] min-[90rem]:translate-y-[60px] w-[440px] lg:w-[620px] min-[90rem]:w-[760px]">
      <img src={skyline.src} width={skyline.width} height={skyline.height} alt="" class="lla-img lla-back w-full h-auto" decoding="async" loading="lazy" />
      <img src={battleship.src} width={battleship.width} height={battleship.height} alt="" class="lla-img lla-front w-full h-auto -mt-[20%] relative" decoding="async" loading="lazy" />
    </div>
  </div>
</div>

<style>
  /* A clear step above the page grid so the shapes read, still under the text */
  .lla-img {
    opacity: 0.6;
  }
  /* The skyline sits behind the ship, so it steps back a little */
  /* The Bridge-Tunnel runs low along the waterline, behind the ship */
  .lla-faint {
    opacity: 0.3;
  }
  .lla-back {
    opacity: 0.4;
  }
  /* The ship is the subject of the Norfolk group, so it reads strongest */
  .lla-front {
    opacity: 0.85;
  }
</style>
